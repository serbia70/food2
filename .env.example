# Cloudflare Pages frontend env
PUBLIC_API_URL=https://api.your-domain.com

# Optional browser MQTT broker URL (non-secret)
PUBLIC_MQTT_BROKER=wss://mqtt.your-domain.com:443/mqtt

# SECURITY: Do NOT put secrets in PUBLIC_*.
# This frontend build does NOT support MQTT username/password in the browser.
# Master authentication must not rely on a frontend-held token.
