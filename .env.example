# Cloudflare Pages frontend env
PUBLIC_API_URL=https://api.your-domain.com
PUBLIC_MASTER_TOKEN=change-me-master-token

# Optional browser MQTT (if your frontend must subscribe directly)
PUBLIC_MQTT_BROKER=wss://mqtt.your-domain.com:443/mqtt
PUBLIC_MQTT_USERNAME=
PUBLIC_MQTT_PASSWORD=

# Optional server-side MQTT for Astro API routes (dev/self-host only)
MQTT_USERNAME=
MQTT_PASSWORD=
