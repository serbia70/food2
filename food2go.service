[Unit]
Description=Meituantest API Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/food2Go
Environment="MEITUAN_SERVER_PORT=3032"
Environment="MEITUAN_DATABASE_PATH=/opt/food2Go/data/meituan.db"
Environment="MEITUAN_JWT_SECRET=aaf91673e393d64d0831e907b50458b3"
Environment="MEITUAN_MASTER_TOKEN=e2fa878eec9def46"
Environment="MEITUAN_ALLOWED_ORIGINS=https://foodtest.serbia70.com,https://food2.serbia70.com,https://food2api.serbia70.com,https://api-foodtest.serbia70.com"
Environment="MEITUAN_FRONTEND_URL=https://food2.serbia70.com"
Environment="MEITUAN_SUPER_PASSWORD=4b3abd19ba84"
ExecStart=/opt/food2Go/server
Restart=always
RestartSec=5
User=root
StandardOutput=append:/opt/food2Go/server.log
StandardError=append:/opt/food2Go/server.log

[Install]
WantedBy=multi-user.target
