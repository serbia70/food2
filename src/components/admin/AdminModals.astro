---
const { categories } = Astro.props;
---
<!-- ================================================= -->
<!-- MODALS -->
<!-- ================================================= -->

<!-- 编辑弹窗 -->
<div id="edit-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3>✏️ 编辑菜品</h3>
    <input type="hidden" id="edit-id" />
    <div class="form-group">
      <label>分类 (Category)</label>
      <select id="edit-cat" data-admin-change="edit-category" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
        {categories && categories.map((c: any) => <option value={c.id}>{c.name} ({c.sub_name})</option>)}
        <option value="new">➕ 新建分类 (Create New)</option>
      </select>
    </div>

    <div id="new-cat-fields" style="display:none; background:#f8f9fa; padding:10px; border-radius:4px; margin-bottom:15px; border:1px solid #eee;">
      <div class="form-group">
        <label>新分类名称 (Serbian)</label>
        <input id="new-cat-name" placeholder="e.g. Drinks" />
      </div>
      <div class="form-group">
        <label>新分类中文 (Chinese)</label>
        <input id="new-cat-sub" placeholder="e.g. 饮料" />
      </div>
    </div>

    <div class="form-group">
      <label>塞语名称</label>
      <input id="edit-name" />
    </div>
    <div class="form-group">
      <label>中文名称</label>
      <input id="edit-sub" />
    </div>
    <div class="form-group">
      <label>价格 (RSD)</label>
      <input id="edit-price" type="number" />
    </div>
    <div class="form-group">
      <label>图片 URL</label>
      <div style="display:flex; gap:5px;">
        <input id="edit-img" style="flex:1" />
        <button class="btn-edit" type="button" data-admin-action="trigger-upload" data-target-input="edit-img" title="上传图片">📁 上传</button>
      </div>
    </div>
    <div class="form-group">
      <label>库存 (Stock)</label>
      <div style="display:flex; gap:10px; align-items:center;">
        <input id="edit-stock" type="number" style="width:100px" />
        <span style="font-size:12px; color:#666;">(-1 为无限库存, 0 为缺货)</span>
      </div>
    </div>
    <div class="modal-actions" style="margin-top:20px; display:flex; gap:10px;">
      <button class="btn-cancel" data-admin-action="close-edit-modal" style="flex:1">取消</button>
      <button class="btn-save" data-admin-action="save-edit-product" style="flex:1">💾 保存修改</button>
    </div>
  </div>
</div>

<!-- 骑手选择弹窗 -->
<div id="delivery-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:400px;">
    <h3>🛵 选择骑手 (Select Driver)</h3>
    <div id="driver-select-list" style="max-height:300px; overflow-y:auto; margin-bottom:15px; border:1px solid #eee; padding:10px; border-radius:4px;">
      <!-- JS 渲染 -->
    </div>
    <div style="border-top:1px solid #eee; padding-top:15px;">
      <label style="display:block; margin-bottom:5px; font-weight:bold;">临时骑手 (Manual Input)</label>
      <input id="temp-driver-name" placeholder="姓名" style="margin-bottom:10px; width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;" />
      <input id="temp-driver-phone" placeholder="电话" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;" />
    </div>
    <div style="margin-top:20px; display:flex; gap:10px;">
      <button class="btn-blue" style="flex:1" data-admin-action="confirm-delivery">🚀 确认送餐</button>
      <button class="btn-del" style="flex:1" data-admin-action="close-delivery-modal">取消</button>
    </div>
  </div>
</div>

<!-- 新建分类弹窗 -->
<div id="create-cat-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3>➕ 新建分类</h3>
    <div class="form-group">
      <label>分类名称 (Serbian)</label>
      <input id="create-cat-name" placeholder="e.g. Drinks" />
    </div>
    <div class="form-group">
      <label>中文名称 (Chinese)</label>
      <input id="create-cat-sub" placeholder="e.g. 饮料" />
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" data-admin-action="close-create-category-modal">取消</button>
      <button class="btn-save" data-admin-action="save-new-category">💾 创建</button>
    </div>
  </div>
</div>

<!-- 订单编辑弹窗 -->
<div id="order-edit-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:600px;">
    <h3>📝 编辑订单 <span id="order-edit-no" style="color:#666; font-size:14px;"></span></h3>
    <input type="hidden" id="order-edit-id" />

    <div id="order-items-container" style="margin-bottom:15px;">
      <!-- 订单项目会动态填充 -->
    </div>

    <div class="form-group" style="border-top:1px solid #eee; padding-top:15px; margin-top:15px;">
      <label>➕ 添加新菜品</label>
      <div style="display:flex; gap:10px;">
        <input id="add-item-name" placeholder="菜品名 (必填)" style="flex:2;" />
        <input id="add-item-subname" placeholder="中文名" style="flex:2;" />
        <input id="add-item-price" type="number" placeholder="价格" style="flex:1;" />
        <input id="add-item-qty" type="number" placeholder="数量" value="1" style="width:60px;" />
        <button class="btn-add" data-admin-action="add-item-to-order" style="white-space:nowrap;">添加</button>
      </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; background:#f8f9fa; padding:10px; border-radius:6px; margin-bottom:15px;">
      <span>订单总额:</span>
      <span id="order-edit-total" style="font-size:20px; font-weight:bold; color:#d32f2f;">0</span>
    </div>

    <div class="modal-actions">
      <button class="btn-cancel" data-admin-action="close-order-edit-modal">取消</button>
      <button class="btn-blue" data-admin-action="print-current-order" style="background:#6c757d;">🖨️ 打印</button>
      <button class="btn-save" data-admin-action="save-order-edit">💾 保存修改</button>
    </div>
  </div>
</div>

<!-- 点餐 iframe 弹窗 -->
<div id="order-modal" class="modal order-modal" style="display:none;">
  <div class="order-modal-content">
    <div class="order-modal-header">
      <h3>📝 桌号 <span id="order-table-num">-</span> 点餐</h3>
      <button class="modal-close" data-admin-action="close-order-modal">✕ 关闭</button>
    </div>
    <div class="order-iframe-container">
      <div id="order-loading" class="order-loading">加载中...</div>
      <iframe
        id="order-iframe"
        src="about:blank"
        allowfullscreen>
      </iframe>
    </div>
  </div>
</div>

<!-- ================================================= -->
<!-- MISSING MODALS RESTORED -->
<!-- ================================================= -->

<!-- 结账弹窗 (Checkout Modal) -->
<div id="checkout-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:500px;">
    <h3>💰 结账 <span id="checkout-table-num"></span></h3>
    <div style="margin-bottom:15px; max-height:300px; overflow-y:auto;" id="checkout-order-list">
      <!-- JS injected -->
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #eee; padding-top:15px; margin-bottom:20px;">
      <span style="font-weight:bold;">总金额 (Total):</span>
      <span style="font-size:24px; font-weight:bold; color:#d32f2f;"><span id="checkout-total-amount">0</span> RSD</span>
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" data-admin-action="close-checkout-modal">取消</button>
      <button class="btn-save" data-admin-action="confirm-checkout">✅ 确认结账</button>
    </div>
  </div>
</div>

<!-- 备注弹窗 (Remarks Modal) -->
<div id="remarks-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:600px; max-height:90vh; display:flex; flex-direction:column;">
    <h3>🏷️ 添加备注 <span id="remarks-table-num"></span></h3>

    <section class="remark-ui" style="flex:1; overflow-y:auto; margin-bottom:15px; padding-right:5px;">
      <div id="remarks-container">
        <!-- JS injected categories -->
      </div>
    </section>

    <div style="border-top:1px solid #eee; padding-top:15px;">
      <div class="form-group">
        <label>自定义备注 (Custom Remark)</label>
        <input id="custom-remarks" placeholder="输入其他要求..." />
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" data-admin-action="close-remarks-modal">取消</button>
        <button class="btn-save" data-admin-action="save-remarks">💾 保存备注</button>
      </div>
    </div>
  </div>
</div>

<!-- 详情/修改弹窗 (Details Modal) -->
<div id="details-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:500px;">
    <h3>📋 订单详情 <span id="details-table-num"></span></h3>
    <div style="margin-bottom:10px; color:#666; font-size:13px;">请选择要修改的订单:</div>
    <div id="details-order-list" style="max-height:400px; overflow-y:auto;">
      <!-- JS injected -->
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" data-admin-action="close-details-modal">关闭</button>
    </div>
  </div>
</div>

<!-- Checkin Modal -->
<div id="checkin-modal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:500px;">
    <h3>🚀 选择入座桌号 (Select Table)</h3>
    <div id="checkin-tables" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap:10px; max-height:300px; overflow-y:auto; margin-bottom:20px;">
      <!-- JS injected -->
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" data-admin-action="close-checkin">取消</button>
      <button class="btn-save" data-admin-action="confirm-checkin">✅ 确认入座</button>
    </div>
  </div>
</div>

<!-- 全局隐藏上传控件 -->
<input type="file" id="global-file-input" style="display:none;" data-admin-change="global-file-upload" accept="image/*" />

