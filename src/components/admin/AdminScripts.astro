  // image upload
  window.compressImageForUpload = async function(originFile) {
    if (!originFile || !originFile.type || !originFile.type.startsWith('image/')) return originFile;

    const maxSide = 1200;
    const quality = 0.82;

    try {
      const img = await new Promise((resolve, reject) => {
        const url = URL.createObjectURL(originFile);
        const el = new Image();
        el.onload = () => {
          URL.revokeObjectURL(url);
          resolve(el);
        };
        el.onerror = (err) => {
          URL.revokeObjectURL(url);
          reject(err);
        };
        el.src = url;
      });

      const w = Number(img.naturalWidth || img.width || 0);
      const h = Number(img.naturalHeight || img.height || 0);
      if (!w || !h) return originFile;

      const scale = Math.min(1, maxSide / Math.max(w, h));
      const targetW = Math.max(1, Math.round(w * scale));
      const targetH = Math.max(1, Math.round(h * scale));

      const canvas = document.createElement('canvas');
      canvas.width = targetW;
      canvas.height = targetH;
      const ctx = canvas.getContext('2d');
      if (!ctx) return originFile;
      ctx.drawImage(img, 0, 0, targetW, targetH);

      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', quality));
      if (!blob) return originFile;

      const baseName = originFile.name.includes('.')
        ? originFile.name.replace(/\.[a-zA-Z0-9]+$/, '')
        : originFile.name;
      const nextName = baseName + '.webp';
      return new File([blob], nextName, { type: 'image/webp' });
    } catch {
      return originFile;
    }
  }

