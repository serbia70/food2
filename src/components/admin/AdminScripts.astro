  window.loadReservations = async function() {
    const list = document.getElementById('reservation-list');
    if (!list) return;

    const date = document.getElementById('reservation-date')?.value || '';
    const status = document.getElementById('reservation-status')?.value || '';
    const q = new URLSearchParams();
    if (date) q.set('date', date);
    if (status) q.set('status', status);

    list.innerHTML = '<div style="padding:12px; color:#666;">加载中...</div>';

    try {
      const res = await fetch(`/api/admin/reservations${q.toString() ? `?${q.toString()}` : ''}`);
      const data = await res.json().catch(() => []);
      if (!res.ok) throw new Error(data.error || 'load reservations failed');

      const rows = Array.isArray(data) ? data : [];
      if (rows.length === 0) {
        list.innerHTML = '<div style="padding:12px; background:#f8f9fa; border:1px solid #eee; border-radius:8px; color:#666;">暂无预约记录</div>';
        return;
      }

      const statusRank = (s) => (s === 'completed' || s === 'cancelled' ? 1 : 0);
      rows.sort((a, b) => {
        const ra = statusRank(String(a?.status || 'pending'));
        const rb = statusRank(String(b?.status || 'pending'));
        if (ra !== rb) return ra - rb;

        const ta = new Date(String(a?.reservation_time || '')).getTime() || 0;
        const tb = new Date(String(b?.reservation_time || '')).getTime() || 0;
        if (ra === 0) return ta - tb;
        return tb - ta;
      });

      list.innerHTML = rows.map((r) => {
        const ts = String(r.reservation_time || '').replace('T', ' ').slice(0, 16);
        let itemPreview = '到店再点';
        try {
          const parsed = JSON.parse(String(r.items_json || '[]'));
          if (Array.isArray(parsed) && parsed.length > 0) {
            itemPreview = parsed
              .map((it) => `${it.name || '菜品'} x${Number(it.quantity || 1)}`)
              .slice(0, 3)
              .join('、');
          }
        } catch {}

        const statusText =
          r.status === 'confirmed' ? '已确认' :
          r.status === 'completed' ? '已完成' :
          r.status === 'cancelled' ? '已取消' : '待确认';
        const isFinal = r.status === 'completed' || r.status === 'cancelled';
        const cardStyle = isFinal
          ? 'border:1px solid #d9dee5; border-radius:10px; padding:12px; background:#f3f5f7; color:#7a8594;'
          : 'border:1px solid #e6edf5; border-radius:10px; padding:12px; background:#fff;';
        const statusExtra = isFinal ? 'style="background:#9ea7b3;color:#fff;"' : '';

        const deliveryPrintBtn = r.dine_type === 'delivery'
          ? `<button class="btn-xs" style="background:#6c757d;color:#fff;" data-admin-action="print-reservation" data-reservation-id="${Number(r.id || 0)}">打印送餐单</button>`
          : '';

        return `
          <div style="${cardStyle}">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:8px;">
              <div style="font-weight:700; color:#1f2d3d;">${ts}</div>
              <span class="status-tag status-${r.status || 'pending'}" ${statusExtra}>${statusText}</span>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:6px; color:#44566c; font-size:13px;">
              <div>手机号: ${r.customer_phone || '-'}</div>
              <div>人数: ${Number(r.guest_count || 0)} 人</div>
              <div>方式: ${r.dine_type === 'takeout' ? '自取' : r.dine_type === 'delivery' ? '送餐' : '堂食'}</div>
              <div>姓名: ${r.customer_name || '-'}</div>
            </div>
            <div style="margin-top:8px; font-size:13px; color:#4a5d73;">预点菜品: ${itemPreview}</div>
            <div style="margin-top:6px; font-size:13px; color:#4a5d73;">备注: ${r.remarks || '-'}</div>
            ${isFinal
              ? `<div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; align-items:center;">
                  <div style="font-size:12px; color:#8a94a1;">已结束记录，系统会在3天后自动清理</div>
                  ${deliveryPrintBtn}
                </div>`
              : `<div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;">
                  <button class="btn-xs btn-blue" data-admin-action="update-reservation-status" data-reservation-id="${Number(r.id || 0)}" data-status="confirmed">确认</button>
                  <button class="btn-xs btn-green" data-admin-action="update-reservation-status" data-reservation-id="${Number(r.id || 0)}" data-status="completed">完成</button>
                  <button class="btn-xs btn-red" data-admin-action="update-reservation-status" data-reservation-id="${Number(r.id || 0)}" data-status="cancelled">取消</button>
                  ${deliveryPrintBtn}
                </div>`}
          </div>
        `;
      }).join('');
    } catch (err) {
      list.innerHTML = `<div style="padding:12px; background:#ffebee; border:1px solid #ffcdd2; border-radius:8px; color:#c62828;">加载失败: ${err?.message || err}</div>`;
    }
  }

