  window.localizeImages = async function(e) {
    if (!confirm('Download all remote images to local server? This may take time.')) return;
    const btn = e.target.closest('button');
    const originalText = btn.innerText;
    btn.innerText = '处理中...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/admin/localize-images', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ shopId: window.shopId })
      });
      const data = await res.json();

      if (data.success) {
        alert(
          `Done.\nLocalized images: ${data.processed}` +
            (data.errors ? `\nFailed: ${data.errors.length}` : ''),
        );
        location.reload();
      } else {
        alert('处理失败: ' + data.error);
