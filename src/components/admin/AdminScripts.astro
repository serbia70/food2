    try {
      const res = await fetch('/api/admin/renew/approve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: amount
        })
      });

      const data = await res.json();
      if (data.success) {
        alert('已批准。店铺有效期已延长。');
      } else {
        alert('操作失败: ' + data.error);
      }
    } catch(e) {
      console.error(e);
      alert('网络错误');
    }
  }

  window.rejectRenew = async function() {
    if (!confirm('确定要拒绝该续费请求吗？')) return;

    try {
      const newSettings = { ...window.currentSettings };
      newSettings.last_payment_request.status = 'rejected';

      await window.persistAdminSettings(newSettings);
      alert('请求已拒绝。');
    } catch(e) {
      alert('网络错误');
    }
  }

