  // ============================================
  // Delivery Modal Logic
  // ============================================
  let currentDeliveryOrderId = null;
  let selectedDriverIndex = null;

  window.openDeliveryModal = async function(orderId) {
    currentDeliveryOrderId = orderId;
    selectedDriverIndex = null;
    document.getElementById('temp-driver-name').value = '';
    document.getElementById('temp-driver-phone').value = '';

    const list = document.getElementById('driver-select-list');
    list.innerHTML = '<div style="text-align:center;">加载中...</div>';

    try {
      const res = await fetch('/api/admin/riders');
      const data = await res.json();

      if (data.success && data.riders.length > 0) {
        window.globalRiders = data.riders;

        list.innerHTML = data.riders.map((d, idx) => {
          let statusColor = '#9e9e9e';
          let statusText = '离线';
          if (d.status === 'available') { statusColor = '#4caf50'; statusText = '空闲'; }
          if (d.status === 'busy') { statusColor = '#ff9800'; statusText = '忙碌'; }

          return `
            <div class="driver-option" data-admin-action="select-driver" data-driver-index="${idx}" style="padding:10px; border:1px solid #eee; margin-bottom:5px; border-radius:4px; cursor:pointer; display:flex; justify-content:space-between; align-items:center;">
              <div>
                <span style="font-weight:bold;">${d.name}</span>
                <span style="font-size:12px; color:#666; margin-left:5px;">${d.phone}</span>
              </div>
              <span style="font-size:12px; color:white; background:${statusColor}; padding:2px 6px; border-radius:4px;">${statusText}</span>
            </div>
          `}).join('');
      } else {
        list.innerHTML = '<div style="color:#999; text-align:center;">暂无注册骑手，请先注册骑手</div>';
        window.globalRiders = [];
      }
    } catch(e) {
      list.innerHTML = '<div style="color:red; text-align:center;">加载失败</div>';
    }

    document.getElementById('delivery-modal').style.display = 'flex';
  }

  window.closeDeliveryModal = function() {
    document.getElementById('delivery-modal').style.display = 'none';
    currentDeliveryOrderId = null;
  }

  window.selectDriver = function(el, index) {
    document.querySelectorAll('.driver-option').forEach(d => {
      d.style.borderColor = '#eee';
      d.style.backgroundColor = '#fff';
    });
    el.style.borderColor = '#2196f3';
    el.style.backgroundColor = '#e3f2fd';
    selectedDriverIndex = index;

    document.getElementById('temp-driver-name').value = '';
    document.getElementById('temp-driver-phone').value = '';
  }

  window.confirmDelivery = function() {
    if (!currentDeliveryOrderId) return;

    let driverName = '';
    let driverPhone = '';

    const tempName = document.getElementById('temp-driver-name').value.trim();
    const tempPhone = document.getElementById('temp-driver-phone').value.trim();

    if (tempName && tempPhone) {
      driverName = tempName;
      driverPhone = tempPhone;
    } else if (selectedDriverIndex !== null) {
      const drivers = window.globalRiders || [];
      if (drivers[selectedDriverIndex]) {
        driverName = drivers[selectedDriverIndex].name;
        driverPhone = drivers[selectedDriverIndex].phone;
      }
    }

    if (!driverName || !driverPhone) {
      return alert('请选择骑手或输入骑手信息');
    }

    // Assume updateOrderStatus is defined in admin-orders.js or similar
    if (window.updateOrderStatus) {
      window.updateOrderStatus(currentDeliveryOrderId, 'delivering', { name: driverName, phone: driverPhone });
    } else {
      console.error('updateOrderStatus not defined');
    }
    // @ts-ignore
    window.closeDeliveryModal();
  }

  // ============================================
  // Zone & Table Logic
  // ============================================
  window.renderZones = function() {
    const container = document.getElementById('zones-container');
    if (!container || !window.tableConfig) return;

    container.innerHTML = window.tableConfig.map((zone, idx) => `
      <div class="zone-item" style="display:flex; gap:10px; align-items:center; margin-bottom:10px; padding:10px; border:1px solid #eee; background:#f9f9f9; border-radius:4px;">
        <div style="flex:2;">
          <label style="font-size:12px; color:#666;">区域名称</label>
          <input type="text" value="${zone.name}" placeholder="可留空（仅显示 1号桌）" data-admin-zone-input="1" data-zone-index="${idx}" data-zone-field="name" style="width:100%; padding:5px; border:1px solid #ddd; border-radius:4px;">
        </div>
        <div style="flex:1;">
          <label style="font-size:12px; color:#666;">前缀</label>
          <input type="text" value="${zone.prefix || ''}" placeholder="例如 A" data-admin-zone-input="1" data-zone-index="${idx}" data-zone-field="prefix" style="width:100%; padding:5px; border:1px solid #ddd; border-radius:4px;">
        </div>
        <div style="width:100px;">
          <label style="font-size:12px; color:#666;">数量</label>
          <input type="number" value="${zone.count}" data-admin-zone-input="1" data-zone-index="${idx}" data-zone-field="count" style="width:100%; padding:5px; border:1px solid #ddd; border-radius:4px;">
        </div>
        <div style="align-self:flex-end;">
          <button type="button" data-admin-action="remove-zone" data-zone-index="${idx}" style="background:#ff5252; color:white; border:none; padding:6px 10px; border-radius:4px; cursor:pointer;">删除</button>
        </div>
      </div>
    `).join('');
  }

  window.addZone = function() {
    if (!window.tableConfig) window.tableConfig = [];
    window.tableConfig.push({ name: '', count: 5, prefix: '' });
    renderZones();
  }

  window.removeZone = function(idx) {
    if (!confirm('确定删除这个区域吗？')) return;
    if (!Array.isArray(window.tableConfig)) window.tableConfig = [];
    window.tableConfig.splice(idx, 1);
    renderZones();
  }

  window.updateZone = function(idx, field, value) {
    if (field === 'count') value = parseInt(value) || 0;
    window.tableConfig[idx][field] = value;
  }

  window.saveTableConfig = async function(e) {
    const btn = e?.target || document.querySelector('#tab-settings .btn-save');
    const originalText = btn?.innerText || '';
    if (btn) {
      btn.innerText = '保存中...';
      btn.disabled = true;
    }

    try {
      const requestBody = {
        restaurantId: window.shopId,
        table_config: { zones: window.tableConfig }
      };
      const res = await fetch('/api/admin/settings/table-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });
      const data = await res.json();
      if (data.success) {
        if (!window.currentSettings) window.currentSettings = {};
        window.currentSettings.table_config = { zones: window.tableConfig };
        window.currentSettings.tables = window.tableConfig;
        alert('桌台配置已保存，页面将刷新生效。');
        location.reload();
      } else {
        alert('保存失败: ' + data.error);
      }
    } catch(error) {
      alert('网络错误');
    } finally {
      if (btn) {
        btn.innerText = originalText;
        btn.disabled = false;
      }
    }
  }

  // ============================================
  // Settings Logic
  // ============================================
  window.persistAdminSettings = async function(nextSettings) {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(nextSettings),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.error || data.success === false) {
      throw new Error(data.error || '保存失败');
    }
    window.currentSettings = nextSettings;
    return data;
  }

  window.saveSettings = async function(e) {
    if (e) e.preventDefault();
    const form = e ? e.target : document.querySelector('#tab-settings form');
    const fd = new FormData(form);
    const newSettings = { ...window.currentSettings };
    newSettings.currency = { ...newSettings.currency, rate: fd.get('rate'), wechat_qr: fd.get('wechat_qr') };
    newSettings.delivery = { ...newSettings.delivery, fee: fd.get('fee'), free_threshold: fd.get('free_threshold'), zones: fd.get('zones') };
    newSettings.hours = { ...newSettings.hours, open: fd.get('open'), close: fd.get('close'), enabled: true };
    newSettings.contact = {
      ...(newSettings.contact || {}),
      phone: fd.get('contact_phone'),
      map_url: fd.get('contact_map_url') || '',
    };
    newSettings.map_url = fd.get('contact_map_url') || '';
    newSettings.telegram = { token: fd.get('tg_token'), chat_id: fd.get('tg_chat_id') };
    if (Array.isArray(window.tableConfig)) {
      newSettings.table_config = { zones: window.tableConfig };
      newSettings.tables = window.tableConfig;
    }

    try {
      let drivers = JSON.parse(fd.get('drivers_json') || '[]');
      const uniqueDrivers = Array.from(new Map(drivers.map(item => [item.name + '|' + item.phone, item])).values());
      newSettings.drivers = uniqueDrivers;
    } catch(err) { newSettings.drivers = []; }

    newSettings.holidays = {
      closed_dates: fd.get('closed_dates') || '',
      message: fd.get('holiday_message') || '',
      enabled: document.getElementById('holiday-enabled')?.checked || false
    };

    try {
      await window.persistAdminSettings(newSettings);
      alert('保存成功');
    } catch (e) {
      alert('保存失败: ' + (e?.message || e));
    }
  }

  window.saveLocation = async function() {
    const city = document.getElementById('shop-city')?.value || '';
    const zone = document.getElementById('shop-zone')?.value || '';
    const address = document.getElementById('shop-address')?.value || '';
    const mapUrl = document.getElementById('shop-map-url')?.value || '';
    const next = {
      ...window.currentSettings,
      location: { city, zone, address, map_url: mapUrl },
      contact: {
        ...(window.currentSettings?.contact || {}),
        map_url: mapUrl,
      },
      map_url: mapUrl,
    };

    try {
      await window.persistAdminSettings(next);
      showToast('位置信息已保存');
    } catch (err) {
      alert('保存失败: ' + (err?.message || err));
    }
  }

  window.updateShopName = function() {
    const val = document.getElementById('shop-name-input')?.value?.trim();
    if (!val) return alert('请输入店铺名称');
    const title = document.querySelector('.header h2');
    if (title) {
      const badge = title.querySelector('span');
      title.childNodes[0].nodeValue = `⚙️ ${val} `;
      if (badge) title.appendChild(badge);
    }
    showToast('名称已更新到当前页面。持久化请在总控修改。');
