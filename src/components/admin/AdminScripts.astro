      btn.disabled = false;
    }
  }

  // ============================================
  // Order Edit Logic
  // ============================================
  let currentOrderItems = {};
  let currentOrderId = null;

  window.handleEditOrder = function(btn) {
    const orderId = parseInt(btn.dataset.orderId);
    const orderNo = btn.dataset.orderNo || '';
    const itemsJson = btn.dataset.items || '{}';
    const total = parseFloat(btn.dataset.total) || 0;

    openOrderEditModal(orderId, orderNo, itemsJson, total);
  }

  window.openOrderEditModal = function(orderId, orderNo, itemsJson, _total) {
    currentOrderId = orderId;
    document.getElementById('order-edit-id').value = orderId;
    document.getElementById('order-edit-no').innerText = '#' + (orderNo || '').slice(-4);

    try {
      if (typeof itemsJson === 'string') {
        currentOrderItems = JSON.parse(itemsJson);
      } else {
        currentOrderItems = itemsJson || {};
      }
    } catch(e) {
      console.error('Parse items error:', e, itemsJson);
      currentOrderItems = {};
    }

    renderOrderItems();
    document.getElementById('order-edit-modal').style.display = 'flex';
  }

  window.closeOrderEditModal = function() {
    document.getElementById('order-edit-modal').style.display = 'none';
    currentOrderItems = {};
    currentOrderId = null;
  }

  function renderOrderItems() {
    const container = document.getElementById('order-items-container');
    let html = '<div class="order-items-list">';
    let total = 0;

    Object.entries(currentOrderItems).forEach(([key, item]) => {
      const itemTotal = (item.price || 0) * (item.quantity || 1);
      total += itemTotal;
      html += `
        <div class="order-item-row" data-key="${key}">
          <div class="item-info">
            <span class="item-name">${item.name}</span>
            <span class="item-subname">${item.subName || ''}</span>
          </div>
          <div class="item-qty">
            <button data-admin-action="change-item-qty" data-item-key="${key}" data-delta="-1">-</button>
            <span>${item.quantity}</span>
            <button data-admin-action="change-item-qty" data-item-key="${key}" data-delta="1">+</button>
          </div>
          <div class="item-price">${item.price} x ${item.quantity} = ${itemTotal}</div>
          <button class="btn-del-item" data-admin-action="remove-order-item" data-item-key="${key}">删除</button>
        </div>
      `;
    });

    html += '</div>';
    container.innerHTML = html;
    document.getElementById('order-edit-total').innerText = total.toLocaleString() + ' RSD';
  }

  window.changeItemQty = function(key, delta) {
    if (!currentOrderItems[key]) return;
    currentOrderItems[key].quantity = Math.max(1, (currentOrderItems[key].quantity || 1) + delta);
    renderOrderItems();
  }

  window.removeOrderItem = function(key) {
    if (!confirm('确定删除这个菜品吗？')) return;
    delete currentOrderItems[key];
    renderOrderItems();
  }

  window.addItemToOrder = function() {
    const name = document.getElementById('add-item-name').value.trim();
    const subName = document.getElementById('add-item-subname').value.trim();
    const price = parseInt(document.getElementById('add-item-price').value) || 0;
    const qty = parseInt(document.getElementById('add-item-qty').value) || 1;

    if (!name) return alert('请输入菜品名');
    if (price <= 0) return alert('请输入有效价格');
    const key = 'manual_' + Date.now();
    currentOrderItems[key] = {
      name: name,
      subName: subName,
      price: price,
      quantity: qty
    };

    document.getElementById('add-item-name').value = '';
    document.getElementById('add-item-subname').value = '';
    document.getElementById('add-item-price').value = '';
    document.getElementById('add-item-qty').value = '1';

    renderOrderItems();
  }

  window.saveOrderEdit = async function() {
    if (!currentOrderId) return;

    let newTotal = 0;
    Object.values(currentOrderItems).forEach(item => {
      newTotal += (item.price || 0) * (item.quantity || 1);
    });

    try {
      const res = await fetch(`/api/admin/orders/${encodeURIComponent(String(currentOrderId))}/edit`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items_json: JSON.stringify(currentOrderItems),
          total_amount: newTotal
        })
      });
      const data = await res.json();
      if (data.success) {
        alert('订单更新成功');
        closeOrderEditModal();
        if (window.refreshOrderList) window.refreshOrderList();
        else location.reload();
      } else {
        alert('修改失败: ' + (data.error || '未知错误'));
      }
    } catch(e) {
      alert('网络错误');
    }
  }

  window.printOrder = async function(orderId) {
    const id = orderId || currentOrderId;
    if (!id) return alert('无效订单ID');

    try {
      showToast('正在发送打印指令...');

      const res = await fetch('/api/admin/reprint', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          orderId: id,
          shopSlug: window.shopSlug
        })
      });

      const data = await res.json();

      if (data.success) {
        showToast('打印指令已发送');
      } else {
        alert('打印失败: ' + (data.error || '未知错误'));
      }
    } catch(e) {
      console.error('Print error:', e);
        alert('网络错误，无法连接服务器');
    }
  }

  // ============================================
  // Table Order Iframe Logic
  // ============================================
  // Logic moved to src/scripts/admin/table-management.js

  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'ORDER_SUBMITTED') {
      if (window.closeOrderModal) window.closeOrderModal();
      if (event.data.tableId) {
        showToast('桌号 ' + event.data.tableId + ' 订单已提交');
      }
      if (window.refreshOrderList) {
        window.refreshOrderList();
      }
    }
  });

  window.importData = async function() {
    const area = document.getElementById('import-area');
    if (!area) return alert('未找到导入框');
    const text = String(area.value || '').trim();
    if (!text) return alert('请先粘贴JSON数据');

    let data;
    try {
      data = JSON.parse(text);
    } catch (e) {
      return alert('JSON格式无效');
    }
    if (!Array.isArray(data)) return alert('JSON必须是一个数组');

    if (!confirm('导入将追加分类/商品。是否继续？')) return;

    try {
      let createdCategories = 0;
      let createdProducts = 0;

      for (const cat of data) {
        const catName = String(cat?.category || '').trim();
        if (!catName) continue;

        const catRes = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: catName,
            sub_name: String(cat?.category_sub || '')
          })
        });
        const catJson = await catRes.json();
        if (!catRes.ok || !catJson.success || !catJson.id) {
          throw new Error(catJson?.error || ('create_category failed: ' + catName));
        }
        createdCategories++;

        const items = Array.isArray(cat?.items) ? cat.items : [];
        for (const item of items) {
          const name = String(item?.name || '').trim();
          const price = Number(item?.price || 0);
          if (!name || !Number.isFinite(price) || price <= 0) continue;

          const prodRes = await fetch('/api/admin/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              category_id: Number(catJson.id),
              name,
              sub_name: String(item?.subName || item?.sub_name || ''),
              price: Math.round(price),
              img: String(item?.img || item?.image || ''),
            })
          });
          const prodJson = await prodRes.json();
          if (!prodRes.ok || !prodJson.success) {
            throw new Error(prodJson?.error || ('create_product failed: ' + name));
          }
          createdProducts++;
        }
      }

      showToast('已导入: ' + createdCategories + ' 个分类, ' + createdProducts + ' 个商品');
      if (window.refreshMenuList) await window.refreshMenuList();
      else location.reload();
    } catch (e) {
      console.error('importData failed:', e);
      alert('导入失败: ' + (e?.message || e));
    }
  }

  window.exportData = async function() {
    try {
      const shopSlug = window.shopSlug || 'shop';
      const menuRes = await fetch(`/${encodeURIComponent(shopSlug)}/menu`);
      const menuData = await menuRes.json().catch(() => []);
      const list = Array.isArray(menuData) ? menuData : [];
      
      if (list.length === 0) {
        alert('导出失败：菜单为空');
        return;
      }

      const grouped = list.map((cat) => ({
        category: cat?.name || '',
        category_sub: cat?.sub_name || '',
        items: (Array.isArray(cat?.products) ? cat.products : []).map((p) => ({
          name: p?.name || '',
          subName: p?.sub_name || '',
          price: Number(p?.price || 0),
          img: p?.img || '',
        })),
      }));

      const jsonText = JSON.stringify(grouped, null, 2);
      const area = document.getElementById('import-area');
      if (area) area.value = jsonText;

      const blob = new Blob([jsonText], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const ts = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
      a.href = url;
      a.download = `menu-export-${shopSlug}-${ts}.json`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      showToast('菜单已导出');
    } catch (e) {
      console.error('exportData failed:', e);
      alert('导出失败: ' + (e?.message || e));
    }
  }
  document.addEventListener('DOMContentLoaded', function() {
    const today = new Date().toISOString().split('T')[0];
    const statsStart = document.getElementById('stats-start');
    const statsEnd = document.getElementById('stats-end');
    if (statsStart) statsStart.value = today;
    if (statsEnd) statsEnd.value = today;

    setTimeout(() => {
      if (statsStart && statsEnd && statsStart.value && statsEnd.value) {
        loadStatsQuiet();
      }
    }, 500);

    if (window.checkLogin) checkLogin();
    autoUpdateRate();

    // MQTT & Sound Init
    if (document.getElementById('sound-mode')) {
      document.getElementById('sound-mode').value = localStorage.getItem('adminSoundMode') || 'voice';
    }
    // Ensure stream starts after all handlers are defined.
    startRealtimeChannels();

  });

  // Logout function
  window.logout = async function() {
    if (confirm('确认退出登录吗？')) {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        location.href = `/admin/${window.shopSlug}/login`;
      } catch (e) {
        alert('退出失败，请重试');
        document.cookie = 'admin_token=; Max-Age=0; path=/';
        location.href = `/admin/${window.shopSlug}/login`;
      }
    }
  }
</script>
