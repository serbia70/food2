---
const { shopId, shopSlug, tableConfig, settings, brokerIp, shop } = Astro.props;
---
<script src="/vendor/mqttws31.min.js" is:inline></script>
<script define:vars={{ shopId, shopSlug, tableConfig, settings, brokerIp, shop }} is:inline>
  window.shopId = shopId;
  window.shopSlug = shopSlug;
  window.tableConfig = tableConfig;
  window.currentSettings = settings;
  window.brokerIp = brokerIp;
  window.mqttSecret = shop ? shop.mqtt_secret : 'default';
</script>

<script is:inline>
  if (!window.__adminHandlers) {
    window.__adminHandlers = {};
  }
  if (!window.__adminPendingActions) {
    window.__adminPendingActions = [];
  }

  if (!window.__adminFetchWrapped) {
    const __rawFetch = window.fetch.bind(window);
    window.fetch = async function(input, init) {
      const reqInit = init ? { ...init } : {};
      const url = typeof input === 'string' ? input : (input && input.url) || '';
      const isAdminApi = url.startsWith('/api/admin/');

      if (isAdminApi) {
        const headers = new Headers(reqInit.headers || {});
        if (!headers.has('Authorization')) {
          try {
            const token = localStorage.getItem('token') || '';
            if (token) headers.set('Authorization', `Bearer ${token}`);
          } catch {}
        }
        reqInit.headers = headers;
      }

      const res = await __rawFetch(input, reqInit);
      if (isAdminApi && res.status === 401) {
        try {
          localStorage.removeItem('token');
        } catch {}
        location.href = `/admin/${window.shopSlug}/login`;
      }
      return res;
    };
    window.__adminFetchWrapped = true;
  }

  if (!window.__adminActionDelegationInstalled) {
    const flushPendingActions = () => {
      const pending = Array.isArray(window.__adminPendingActions)
        ? window.__adminPendingActions
        : [];
      if (!pending.length) return;

      const remained = [];
      pending.forEach((job) => {
        const fn = getHandler(job.fnName);
        if (typeof fn === 'function') {
          try {
            fn(...(Array.isArray(job.args) ? job.args : []));
          } catch (e) {
            console.error('[AdminAction] Pending action failed:', job.fnName, e);
          }
        } else {
          remained.push(job);
        }
      });
      window.__adminPendingActions = remained.slice(-30);
    };

    const getHandler = (fnName) => {
      const registry = window.__adminHandlers || {};
      const fromRegistry = registry[fnName];
      if (typeof fromRegistry === 'function') return fromRegistry;

      const fromWindow = window[fnName];
      if (typeof fromWindow === 'function') {
        registry[fnName] = fromWindow;
        window.__adminHandlers = registry;
        return fromWindow;
      }
      return null;
    };

    const invoke = (fnName, ...args) => {
      const fn = getHandler(fnName);
      if (typeof fn !== 'function') {
        const pending = Array.isArray(window.__adminPendingActions)
          ? window.__adminPendingActions
          : [];
        pending.push({ fnName, args, createdAt: Date.now() });
        window.__adminPendingActions = pending.slice(-30);

        if (!window.__adminPendingHintShownAt || Date.now() - window.__adminPendingHintShownAt > 1500) {
          window.__adminPendingHintShownAt = Date.now();
          console.log(`[AdminAction] Queued action until handler ready: ${fnName}`);
        }
        return;
      }
      fn(...args);
    };

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const actionEl = target.closest('[data-admin-action]');
      if (!(actionEl instanceof HTMLElement)) return;

      event.preventDefault();

      const action = actionEl.dataset.adminAction || '';
      const table = actionEl.dataset.table || '';
      const orderId = Number(actionEl.dataset.orderId || '0');
      const toInt = (value) => Number.parseInt(String(value || '0'), 10) || 0;

      switch (action) {
        case 'show-tab':
          invoke('showTab', actionEl.dataset.tabName || 'tables');
          break;
        case 'enable-audio':
          invoke('enableAudio');
          break;
        case 'test-sound':
          invoke('testSound');
          break;
        case 'reload-page':
          location.reload();
          break;
        case 'system-control':
          invoke('systemControl', actionEl.dataset.command || 'reboot');
          break;
        case 'logout':
          invoke('logout');
          break;
        case 'open-create-category':
          invoke('openCreateCategoryModal');
          break;
        case 'localize-images':
          invoke('localizeImages');
          break;
        case 'move-category':
          invoke('moveCategory', toInt(actionEl.dataset.categoryId), actionEl.dataset.direction || 'up');
          break;
        case 'delete-category':
          invoke('delCategory', toInt(actionEl.dataset.categoryId), toInt(actionEl.dataset.productCount));
          break;
        case 'move-product':
          invoke('moveProduct', toInt(actionEl.dataset.productId), actionEl.dataset.direction || 'up', toInt(actionEl.dataset.categoryId));
          break;
        case 'open-edit-product':
          invoke('openEditModal', event, toInt(actionEl.dataset.productId), toInt(actionEl.dataset.categoryId));
          break;
        case 'delete-product':
          invoke('delProd', toInt(actionEl.dataset.productId));
          break;
        case 'trigger-upload':
          invoke('triggerUpload', actionEl.dataset.targetInput || '');
          break;
        case 'add-product':
          invoke('addProd', toInt(actionEl.dataset.shopId), toInt(actionEl.dataset.categoryId));
          break;
        case 'reservation-filter':
          invoke('setReservationDateFilter', actionEl.dataset.mode || 'today');
          break;
        case 'load-reservations':
          invoke('loadReservations');
          break;
        case 'print-reservation':
          invoke('printReservation', toInt(actionEl.dataset.reservationId));
          break;
        case 'update-reservation-status':
          invoke('updateReservationStatus', toInt(actionEl.dataset.reservationId), actionEl.dataset.status || 'pending');
          break;
        case 'add-zone':
          invoke('addZone');
          break;
        case 'remove-zone':
          invoke('removeZone', toInt(actionEl.dataset.zoneIndex));
          break;
        case 'save-table-config':
          invoke('saveTableConfig', event);
          break;
        case 'save-location':
          invoke('saveLocation');
          break;
        case 'fetch-rate':
          invoke('fetchRate');
          break;
        case 'update-shop-name':
          invoke('updateShopName');
          break;
        case 'open-logo-upload': {
          const input = document.getElementById('shop-logo-input');
          if (input instanceof HTMLInputElement) input.click();
          break;
        }
        case 'update-shop-category':
          invoke('updateShopCategory');
          break;
        case 'update-mqtt-secret':
          invoke('updateMqttSecret');
          break;
        case 'load-order-stats':
          invoke('loadOrderStats');
          break;
        case 'archive-old-orders':
          invoke('archiveOldOrders');
          break;
        case 'delete-archived-orders':
          invoke('deleteArchivedOrders');
          break;
        case 'save-delivery-type':
          invoke('saveDeliveryType');
          break;
        case 'remove-driver':
          invoke('removeDriver', toInt(actionEl.dataset.driverIndex));
          break;
        case 'add-driver':
          invoke('addDriver');
          break;
        case 'load-stats':
          invoke('loadStats');
          break;
        case 'import-data':
          invoke('importData');
          break;
        case 'export-data':
          invoke('exportData');
          break;
        case 'update-password':
          invoke('updatePassword', event);
          break;
        case 'close-edit-modal':
          invoke('closeEditModal');
          break;
        case 'save-edit-product':
          invoke('saveEditProd');
          break;
        case 'confirm-delivery':
          invoke('confirmDelivery');
          break;
        case 'close-delivery-modal':
          invoke('closeDeliveryModal');
          break;
        case 'select-driver':
          invoke('selectDriver', actionEl, toInt(actionEl.dataset.driverIndex));
          break;
        case 'close-create-category-modal': {
          const modal = document.getElementById('create-cat-modal');
          if (modal) modal.style.display = 'none';
          break;
        }
        case 'save-new-category':
          invoke('saveNewCategory');
          break;
        case 'add-item-to-order':
          invoke('addItemToOrder');
          break;
        case 'change-item-qty':
          invoke('changeItemQty', actionEl.dataset.itemKey || '', toInt(actionEl.dataset.delta));
          break;
        case 'remove-order-item':
          invoke('removeOrderItem', actionEl.dataset.itemKey || '');
          break;
        case 'close-order-edit-modal':
          invoke('closeOrderEditModal');
          break;
        case 'print-current-order':
          invoke('printOrder');
          break;
        case 'save-order-edit':
          invoke('saveOrderEdit');
          break;
        case 'close-order-modal':
          invoke('closeOrderModal');
          break;
        case 'close-checkout-modal':
          invoke('closeCheckoutModal');
          break;
        case 'confirm-checkout':
          invoke('confirmCheckout');
          break;
        case 'close-remarks-modal':
          invoke('closeRemarksModal');
          break;
        case 'save-remarks':
          invoke('saveRemarks');
          break;
        case 'close-details-modal':
          invoke('closeDetailsModal');
          break;
        case 'table-order':
          invoke('handleTableOrder', table);
          break;
        case 'table-checkout':
          invoke('handleTableCheckout', table);
          break;
        case 'table-modify':
          invoke('handleModify', table);
          break;
        case 'table-remarks':
          invoke('handleTableRemarks', table);
          break;
        case 'approve-table-reviews':
          invoke('approveTableReviews', table);
          break;
        case 'reject-table-reviews':
          invoke('rejectTableReviews', table);
          break;
        case 'table-print':
          invoke('handlePrintTable', table);
          break;
        case 'open-delivery':
          invoke('openDeliveryModal', orderId);
          break;
        case 'mark-paid':
          invoke('markPaid', orderId);
          break;
        case 'open-reject':
          invoke('openRejectModal', orderId);
          break;
        case 'order-remarks':
          invoke('handleTableRemarks', null, orderId);
          break;
        case 'edit-order': {
          const trigger = document.querySelector(`[data-oid="${orderId}"]`);
          invoke('handleEditOrder', trigger);
          break;
        }
        case 'print-order':
          invoke('printOrder', orderId);
          break;
        default:
          break;
      }
    });

    document.addEventListener('submit', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLFormElement)) return;

      if (target.id === 'settings-form') {
        event.preventDefault();
        invoke('saveSettings', event);
        return;
      }

      if (target.id === 'password-form') {
        event.preventDefault();
        invoke('updatePassword', event);
      }
    });

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      if (target instanceof HTMLSelectElement && target.dataset.adminChange === 'sound-mode') {
        invoke('changeSoundMode', target.value);
        return;
      }

      if (target instanceof HTMLSelectElement && target.dataset.adminChange === 'edit-category') {
        invoke('toggleNewCat');
        return;
      }

      if (target instanceof HTMLInputElement && target.id === 'shop-logo-input') {
        invoke('uploadShopLogo', target);
        return;
      }

      if (target instanceof HTMLInputElement && target.dataset.adminChange === 'global-file-upload') {
        invoke('handleFileUpload', event);
        return;
      }

      if (target instanceof HTMLInputElement && target.dataset.adminZoneInput === '1') {
        invoke(
          'updateZone',
          Number.parseInt(target.dataset.zoneIndex || '0', 10) || 0,
          target.dataset.zoneField || 'name',
          target.value,
        );
      }
    });

    document.addEventListener(
      'error',
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLImageElement)) return;
        const fallback = target.dataset.fallbackSrc;
        if (!fallback) return;
        if (target.dataset.fallbackApplied === '1') return;
        target.dataset.fallbackApplied = '1';
        target.src = fallback;
      },
      true,
    );

    window.addEventListener('admin:handlers-registered', flushPendingActions);
    window.addEventListener('load', flushPendingActions);
    flushPendingActions();

    window.__adminActionDelegationInstalled = true;
  }

  // ============================================
  // MQTT & Audio Logic
  // ============================================

  let client;
  const isSecure = window.location.protocol === 'https:';

  function getMqttTopic() {
    return `restaurant/${window.shopSlug}/${window.mqttSecret || 'default'}/order`;
  }

  window.initMqtt = function() {
    if (window.__adminMqttInitInFlight) {
      return;
    }
    // prevent duplicate init
    if (window.mqttClient && (window.mqttClient.connected || window.mqttClient.connecting)) {
      console.log('[MQTT] Already connected or connecting, skip init');
      return;
    }
    if (typeof Paho === 'undefined') {
      console.error('[MQTT] Paho client not loaded');
      return;
    }

    window.__adminMqttInitInFlight = true;

    const clientId = 'admin_' + window.shopSlug + '_' + Math.random().toString(16).slice(2, 8);

    // smarter connection strategy
    const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const rawBroker = window.brokerIp || 'mqtt.serbia70.com';
    const mqttUser = (window.currentSettings && window.currentSettings.mqtt_username) || '';
    const mqttPass = (window.currentSettings && window.currentSettings.mqtt_password) || '';

    // core routing:
    // 1) if broker contains serbia70.com, use remote 443/wss path
    // 2) otherwise treat as local broker for development
    const isRemoteProd = rawBroker.includes('serbia70.com');

    // local dev: prefer WS + 8083 for local broker
    // if local page connects remote broker, keep remote strategy

    const finalHost = isRemoteProd ? 'mqtt.serbia70.com' : rawBroker;
    const finalPort = isRemoteProd ? 443 : (isLocal ? 8083 : 8083);
    const finalPath = isRemoteProd ? '/mqtt' : '/mqtt';
    const finalSSL = isRemoteProd ? true : false; // local dev does not use SSL

    window.__mqttConnectStartedAt = performance.now();
    console.log(`[MQTT] Connecting to ${finalSSL ? 'wss' : 'ws'}://${finalHost}:${finalPort}${finalPath} (isLocal: ${isLocal}, isRemoteProd: ${isRemoteProd})`);
    client = new Paho.MQTT.Client(finalHost, Number(finalPort), finalPath || '/', clientId);

    // Expose client globally for other scripts (like table-management.js)
    window.mqttClient = client;

    client.onConnectionLost = onConnectionLost;
    client.onMessageArrived = onMessageArrived;

    const options = {
      useSSL: finalSSL,
      timeout: 5,
      keepAliveInterval: 60,
      ...(mqttUser ? { userName: mqttUser } : {}),
      ...(mqttPass ? { password: mqttPass } : {}),
      onSuccess: onConnect,
      onFailure: (e) => {
        window.__adminMqttInitInFlight = false;
        console.log('MQTT connect failed', e);
        updateMqttStatus('failed');
        setTimeout(() => window.initMqtt && window.initMqtt(), 1000); // 1秒后重试
      }
    };
    try {
      client.connect(options);
    } catch(e) {
      window.__adminMqttInitInFlight = false;
      console.error('MQTT Connect Error:', e);
    }
  }

  // Expose getMqttTopic globally
  window.getMqttTopic = getMqttTopic;

  function onConnect() {
    window.__adminMqttInitInFlight = false;
    const startedAt = Number(window.__mqttConnectStartedAt || 0);
    const elapsed = startedAt > 0 ? Math.round(performance.now() - startedAt) : -1;
    if (elapsed >= 0) {
      console.log(`MQTT Connected (${elapsed}ms)`);
    } else {
      console.log('MQTT Connected');
    }
    updateMqttStatus('connected');
    if (client) client.connected = true; // Flag for external scripts

    const topic = getMqttTopic();
    client.subscribe(topic);
    console.log('[MQTT] subscribed:', topic);
    // also subscribe status channel for non-print system updates
    // avoid printer event interference: listen status channel as well
    const statusTopic = topic.replace('/order', '/status');
    client.subscribe(statusTopic);
    console.log('[MQTT] subscribed:', statusTopic);

    // fallback topic: backend always publishes to shop/{shopId}/orders
    if (window.shopId) {
      const shopTopic = `shop/${window.shopId}/orders`;
      client.subscribe(shopTopic);
      console.log('[MQTT] subscribed:', shopTopic);
    }
  }

  function onConnectionLost(responseObject) {
    window.__adminMqttInitInFlight = false;
    if (client) client.connected = false;
    if (responseObject.errorCode !== 0) {
      console.log("onConnectionLost:"+responseObject.errorMessage);
      updateMqttStatus('disconnected');
      setTimeout(() => window.initMqtt && window.initMqtt(), 1000); // 1秒后重试
    }
  }

  function startRealtimeChannels() {
    if (window.initMqtt) window.initMqtt();
    if (window.initRealtimeStream && !window.__adminRealtimeStreamBootstrapped) {
      window.__adminRealtimeStreamBootstrapped = true;
      window.initRealtimeStream();
    }
  }

  // Start MQTT as early as possible; stream can bootstrap later.
  startRealtimeChannels();

  // dedupe MQTT messages
  const processedMessages = new Set();

  function makeRealtimeEventKey(payload) {
    const evt = String(payload?.event || payload?.type || '').toLowerCase();
    if (!evt) return '';
    const rid = payload?.reservation_id || payload?.reservationId || '';
    const oid = payload?.order_id || payload?.id || payload?.order_no || '';
    const status = payload?.status || '';
    const keyId = rid || oid;
    return `${evt}:${keyId}:${status}`;
  }

  function seenRealtimeEvent(payload) {
    const key = makeRealtimeEventKey(payload);
    if (!key) return false;
    if (processedMessages.has(key)) return true;
    processedMessages.add(key);
    if (processedMessages.size > 120) {
      const iter = processedMessages.values();
      processedMessages.delete(iter.next().value);
    }
    return false;
  }

  function handleRealtimePayload(payload) {
    if (!payload || typeof payload !== 'object') return;

    if (
      payload.event === 'new_reservation' ||
      payload.type === 'new_reservation' ||
      payload.event === 'reservation_status_update' ||
      payload.type === 'reservation_status_update'
    ) {
      if (seenRealtimeEvent(payload)) return;
      const isNewReservation = payload.event === 'new_reservation' || payload.type === 'new_reservation';
      showToast(isNewReservation ? '收到新预约订单' : '预约状态已更新');

      if (isNewReservation) {
        queueSpeak('你有新预约订单，请及时处理。');
      }

      if (window.loadReservationStats) {
        window.loadReservationStats();
      }

      if (window.loadReservations) {
        window.loadReservations();
      }
      return;
    }

    // handle table status sync (silent refresh, no sound)
    if ((payload.type === 'table_status_sync' || payload.type === 'table_checkout' || payload.event === 'table_status_sync' || payload.event === 'table_checkout')) {
      console.log("[MQTT] Table Refresh Signal:", payload);
      if (window.refreshOrderList) {
        window.refreshOrderList();
      }
      // only refresh; do not enter new-order flow below
      return;
    }

    // status/remarks updates should also refresh immediately
    if (payload.event === 'status_update' || payload.type === 'status_update' || payload.event === 'remarks_update' || payload.type === 'remarks_update') {
      if (seenRealtimeEvent(payload)) return;
      if (window.refreshOrderList) {
        window.refreshOrderList();
      } else {
        setTimeout(() => {
          location.reload();
        }, 800);
      }
      return;
    }

    // only process new-order style events
    if ((payload.type === 'new_order' || payload.type === 'order' || payload.event === 'new_order' || payload.event === 'order')) {
      if (seenRealtimeEvent(payload)) return;

      // compatible fallback for very old payload format
      const msgId = `${payload.order_id || payload.id || ''}_${payload.timestamp || Date.now()}`;
      if (processedMessages.has(msgId)) {
        console.log('[MQTT] duplicate message ignored:', msgId);
        return;
      }
      processedMessages.add(msgId);
      if (processedMessages.size > 120) {
        const iter = processedMessages.values();
        processedMessages.delete(iter.next().value);
      }

      console.log('New order received:', msgId);

      // 1. 鏄剧ず鎻愮ず
      showToast(payload.status === 'review_needed' ? '有加菜请求，等待审核' : '新订单来了');

      // 2) play voice prompt immediately
      playAudio(payload.status || 'pending', payload.order_type || 'dine_in');

      // 3) refresh list with unified delayed strategy
      if (window.refreshOrderList) {
        window.refreshOrderList();
      } else {
        setTimeout(() => {
          location.reload();
        }, 3000);
      }
    }
  }

  function onMessageArrived(message) {
    console.log("MQTT Msg:", message.payloadString);
    try {
      const payload = JSON.parse(message.payloadString);
      handleRealtimePayload(payload);
    } catch(e) { console.error(e); }
  }

  let realtimeSource;
  let realtimeReconnectTimer;

  window.initRealtimeStream = function() {
    if (window.__adminRealtimeStreamInited) return;
    window.__adminRealtimeStreamInited = true;

    const connect = () => {
      try {
        if (realtimeSource) {
          realtimeSource.close();
          realtimeSource = null;
        }

        const streamUrl = `/api/stream/${encodeURIComponent(window.shopSlug)}`;
        realtimeSource = new EventSource(streamUrl);

        realtimeSource.addEventListener('update', (ev) => {
          try {
            const payload = JSON.parse(ev?.data || '{}');
            handleRealtimePayload(payload);
          } catch (e) {
            console.error('[Realtime] invalid payload:', e);
          }
        });

        realtimeSource.onerror = () => {
          try {
            if (realtimeSource) realtimeSource.close();
          } catch {}
          realtimeSource = null;

          if (realtimeReconnectTimer) {
            clearTimeout(realtimeReconnectTimer);
          }
          realtimeReconnectTimer = setTimeout(connect, 2000);
        };
      } catch (e) {
        console.error('[Realtime] connect failed:', e);
      }
    };

    connect();
  }

  function updateMqttStatus(status) {
    const el = document.getElementById('mqtt-status-indicator');
    if (!el) return;
    if (status === 'connected') {
      el.innerHTML = 'MQTT: 已连接';
      el.style.background = '#e8f5e9';
    } else if (status === 'disconnected' || status === 'failed') {
      el.innerHTML = 'MQTT: 已断开';
      el.style.color = '#c62828';
      el.style.background = '#ffebee';
    } else {
      el.innerHTML = 'MQTT: 连接中...';
    }
  }

  // Audio Logic
  let audioCtx;
  window.enableAudio = function() {
    const hasAudio = window.AudioContext || window['webkitAudioContext'];
    // @ts-ignore - webkitAudioContext for legacy browser support
    if (!hasAudio) return alert('浏览器不支持音频 API');
    // @ts-ignore
    if (!audioCtx) audioCtx = new hasAudio()();

    audioCtx.resume().then(() => {
      const el = document.getElementById('sound-status');
      if (el) {
        el.classList.remove('status-off');
        el.classList.add('status-on');
        el.innerText = '声音已激活 (Active)';
      }
      // only play a short test beep
      beep();
    });
  }

  // voice queue and debounce
  let lastSpeakTime = 0;
  let speakQueue = [];
  let isSpeaking = false;

  function playAudio(status = 'pending', orderType = 'dine_in') {
    const mode = document.getElementById('sound-mode')?.value || 'voice';
    if (mode === 'voice') {
      let text;
      if (status === 'review_needed') {
        text = '您有加菜请求，请及时审核。';
      } else if (orderType === 'delivery') {
        text = '您有新的外卖订单，请及时处理。';
      } else {
        text = '您有新的堂食订单，请及时处理。';
      }
      // use queue to avoid overlap
      queueSpeak(text);
    } else {
      beep();
    }
  }

  function queueSpeak(text) {
    const now = Date.now();
    // debounce: skip same text within 5s
    if (now - lastSpeakTime < 5000 && speakQueue.includes(text)) {
      console.log('[Speak] debounce skipped:', text);
      return;
    }

    speakQueue.push(text);
    if (!isSpeaking) {
      processSpeakQueue();
    }
  }

  async function processSpeakQueue() {
    if (speakQueue.length === 0) {
      isSpeaking = false;
      return;
    }

    isSpeaking = true;
    const text = speakQueue.shift();
    lastSpeakTime = Date.now();

    await speakWithPromise(text);

    // play next after 1s gap
    setTimeout(() => {
      processSpeakQueue();
    }, 1000);
  }

  function speakWithPromise(text) {
    return new Promise((resolve) => {
      if (!window.speechSynthesis) {
        beep();
        resolve();
        return;
      }

      // 娓呴櫎涔嬪墠鐨勫唴瀹?
      window.speechSynthesis.cancel();

      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'zh-CN';
      u.rate = 0.9;
      u.pitch = 1.0;
      u.volume = 1.0;

      u.onend = () => resolve();
      u.onerror = () => resolve();

      // prefer Chinese voice if available
      const voices = window.speechSynthesis.getVoices();
      const zhVoice = voices.find(v => v.lang.includes('zh') || v.lang.includes('CN'));
      if (zhVoice) u.voice = zhVoice;

      // browser policies may block speech before user interaction
      // best effort: do not block flow on speech failure
      try {
        window.speechSynthesis.speak(u);
      } catch(e) {
        console.warn('[Speak] playback failed:', e);
        resolve();
      }
    });
  }

  function beep() {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.frequency.value = 800;
    osc.start();
    gain.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + 0.5);
    osc.stop(audioCtx.currentTime + 0.5);
  }

