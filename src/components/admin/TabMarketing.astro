---
interface Props {
  shopSlug: string;
  shopSettings?: {
    points?: {
      pointsPerSpend?: number;
      pointsValue?: number;
    };
  };
}

const { shopSlug, shopSettings } = Astro.props;

const pointsSettings = (shopSettings && shopSettings.points) || {};
const pointsPerSpend = pointsSettings.pointsPerSpend || 20;
const pointsValue = pointsSettings.pointsValue || 1;
---

<div id="tab-marketing" class="tab-content" style="display: none">
  <div style="background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
    <h3 style="margin: 0 0 15px; color: #1d4ed8;">🎯 促销管理</h3>
    
    <div style="margin-bottom: 20px;">
      <button
        data-admin-action="open-promotion"
        style="background: #2563eb; color: #fff; border: none; border-radius: 8px; padding: 10px 16px; cursor: pointer; font-weight: 600;"
      >
        + 添加促销
      </button>
    </div>

    <div id="promotions-list">
      <div style="text-align: center; color: #64748b; padding: 40px;">加载中...</div>
    </div>
  </div>

  <div style="background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
    <h3 style="margin: 0 0 15px; color: #059669;">⭐ 积分设置</h3>
    
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 15px; margin-bottom: 15px;">
      <div style="font-weight: 600; color: #166534;">积分抵扣说明</div>
      <div style="font-size: 13px; color: #15803d; margin-top: 8px;">
        • 客户下单时可使用积分抵扣金额<br/>
        • 消费后自动按比例返还积分<br/>
        • 积分仅限本店铺使用，不可转让
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
      <div>
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">消费多少RSD累计1积分</label>
        <input type="number" id="points-per-spend" min="1" value={pointsPerSpend} 
          style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>
      <div>
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">1积分抵扣多少RSD</label>
        <input type="number" id="points-value" min="0.1" step="0.1" value={pointsValue}
          style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>
    </div>
    <button data-admin-action="save-points-settings" style="background: #059669; color: #fff; border: none; border-radius: 6px; padding: 10px 20px; cursor: pointer; font-weight: 600;">
      保存积分设置
    </button>
  </div>
</div>

<div id="promotion-modal" class="modal" style="display: none; align-items: center; justify-content: center; background: rgba(0,0,0,0.5); position: fixed; inset: 0; z-index: 1000;">
  <div style="background: #fff; border-radius: 12px; padding: 24px; width: min(900px, calc(100vw - 48px)); max-height: 90vh; overflow-y: auto;">
    <h3 id="promotion-modal-title" style="margin: 0 0 20px;">添加促销</h3>

    <form id="promotion-form">
      <input type="hidden" id="promotion-id" value="" />

      <div class="form-group" style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">促销名称</label>
        <input type="text" id="promotion-name" required style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>

      <div class="form-group" style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">促销类型</label>
        <select id="promotion-type" required style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;">
          <option value="spend_discount">满减（满X减Y）</option>
          <option value="special">今日特价</option>
        </select>
      </div>

      <div id="promo-special-fields" class="form-group" style="margin-bottom: 15px; display: none;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">选择特价菜品</label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
          <div>
            <input type="text" id="promo-product-search" placeholder="搜索菜品..." style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
          </div>
          <div style="text-align: right;">
            <small id="promo-selected-count" style="color: #64748b;">已选: 0</small>
          </div>
        </div>
        <div id="promo-selected-products" style="max-height: 150px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 6px; padding: 10px; margin-bottom: 10px;"></div>
        <div id="promo-available-products" style="max-height: 200px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 6px; padding: 10px;"></div>
        <small style="color: #64748b;">选择要设为特价的菜品（可多选）</small>
      </div>

      <div id="promo-special-price-field" class="form-group" style="margin-bottom: 15px; display: none;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">特价金额 (RSD)</label>
        <input type="number" id="promotion-special-price" min="0" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
        <small style="color: #64748b;">设置特价金额（仅对今日特价生效）</small>
      </div>

      <div id="promo-spend-fields" class="form-group" style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">最低消费 (RSD)</label>
        <input type="number" id="promotion-min-spend" min="0" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>

      <div id="promo-discount-fields" class="form-group" style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">减免/折扣值</label>
        <input type="number" id="promotion-discount" min="0" step="1" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
        <small style="color: #64748b;">满减填写减免金额（RSD）</small>
      </div>


      <div class="form-group" style="margin-bottom: 15px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" id="promotion-stackable" />
          <span>可与其他优惠叠加使用</span>
        </label>
      </div>

      <div class="form-group" style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">开始时间（可选）</label>
        <input type="datetime-local" id="promotion-start" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <label style="display: block; margin-bottom: 5px; font-weight: 600;">结束时间（可选）</label>
        <input type="datetime-local" id="promotion-end" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; box-sizing: border-box;" />
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" data-admin-action="close-promotion" style="padding: 10px 20px; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; cursor: pointer;">取消</button>
        <button type="submit" style="padding: 10px 20px; border: none; border-radius: 6px; background: #2563eb; color: #fff; cursor: pointer; font-weight: 600;">保存</button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ shopSlug }}>
  let promotionsData = [];
  let productsData = [];
  let searchTerm = '';
  let specialSelectionState = [];

  function setStyles(el, styles) {
    Object.entries(styles).forEach(([key, value]) => {
      el.style[key] = value;
    });
  }

  function clearChildren(el) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  function renderInfo(container, text, styles = {}) {
    const div = document.createElement('div');
    div.textContent = text;
    setStyles(div, styles);
    clearChildren(container);
    container.appendChild(div);
  }

  function syncSpecialProductUI() {
    renderSelectedProducts();
    renderAvailableProducts();
  }

  function addSpecialProduct(productId) {
    const nextId = Number(productId || 0);
    if (!nextId) return;
    if (specialSelectionState.includes(nextId)) return;
    specialSelectionState = [...specialSelectionState, nextId];
    syncSpecialProductUI();
  }

  function removeSpecialProduct(productId) {
    const nextId = Number(productId || 0);
    specialSelectionState = specialSelectionState.filter((id) => id !== nextId);
    syncSpecialProductUI();
  }

  function renderSelectedProducts() {
    const container = document.getElementById('promo-selected-products');
    if (!container) return;
    clearChildren(container);

    if (!specialSelectionState.length) {
      renderInfo(container, '暂未选择菜品', { color: '#64748b', fontSize: '13px' });
      return;
    }

    specialSelectionState.forEach((productId) => {
      const product = getPromotionProductById(productId);
      if (!product) return;

      const chip = document.createElement('button');
      chip.type = 'button';
      chip.textContent = product.displayNameSecondary
        ? `${product.displayNamePrimary} (${product.displayNameSecondary}) · ${product.price} RSD ×`
        : `${product.displayNamePrimary} · ${product.price} RSD ×`;
      setStyles(chip, {
        display: 'inline-flex',
        alignItems: 'center',
        gap: '8px',
        margin: '0 8px 8px 0',
        padding: '8px 10px',
        border: '1px solid #bfdbfe',
        borderRadius: '999px',
        background: '#eff6ff',
        color: '#1d4ed8',
        cursor: 'pointer',
      });
      chip.addEventListener('click', () => removeSpecialProduct(product.id));
      container.appendChild(chip);
    });
  }

  function renderAvailableProducts() {
    const container = document.getElementById('promo-available-products');
    if (!container) return;
    clearChildren(container);

    const selectedProductIds = specialSelectionState;
    const rows = productsData.filter((p) => {
      const primaryText = String(p.displayNamePrimary || '').toLowerCase();
      const secondaryText = String(p.displayNameSecondary || '').toLowerCase();
      if (!selectedProductIds.includes(p.id) && !searchTerm) return true;
      return !selectedProductIds.includes(p.id) && (primaryText.includes(searchTerm) || secondaryText.includes(searchTerm));
    });

    if (!rows.length) {
      renderInfo(container, '没有匹配的菜品', { color: '#64748b', fontSize: '13px' });
      return;
    }

    rows.forEach((product) => {
      const row = document.createElement('div');
      setStyles(row, {
        display: 'grid',
        gridTemplateColumns: 'minmax(0, 1fr) auto auto',
        gap: '10px',
        alignItems: 'center',
        padding: '10px 12px',
        border: '1px solid #e5e7eb',
        borderRadius: '8px',
        background: '#fff',
        marginBottom: '8px',
      });

      const names = document.createElement('div');
      const primary = document.createElement('div');
      primary.textContent = product.displayNamePrimary;
      setStyles(primary, { fontWeight: '600', color: '#111827' });
      names.appendChild(primary);

      if (product.displayNameSecondary) {
        const secondary = document.createElement('div');
        secondary.textContent = product.displayNameSecondary;
        setStyles(secondary, { fontSize: '12px', color: '#6b7280' });
        names.appendChild(secondary);
      }

      const price = document.createElement('div');
      price.textContent = `${product.price} RSD`;
      setStyles(price, { fontSize: '13px', color: '#475569', whiteSpace: 'nowrap' });

      const action = document.createElement('button');
      action.type = 'button';
      action.textContent = '选择';
      setStyles(action, {
        border: 'none',
        borderRadius: '6px',
        background: '#2563eb',
        color: '#fff',
        padding: '8px 12px',
        cursor: 'pointer',
        whiteSpace: 'nowrap',
      });
      action.addEventListener('click', () => addSpecialProduct(product.id));

      row.append(names, price, action);
      container.appendChild(row);
    });
  }

  function setPromotionProductSearch(nextValue) {
    searchTerm = String(nextValue || '').trim().toLowerCase();
  }

  function hydrateSpecialSelection(selectedIds = []) {
    specialSelectionState = Array.isArray(selectedIds) ? [...selectedIds] : [];
  }

  async function fetchJSONWithRetry(url, init) {
    let lastError;
    for (let attempt = 0; attempt < 2; attempt += 1) {
      try {
        const res = await fetch(url, init);
        const data = await res.json();
        return { res, data };
      } catch (error) {
        lastError = error;
      }
    }
    throw lastError;
  }

  async function loadPromotions() {
    const container = document.getElementById('promotions-list');
    try {
      const { res, data } = await fetchJSONWithRetry('/api/admin/promotions');
      if (res.status === 401 || res.status === 403) {
        window.location.href = `${window.location.pathname.replace(/\/?$/, '')}/login`;
        return;
      }
      if (!res.ok || !data.success) {
        throw new Error('load_promotions_failed');
      }
      promotionsData = data.promotions || [];
      renderPromotions();
    } catch (e) {
      console.error('Failed to load promotions:', e);
      if (container) renderInfo(container, '加载促销失败', { textAlign: 'center', color: '#ef4444', padding: '40px' });
    }
  }

  async function loadProducts() {
    const container = document.getElementById('promotions-list');
    try {
      const { res, data } = await fetchJSONWithRetry(`/${encodeURIComponent(shopSlug)}/menu`);
      if (res.status === 401 || res.status === 403) {
        window.location.href = `${window.location.pathname.replace(/\/?$/, '')}/login`;
        return;
      }
      const menuCategories = Array.isArray(data) ? data : Array.isArray(data?.items) ? data.items : Array.isArray(data?.data) ? data.data : [];
      if (!res.ok || !menuCategories.length) {
        throw new Error('load_products_failed');
      }
      productsData = [];
      menuCategories.forEach(cat => {
        (cat.products || []).forEach(p => {
          productsData.push({
            id: Number(p.id || 0),
            name: String(p.name || ''),
            subName: String(p.subName || ''),
            price: Number(p.price || 0),
            displayNamePrimary: String(p.name || ''),
            displayNameSecondary: String(p.subName || ''),
          });
        });
      });
      renderPromotions();
      const promotionTypeNode = document.getElementById('promotion-type');
      const type = promotionTypeNode && 'value' in promotionTypeNode ? promotionTypeNode.value : '';
      if (type === 'special') {
        syncSpecialProductUI();
      }
    } catch (e) {
      console.error('Failed to load products:', e);
      if (container) renderInfo(container, '加载菜品失败', { textAlign: 'center', color: '#ef4444', padding: '40px' });
    }
  }

  function getPromotionProductById(productId) {
    return productsData.find((product) => product.id === Number(productId)) || null;
  }

  function parsePromotionProductIds(raw) {
    const normalizeValues = (values) => values
      .map((value) => {
        if (typeof value === 'object' && value !== null) {
          return Number(value.id || value.productId || value.value || 0);
        }
        return Number(value || 0);
      })
      .filter(Boolean);

    if (Array.isArray(raw)) {
      return normalizeValues(raw);
    }
    if (typeof raw === 'string' && raw.trim()) {
      try {
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed)
          ? normalizeValues(parsed)
          : [];
      } catch (e) {
        return raw.includes(',') ? normalizeValues(raw.split(',')) : normalizeValues([raw]);
      }
    }
    return [];
  }

  function getPromotionStartValue(promotion) {
    const safePromotion = promotion || {};
    return safePromotion.startsAt || safePromotion.startAt || safePromotion.startTime || '';
  }

  function getPromotionEndValue(promotion) {
    const safePromotion = promotion || {};
    return safePromotion.endsAt || safePromotion.endAt || safePromotion.endTime || '';
  }

  function normalizePromotionDatetimeValue(raw) {
    const text = String(raw || '').trim();
    if (!text) return '';
    const normalized = text.includes('T') ? text : text.replace(' ', 'T');
    return normalized.slice(0, 16);
  }

  function formatPromotionDatetime(raw) {
    const normalized = normalizePromotionDatetimeValue(raw);
    if (!normalized) return '';
    return normalized.replace('T', ' ');
  }

  function resetSpecialSelectionState() {
    setPromotionProductSearch('');
    specialSelectionState = [];
    const searchInput = document.getElementById('promo-product-search');
    if (searchInput && 'value' in searchInput) searchInput.value = '';
  }

  function getSelectedProductIds() {
    return [...specialSelectionState];
  }

  function renderPromotions() {
    const container = document.getElementById('promotions-list');
    if (!promotionsData.length) {
      renderInfo(container, '暂无促销活动', { textAlign: 'center', color: '#64748b', padding: '40px' });
      return;
    }
    const nodes = promotionsData.map((p) => {
      const card = document.createElement('div');
      setStyles(card, { border: '1px solid #e5e7eb', borderRadius: '8px', padding: '15px', marginBottom: '10px', opacity: p.is_active ? '1' : '0.6' });
      const top = document.createElement('div');
      setStyles(top, { display: 'flex', justifyContent: 'space-between', alignItems: 'center' });
      const left = document.createElement('div');
      const name = document.createElement('span');
      setStyles(name, { fontWeight: '600', color: '#1f2937' });
      name.textContent = p.name;
      const badge = document.createElement('span');
      setStyles(badge, { marginLeft: '8px', padding: '2px 8px', borderRadius: '4px', fontSize: '12px', background: p.is_active ? '#dcfce7' : '#f3f4f6', color: p.is_active ? '#166534' : '#6b7280' });
      badge.textContent = p.is_active ? '活动中' : '已停用';
      left.append(name, badge);

      const actions = document.createElement('div');
      setStyles(actions, { display: 'flex', gap: '8px' });
      const makeBtn = (text, handler, styles = {}) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = text;
        setStyles(btn, { padding: '4px 12px', border: '1px solid #d1d5db', borderRadius: '4px', background: '#fff', cursor: 'pointer', fontSize: '12px', ...styles });
        btn.addEventListener('click', handler);
        return btn;
      };
      actions.append(
        makeBtn(p.is_active ? '停用' : '启用', () => togglePromotion(p.id)),
        makeBtn('编辑', () => editPromotion(p.id)),
        makeBtn('删除', () => deletePromotion(p.id), { border: '1px solid #fca5a5', color: '#dc2626' }),
      );

      top.append(left, actions);
      const desc = document.createElement('div');
      setStyles(desc, { fontSize: '13px', color: '#64748b', marginTop: '8px' });
      desc.textContent = renderPromoDesc(p);
      card.append(top, desc);
      return card;
    });
    clearChildren(container);
    nodes.forEach((n) => container.appendChild(n));
  }

  function renderPromoDesc(p) {
    if (p.promoType === 'spend_discount') {
      return `满 ${p.minSpendRsd || 0} RSD 减 ${p.discountAmountRsd || 0} RSD ${p.stackable ? '(可叠加)' : ''}`;
    } else if (p.promoType === 'special') {
      const ids = parsePromotionProductIds(p.selectedProducts);
      let productNames = ids.length === 1 ? '单个菜品' : '多个菜品';
      const names = productsData
        .filter((prod) => ids.includes(prod.id))
        .map((prod) => prod.displayNameSecondary
          ? `${prod.displayNamePrimary} (${prod.displayNameSecondary})`
          : prod.displayNamePrimary);
      if (names.length > 0) {
        productNames = names.slice(0, 3).join(', ') + (names.length > 3 ? '...' : '');
      }
      const timeParts = [];
      const startText = formatPromotionDatetime(getPromotionStartValue(p));
      const endText = formatPromotionDatetime(getPromotionEndValue(p));
      if (startText) timeParts.push(`开始: ${startText}`);
      if (endText) timeParts.push(`结束: ${endText}`);
      const timeText = timeParts.length ? ` · ${timeParts.join(' · ')}` : '';
      return `今日特价: ${productNames} → ${p.specialPriceRsd || 0} RSD${timeText}`;
    }
    return '';
  }

  window.openPromotionModal = function() {
    document.getElementById('promotion-modal-title').innerText = '添加促销';
    document.getElementById('promotion-form').reset();
    document.getElementById('promotion-id').value = '';
    resetSpecialSelectionState();
    updatePromoFields();
    document.getElementById('promotion-modal').style.display = 'flex';
    loadProducts();
  };

  window.closePromotionModal = function() {
    document.getElementById('promotion-modal').style.display = 'none';
  };

  window.editPromotion = function(id) {
    const p = promotionsData.find(x => x.id === id);
    if (!p) return;

    document.getElementById('promotion-modal-title').innerText = '编辑促销';
    document.getElementById('promotion-id').value = p.id;
    document.getElementById('promotion-name').value = p.name;
    document.getElementById('promotion-type').value = p.promoType;
    document.getElementById('promotion-min-spend').value = p.minSpendRsd || '';
    document.getElementById('promotion-discount').value = p.discountAmountRsd || '';
    document.getElementById('promotion-stackable').checked = p.stackable === 1;
    document.getElementById('promotion-special-price').value = p.specialPriceRsd || '';

    resetSpecialSelectionState();
    hydrateSpecialSelection(parsePromotionProductIds(p.selectedProducts));
    setPromotionProductSearch('');

    document.getElementById('promotion-start').value = normalizePromotionDatetimeValue(getPromotionStartValue(p));
    document.getElementById('promotion-end').value = normalizePromotionDatetimeValue(getPromotionEndValue(p));

    updatePromoFields();
    document.getElementById('promotion-modal').style.display = 'flex';
    loadProducts();
  };

  document.getElementById('promotion-type').addEventListener('change', updatePromoFields);
  const promoProductSearchInput = document.getElementById('promo-product-search');
  if (promoProductSearchInput) {
    promoProductSearchInput.addEventListener('input', (event) => {
      const target = event.target;
      setPromotionProductSearch(target && 'value' in target ? target.value : '');
      renderAvailableProducts();
    });
  }

  function updatePromoFields() {
    const type = document.getElementById('promotion-type').value;
    document.getElementById('promo-spend-fields').style.display = type === 'spend_discount' ? 'block' : 'none';
    document.getElementById('promo-discount-fields').style.display = type === 'spend_discount' ? 'block' : 'none';
    document.getElementById('promo-special-fields').style.display = type === 'special' ? 'block' : 'none';
    document.getElementById('promo-special-price-field').style.display = type === 'special' ? 'block' : 'none';
    if (type === 'special') {
      syncSpecialProductUI();
    }
  }

  document.getElementById('promotion-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const id = document.getElementById('promotion-id').value;
    const payload = {
      name: document.getElementById('promotion-name').value,
      promoType: document.getElementById('promotion-type').value,
      stackable: document.getElementById('promotion-stackable').checked,
    };

    const type = payload.promoType;
    if (type === 'spend_discount') {
      payload.minSpendRsd = parseInt(document.getElementById('promotion-min-spend').value) || 0;
      payload.discountAmountRsd = parseInt(document.getElementById('promotion-discount').value) || 0;
    } else if (type === 'special') {
      payload.selectedProducts = getSelectedProductIds();
      payload.specialPriceRsd = parseInt(document.getElementById('promotion-special-price').value) || 0;
      if (!payload.selectedProducts.length) {
        alert('请至少选择一个菜品作为今日特价');
        return;
      }
      if (payload.specialPriceRsd <= 0) {
        alert('请设置特价金额');
        return;
      }
    }

    const startVal = document.getElementById('promotion-start').value;
    const endVal = document.getElementById('promotion-end').value;
    if (startVal) {
      payload.startsAt = startVal;
    }
    if (endVal) {
      payload.endsAt = endVal;
    }

    try {
      const url = id ? `/api/admin/promotions/${id}` : '/api/admin/promotions';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        closePromotionModal();
        loadPromotions();
      } else {
        alert('操作失败: ' + (data.error || '未知错误'));
      }
    } catch (e) {
      alert('网络错误');
    }
  });

  window.togglePromotion = async function(id) {
    try {
      const res = await fetch(`/api/admin/promotions/${id}/toggle`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        loadPromotions();
      } else {
        alert('操作失败');
      }
    } catch (e) {
      alert('网络错误');
    }
  };

  window.deletePromotion = async function(id) {
    if (!confirm('确认删除该促销？')) return;
    try {
      const res = await fetch(`/api/admin/promotions/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        loadPromotions();
      } else {
        alert('删除失败');
      }
    } catch (e) {
      alert('网络错误');
    }
  };

  window.savePointsSettings = async function() {
    const pointsPerSpend = parseInt(document.getElementById('points-per-spend').value) || 20;
    const pointsValue = parseFloat(document.getElementById('points-value').value) || 1;
    
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          points: {
            pointsPerSpend: pointsPerSpend,
            pointsValue: pointsValue
          }
        })
      });
      const data = await res.json();
      if (data.success) {
        alert('积分设置已保存');
      } else {
        alert('保存失败: ' + (data.error || '未知错误'));
      }
    } catch (e) {
      alert('网络错误');
    }
  };

  window.loadPromotions = loadPromotions;
  window.loadMarketingProducts = loadProducts;
</script>
