<div id="tab-password" class="tab-content">
  <div class="settings-card">
    <h3>🔑 修改密码</h3>
    <form id="password-form">
      <div class="form-group">
        <label>新密码</label>
        <input type="password" name="new_password" placeholder="请输入新密码" required minlength="4" />
      </div>
      <button type="button" class="btn-save" data-admin-action="update-password">💾 更新密码</button>
    </form>
  </div>
</div>
