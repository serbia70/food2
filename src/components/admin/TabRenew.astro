---
const { isWarning, expireDateStr, daysLeft, lastMonthCommission, isLastMonthPaid, showPayWarning, lastMonthName } = Astro.props;
---
<div id="tab-renew" class="tab-content">
  <div class="settings-card" style="text-align:center;">
    <h3>💳 续费服务 / Renew Service</h3>

    <div style="background:#f8f9fa; padding:20px; border-radius:8px; margin:15px 0;">
      <p style="margin:0; font-size:18px; color:#2d3748;">
        服务有效期至: <strong style={`color:${isWarning ? '#d32f2f' : '#2e7d32'}`}>{expireDateStr}</strong>
      </p>
      <p style="margin:10px 0 0; font-size:14px; color:#718096;">
        剩余 <strong style={`color:${daysLeft <= 7 ? '#e53e3e' : '#3182ce'}`}>{daysLeft}</strong> 天
      </p>
    </div>

    {/* 佣金账单卡片 (新增) */}
    <div style="background:#fff; border:2px solid #e2e8f0; border-radius:12px; margin:20px 0; overflow:hidden;">
      <div style="background:#f7fafc; padding:15px; border-bottom:1px solid #e2e8f0;">
        <h4 style="margin:0; color:#2d3748;">🧾 佣金账单 / Commission Bill</h4>
      </div>

      <div style="padding:20px;">
        {/* 上月账单 (重点) */}
        <div style="margin-bottom:20px; padding-bottom:20px; border-bottom:1px dashed #e2e8f0;">
          <p style="margin:0 0 5px; color:#718096; font-size:14px;">
            {isLastMonthPaid ? `${lastMonthName}月份已结清金额` : `${lastMonthName}月份待付佣金`}
          </p>
          <div style="display:flex; align-items:baseline; justify-content:center; gap:5px;">
            <span style="font-size:32px; font-weight:bold; color:#d32f2f;">{lastMonthCommission}</span>
            <span style="color:#718096;">RSD</span>
          </div>
          {showPayWarning && (
            <div style="margin-top:10px; background:#fff5f5; color:#c53030; padding:8px; border-radius:4px; font-size:13px; display:inline-block;">
              ⚠️ 请于本月6号前完成支付
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
