<div id="tab-reservations" class="tab-content">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:12px;">
    <h3 style="margin:0; color:#1f2d3d;">📅 预约管理</h3>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <input id="reservation-date" type="date" style="padding:8px; border:1px solid #ddd; border-radius:6px;" data-admin-action="load-reservations" />
      <button class="btn-xs" type="button" data-admin-action="reservation-filter" data-mode="today">今天</button>
      <button class="btn-xs" type="button" data-admin-action="reservation-filter" data-mode="7days" style="background:#2563eb; color:#fff;">最近7天</button>
      <button class="btn-xs" type="button" data-admin-action="reservation-filter" data-mode="all">全部日期</button>
      <select id="reservation-status" style="padding:8px; border:1px solid #ddd; border-radius:6px;" data-admin-action="load-reservations">

        <option value="">全部状态</option>
        <option value="pending">待确认</option>
        <option value="confirmed">已确认</option>
        <option value="completed">已完成</option>
        <option value="cancelled">已取消</option>
      </select>
      <button class="btn-blue" data-admin-action="load-reservations">查询</button>
    </div>
  </div>
  <div style="font-size:12px; color:#6c7a89; margin-top:-6px; margin-bottom:10px;">不选日期=显示全部预约</div>

  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:10px; margin-bottom:15px;">
    <div class="stat-box"><div class="stat-label">今日预约</div><div id="res-stat-total" class="stat-val">0</div></div>
    <div class="stat-box"><div class="stat-label">待确认</div><div id="res-stat-pending" class="stat-val">0</div></div>
    <div class="stat-box"><div class="stat-label">已确认</div><div id="res-stat-confirmed" class="stat-val">0</div></div>
    <div class="stat-box"><div class="stat-label">已完成</div><div id="res-stat-completed" class="stat-val">0</div></div>
    <div class="stat-box"><div class="stat-label">已取消</div><div id="res-stat-cancelled" class="stat-val">0</div></div>
  </div>

  <div id="reservation-list" style="display:flex; flex-direction:column; gap:10px;"></div>
</div>
