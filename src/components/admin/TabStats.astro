<div id="tab-stats" class="tab-content">
  <div class="settings-card">
    <h3>📊 营业数据</h3>
    <div class="date-filter">
      <input type="date" id="stats-start" />
      <span>至</span>
      <input type="date" id="stats-end" />
      <select id="stats-type" style="padding:8px; border:1px solid #ddd; border-radius:4px;">
        <option value="all">📊 全部</option>
        <option value="delivery">🛵 外卖</option>
        <option value="dine_in">🍽️ 堂食</option>
      </select>
      <button class="btn-blue" data-admin-action="load-stats">查询</button>
    </div>

    <div class="stats-grid">
      <div class="stat-box">
        <div class="stat-label">总营业额</div>
        <div class="stat-val" id="val-revenue">0</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">总订单</div>
        <div class="stat-val" id="val-orders">0</div>
      </div>
    </div>

    <h4>🔥 销量排名</h4>
    <table class="order-table" id="stats-table">
      <thead>
        <tr>
          <th>#</th>
          <th>菜品</th>
          <th>量</th>
          <th>额</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="4" style="text-align:center">请查询</td></tr>
      </tbody>
    </table>
  </div>
</div>
