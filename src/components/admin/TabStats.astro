<div id="tab-stats" class="tab-content">
  <div class="settings-card">
    <h3>📊 营业统计 / Statistika prometa</h3>
    <div class="date-filter">
      <input type="date" id="stats-start" />
      <span>至</span>
      <input type="date" id="stats-end" />
      <select id="stats-type" style="padding:8px; border:1px solid #ddd; border-radius:4px;">
        <option value="all">📊 全部 / Sve</option>
        <option value="delivery">🛵 外卖 / Dostava</option>
        <option value="dine_in">🍽️ 堂食 / U lokalu</option>
      </select>
      <button class="btn-blue" data-admin-action="load-stats">查询统计 / Pretraži statistiku</button>
    </div>

    <div class="stats-grid">
      <div class="stat-box">
        <div class="stat-label">总营业额 / Ukupan promet</div>
        <div class="stat-val" id="val-revenue">0</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">总订单数 / Ukupan broj porudžbina</div>
        <div class="stat-val" id="val-orders">0</div>
      </div>
    </div>

    <h4>🔥 菜品销量排名 / Rang lista prodaje jela</h4>
    <table class="order-table" id="stats-table">
      <thead>
        <tr>
          <th>#</th>
          <th>菜品 / Jelo</th>
          <th>数量 / Količina</th>
          <th>营业额 / Promet</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="4" style="text-align:center">请选择日期范围 / Odaberite datume</td></tr>
      </tbody>
    </table>
  </div>
</div>
