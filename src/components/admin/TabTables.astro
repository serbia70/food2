---
import { inferLegacySimpleHallNumber } from '../../lib/admin-table-ref';
const { tableCardsData, activeDeliveryOrders, unmatchedDineInOrders = [], useSimpleHallLabel = false } = Astro.props;
const simpleHallMaxCount = Array.isArray(tableCardsData) ? tableCardsData.length : 0;
const belgradeTime = new Intl.DateTimeFormat('sr-RS', { timeZone: 'Europe/Belgrade', hour: '2-digit', minute: '2-digit', hour12: false });
function formatBelgradeHHmm(v: any) {
  if (!v) return '--:--';
  const raw = String(v).replace(' ', 'T');
  const d = new Date(raw.endsWith('Z') ? raw : `${raw}Z`);
  if (Number.isNaN(d.getTime())) return String(v).slice(11, 16);
  return belgradeTime.format(d);
}

function formatScheduledLabel(v: any) {
  if (!v) return '';
  const raw = String(v).trim();
  if (!raw) return '';
  const normalized = raw.replace(' ', 'T');
  const d = new Date(normalized.endsWith('Z') ? normalized : `${normalized}Z`);
  if (Number.isNaN(d.getTime())) return raw;
  return d.toLocaleString('sr-RS', {
    timeZone: 'Europe/Belgrade',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

function parseItems(raw: any): any[] {
  try {
    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
    if (Array.isArray(parsed)) return parsed;
    if (parsed && typeof parsed === 'object') return Object.values(parsed);
  } catch {}
  return [];
}

function formatTableTitle(card: any) {
  const explicit = String(card?.tableLabel || '').trim();
  if (explicit) return explicit;
  const zone = String(card?.zoneName || '').trim();
  const num = String(card?.displayNum || '').trim();
  const count = Number(card?.zoneCount || 0);
  const isHall = zone === '大厅' || zone === '大堂' || zone.toLowerCase() === 'hall' || zone.toLowerCase() === 'main hall';
  if (count <= 1 && zone && !isHall) return zone;
  if (useSimpleHallLabel && isHall && num) return `${num}号桌`;
  if (zone && num) return `${zone} ${num}号桌`;
  if (num) return `${num}号桌`;
  if (zone) return zone;
  return String(card?.tableNum || '桌位');
}

function formatUnmatchedTableLabel(rawTableInfo: any) {
  const raw = String(rawTableInfo || '').trim();
  if (!raw) return '--';
  const cleaned = raw.replace(/\s*(号桌|桌号|桌)\s*$/u, '').trim();
  const m = cleaned.match(/^(.*?)\s*(\d+)$/u);
  if (!m) return cleaned;

  const area = String(m[1] || '').trim();
  const num = String(Number(m[2] || '0') || m[2]);
  const areaLower = area.toLowerCase();
  const isHall = area === '大厅' || area === '大堂' || areaLower === 'hall' || areaLower === 'main hall' || /^区域\d+$/u.test(area);

  if (useSimpleHallLabel && isHall) return `${num}号桌`;

  if (useSimpleHallLabel) {
    const legacy = inferLegacySimpleHallNumber(cleaned, simpleHallMaxCount);
    if (legacy) return `${legacy}号桌`;
  }

  if (area) return `${area} ${num}号桌`;
  return `${num}号桌`;
}
---
<div id="tab-tables" class="tab-content active-content">

  {unmatchedDineInOrders.length > 0 && (
    <div style="margin: 6px 0 18px; padding: 10px; border: 1px solid #ffcc80; background: #fff8e1; border-radius: 8px;">
      <div style="font-weight: 700; color: #ef6c00; margin-bottom: 8px;">
        ⚠️ 未匹配到桌位配置的订单（可直接结账）
      </div>
      <div style="display: grid; gap: 8px;">
        {[...unmatchedDineInOrders].sort((a: any, b: any) => Number(b.id || 0) - Number(a.id || 0)).map((o: any) => {
          const pickupNo = String(o.order_no || o.id || '').slice(-3);
          return (
            <div style="display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #ffe0b2; border-radius:6px; padding:8px 10px;">
              <span style="font-weight:700; color:#ef6c00; min-width:76px;">取餐号: {pickupNo}</span>
              <span style="color:#333;">桌号: {formatUnmatchedTableLabel(o.table_info)}</span>
              <span style="color:#666; margin-left:auto;">{formatBelgradeHHmm(o.created_at)}</span>
              <span style="font-weight:700; color:#d32f2f;">{o.total_amount} RSD</span>
              <button class="btn-xs" data-admin-action="mark-paid" data-order-id={o.id} style="background:#4caf50; color:#fff;">💰 结账</button>
              <button class="btn-action" data-admin-action="print-order" data-order-id={o.id} title="打印" style="height:24px; width:24px; font-size:12px;">🖨️</button>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {/* A. 堂食区域 */}
  <div class="section-title" style="margin: 10px 0 15px; padding-left: 10px; border-left: 4px solid #2196f3; font-weight: bold; font-size: 18px;">
    🍽️ 堂食区域 (Dine-in)
  </div>

  <div class="tables-grid-wide">
    <div style="grid-column: 1 / -1; margin-bottom: 10px; text-align: right;">
      <!-- Test button removed -->
    </div>

    {tableCardsData.map((card: any) => (
      <div
        class={`table-card-wide ${card.hasOrder ? 'occupied' : 'empty'}`}
        data-table={card.tableNum}
        data-order-time={card.orderTimeTimestamp}
      >
        <div class="card-header">
          <div class="table-title" style="display:flex; align-items:center; gap:6px;">
            <span>{formatTableTitle(card)}</span>
            {card.hasOrder && (
              <button
                type="button"
                class="btn-action"
                data-admin-action="table-details"
                data-table={card.tableNum}
                title="订单详情"
                style="height:22px; width:22px; font-size:12px;"
              >📋</button>
            )}
          </div>
          {card.hasOrder ? (
            <div class="status-info">
              <div class="amount-red">{card.total} RSD</div>
              {card.latestPickupNo && (
                <div style="font-size: 12px; color: #d32f2f; font-weight: 700; background: #ffebee; padding: 2px 8px; border-radius: 999px; margin-top: 4px; display: inline-block;">
                  取餐号: {card.latestPickupNo}
                </div>
              )}
              <div class="time-badge" style="font-size: 14px; color: #666; background: #eee; padding: 2px 8px; border-radius: 4px;">
                🕒 {card.orderTime}
                <style>
                  /* 样式移除，移至全局或父组件 */
                </style>
              </div>
            </div>
          ) : (
            <div class="status-empty" style="color:#999; font-size:14px;">空闲</div>
          )}
        </div>

        <div class="card-actions">
          <button class="btn-wide btn-order" data-admin-action="table-order" data-table={card.tableNum}>📝 点餐</button>
          <button class="btn-wide btn-checkout" data-admin-action="table-checkout" data-table={card.tableNum} disabled={!card.hasOrder}>💰 结账</button>
          {card.hasOrder && (
            <button class="btn-wide btn-modify" data-admin-action="table-modify" data-table={card.tableNum}>✏️ 修改</button>
          )}
          <button class="btn-wide btn-remarks" data-admin-action="table-remarks" data-table={card.tableNum} disabled={!card.hasOrder}>🏷️ 备注</button>

          {card.hasReviewRequest ? (
            <>
              <button class="btn-wide" data-admin-action="approve-table-reviews" data-table={card.tableNum} style="grid-column: span 2; background: #4caf50; color: white; font-weight: bold;">✅ 同意加菜</button>
              <button class="btn-wide" data-admin-action="reject-table-reviews" data-table={card.tableNum} style="grid-column: span 2; background: #f44336; color: white; font-weight: bold;">❌ 拒绝</button>
            </>
          ) : (
            <button class="btn-wide btn-print" data-admin-action="table-print" data-table={card.tableNum} style="grid-column: span 4; background: #795548;">🖨️ 打印</button>
          )}
        </div>
      </div>
    ))}
  </div>

  {/* B. 外卖区域 */}
  <div class="section-title" style="margin: 30px 0 15px; padding-left: 10px; border-left: 4px solid #ff9800; font-weight: bold; font-size: 18px; display:flex; justify-content:space-between; align-items:center;">
    <span>🛵 外卖 / 待处理 (Delivery & Pending)</span>
    <span style="font-size:14px; font-weight:normal; color:#666;">按时间倒序排列</span>
  </div>

  <div id="delivery-list-container" class="delivery-list-container">
    {activeDeliveryOrders.length === 0 ? (
      <div style="text-align:center; padding:30px; color:#999; background:#fff; border-radius:8px; border:1px dashed #ddd;">暂无进行中的外卖订单</div>
    ) : (
      // 修复：按 ID 倒序排列，确保最新的在最上面
      [...activeDeliveryOrders].sort((a: any, b: any) => b.id - a.id).map((o: any) => {
        const orderNo = String(o.order_no || o.id || '');
        const pickupNo = orderNo.length > 3 ? orderNo.slice(-3) : orderNo;
        const displayPrefix = orderNo.slice(0, Math.max(0, orderNo.length - pickupNo.length));
        const displaySuffix = pickupNo;
        const oTime = new Date(o.created_at).getTime();
        const deliveryItems = parseItems(o.items_json);
        

        return (
          <div class="order-card delivery-card-active" style="border-left: 5px solid #ff9800;" data-order-time={oTime}>
            <div class="order-header">
              <span class="order-type-tag delivery">外卖</span>
              <span class="order-no">
                #{displayPrefix}<span style="color:#d32f2f; font-weight:bold;">{displaySuffix}</span>
              </span>
              <span style="margin-left:10px; background:#e3f2fd; color:#1565c0; padding:2px 6px; border-radius:4px; font-size:12px; font-weight:bold;">
                取餐号: {pickupNo}
              </span>
              <span class="order-time" style="margin-left:auto;">{formatBelgradeHHmm(o.created_at)}</span>
            </div>

            <div class="order-address-row" style="margin-top:0; margin-bottom:10px; font-weight:bold; font-size:14px;">
              📍 {o.table_info}
              <span style="font-weight:normal; color:#666; margin-left:10px;">(Tel: {o.user_phone || '-'})</span>
            </div>
            {o.scheduled_for && (
              <div class="order-address-row" style="margin-top:-4px; margin-bottom:10px; color:#1565c0; font-size:13px;">
                ⏰ 预约送达: {formatScheduledLabel(o.scheduled_for)}
              </div>
            )}

            <div class="order-items-list">
              {deliveryItems.map((i: any) => (
                <span style="display:inline-block; margin-right:10px; font-size:13px; color:#333; background:#f5f5f5; padding:2px 6px; border-radius:4px; margin-bottom:4px;">
                  {i.name}
                  {(i.subName || i.sub_name) && <span style="color:#666; font-size:12px; margin-left:4px;">({i.subName || i.sub_name})</span>}
                  <span style="color:#d32f2f; font-weight:bold; margin-left:4px;">x{i.quantity}</span>
                </span>
              ))}
            </div>

            <div class="order-footer" style="margin-top:10px; padding-top:10px; border-top:1px dashed #eee;">
              <div class="footer-left">
                <span class={`status-tag status-${o.status}`}>
                  {o.status === 'pending' ? '待处理' :
                   o.status === 'confirmed' ? '已接单' :
                   o.status === 'delivering' ? '派送中' : o.status}
                </span>

                {(o.status === 'pending' || o.status === 'confirmed') && (
                  <>
                    <button class="btn-xs" data-admin-action="open-delivery" data-order-id={o.id} style="background:#2196f3; color:white;">🛵 送餐</button>
                    <button class="btn-xs" data-admin-action="mark-paid" data-order-id={o.id} style="background:#4caf50; color:white;">💰 结账</button>
                    <button class="btn-xs" data-admin-action="open-reject" data-order-id={o.id} style="background:#f44336; color:white;">❌ 拒绝</button>
                  </>
                )}
                {o.status === 'delivering' && (
                  <button class="btn-xs" data-admin-action="mark-paid" data-order-id={o.id} style="background:#4caf50; color:white;">💰 完成结账</button>
                )}

                {o.user_phone && (
                  <button data-admin-action="open-chat" data-phone={o.user_phone} title="发消息" style="height:24px; width:24px; font-size:12px; background:#0891b2; color:#fff; border:none; border-radius:4px; cursor:pointer;">💬</button>
                )}

                {(o.status === 'pending' || o.status === 'confirmed' || o.status === 'delivering') && (
                  <button class="btn-action" data-admin-action="edit-order" data-order-id={o.id} title="编辑" style="height:24px; width:24px; font-size:12px;">✏️</button>
                )}
                <button class="btn-action" data-admin-action="print-order" data-order-id={o.id} title="打印" style="height:24px; width:24px; font-size:12px;">🖨️</button>
              </div>
              <div class="footer-right">
                <span class="order-amount">{o.total_amount} RSD</span>
              </div>
              <span class="hidden-data" data-oid={o.id} data-order-id={o.id} data-order-no={o.order_no} data-items={o.items_json} data-total={o.total_amount} data-table={o.table_info} data-status={o.status}></span>
            </div>
          </div>
        );
      })
    )}
  </div>
</div>
