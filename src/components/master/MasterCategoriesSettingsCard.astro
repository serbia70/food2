---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['categories'] };
---

<section class="settings-card settings-card-categories">
  <div class="settings-head">
    <div>
      <div class="settings-title">首页分类 JSON 配置</div>
      <div class="settings-subtitle">直接维护首页分类配置 JSON，适合快速同步旧版主控台的全局分类结构。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterCategoriesSettings ? window.submitMasterCategoriesSettings(this) : false;">
    <label class="settings-span-2">
      <span>分类 JSON</span>
      <textarea name="categoriesJson" rows="12" spellcheck="false">{settings.categoriesJson}</textarea>
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存分类配置</button>
      <div id="master-categories-settings-feedback" class="settings-feedback">提交前会校验 JSON 格式，避免把非法结构写进系统配置。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #7c3aed;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head { margin-bottom: 14px; }
  .settings-title { font-size: 20px; font-weight: 900; color: #0f172a; }
  .settings-subtitle { margin-top: 4px; font-size: 13px; color: #64748b; }
  .settings-form { display: grid; gap: 14px; }
  .settings-form label { display: grid; gap: 6px; }
  .settings-form span { font-size: 12px; font-weight: 700; color: #475569; }
  .settings-form textarea { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 13px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; background: #fff; resize: vertical; }
  .settings-actions { display: grid; gap: 8px; }
  .settings-submit { border: none; border-radius: 10px; padding: 12px 16px; background: #7c3aed; color: #fff; font-weight: 800; cursor: pointer; }
  .settings-feedback { font-size: 12px; color: #64748b; }
</style>
