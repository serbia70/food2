---
export type DangerConfirmParam = { label: string; value: string };

export type MasterDangerConfirmOpenOptions = {
  title?: string;
  description?: string;
  params?: DangerConfirmParam[];
  confirmToken?: string;
  inputLabel?: string;
  inputPlaceholder?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  countdownSeconds?: number;
  onConfirm?: () => void | Promise<void>;
};

type Props = {
  id?: string;
  title?: string;
  description?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  inputLabel?: string;
  inputPlaceholder?: string;
  countdownSeconds?: number;
};

const {
  id = 'master-danger-confirm',
  title = '高危操作确认',
  description = '此操作不可恢复，请仔细确认。',
  confirmLabel = '确认执行',
  cancelLabel = '取消',
  inputLabel = '请输入确认词',
  inputPlaceholder = '例如：DELETE',
  countdownSeconds = 0,
} = Astro.props as Props;

const defaults = {
  title,
  description,
  confirmLabel,
  cancelLabel,
  inputLabel,
  inputPlaceholder,
  countdownSeconds,
};
---

<div id={id} class="danger-shell" hidden aria-hidden="true">
  <div class="danger-backdrop" data-danger-cancel></div>
  <aside class="danger-panel" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`}>
    <header class="danger-head">
      <div>
        <div id={`${id}-title`} class="danger-title" data-danger-title>{title}</div>
        <div id={`${id}-desc`} class="danger-desc" data-danger-desc>{description}</div>
      </div>
      <button type="button" class="danger-close" data-danger-cancel aria-label="关闭">×</button>
    </header>

    <section class="danger-body">
      <div class="danger-summary" data-danger-summary hidden>
        <div class="danger-summary-title">关键参数</div>
        <dl class="danger-summary-grid" data-danger-params></dl>
      </div>

      <div class="danger-slot">
        <slot name="summary" />
      </div>

      <div class="danger-input-block">
        <label class="danger-input-label">
          <span data-danger-input-label>{inputLabel}</span>
          <input
            type="text"
            autocomplete="off"
            spellcheck="false"
            class="danger-input"
            data-danger-input
            placeholder={inputPlaceholder}
          />
        </label>
        <div class="danger-token-hint">
          需要输入：<code data-danger-token></code>
        </div>
        <div class="danger-countdown" data-danger-countdown hidden>
          请等待 <span data-danger-countdown-seconds>0</span> 秒后再确认。
        </div>
        <div class="danger-feedback" data-danger-feedback aria-live="polite"></div>
      </div>

      <div class="danger-actions">
        <button type="button" class="danger-cancel" data-danger-cancel>{cancelLabel}</button>
        <button type="button" class="danger-confirm" data-danger-confirm disabled>{confirmLabel}</button>
      </div>
    </section>
  </aside>
</div>

<style>
  .danger-shell[hidden] { display: none; }
  .danger-shell { position: fixed; inset: 0; z-index: 120; }
  .danger-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.55); }
  .danger-panel {
    position: absolute;
    top: 10vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(640px, calc(100% - 24px));
    background: #fff;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.22);
    overflow: hidden;
  }

  .danger-head {
    padding: 18px 18px 12px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #e2e8f0;
  }

  .danger-title { font-size: 20px; font-weight: 900; color: #0f172a; }
  .danger-desc { margin-top: 4px; font-size: 13px; color: #475569; line-height: 1.6; }
  .danger-close {
    border: none;
    background: #f8fafc;
    color: #334155;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
  }

  .danger-body { padding: 14px 18px 18px; display: grid; gap: 14px; }

  .danger-summary { border: 1px solid #fee2e2; background: #fff1f2; border-radius: 14px; padding: 12px; }
  .danger-summary-title { font-size: 12px; font-weight: 900; color: #9f1239; }
  .danger-summary-grid { margin-top: 10px; display: grid; grid-template-columns: minmax(90px, 160px) 1fr; gap: 6px 10px; }
  .danger-summary-grid dt { font-size: 12px; font-weight: 800; color: #9f1239; }
  .danger-summary-grid dd { margin: 0; font-size: 12px; color: #7f1d1d; word-break: break-word; }

  .danger-slot:empty { display: none; }

  .danger-input-block { display: grid; gap: 8px; }
  .danger-input-label { display: grid; gap: 6px; }
  .danger-input-label span { font-size: 12px; font-weight: 800; color: #334155; }
  .danger-input {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 14px;
    background: #fff;
  }
  .danger-input:disabled { background: #f8fafc; color: #64748b; }

  .danger-token-hint { font-size: 12px; color: #475569; }
  .danger-token-hint code { background: #0f172a; color: #fff; border-radius: 8px; padding: 2px 8px; font-weight: 900; }

  .danger-countdown { font-size: 12px; color: #b45309; font-weight: 800; }
  .danger-feedback { font-size: 12px; color: #b91c1c; min-height: 16px; }

  .danger-actions { display: flex; justify-content: flex-end; gap: 10px; padding-top: 6px; }
  .danger-cancel {
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
    border-radius: 12px;
    padding: 10px 14px;
    cursor: pointer;
    font-weight: 800;
  }
  .danger-confirm {
    border: none;
    background: #b91c1c;
    color: #fff;
    border-radius: 12px;
    padding: 10px 14px;
    cursor: pointer;
    font-weight: 900;
  }
  .danger-confirm:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

<script define:vars={{ id, defaults }}>
  (function () {
    const root = document.getElementById(id);
    if (!(root instanceof HTMLElement)) return;

    const titleEl = root.querySelector('[data-danger-title]');
    const descEl = root.querySelector('[data-danger-desc]');
    const summaryWrap = root.querySelector('[data-danger-summary]');
    const paramsDl = root.querySelector('[data-danger-params]');
    const tokenEl = root.querySelector('[data-danger-token]');
    const inputLabelEl = root.querySelector('[data-danger-input-label]');
    const inputEl = root.querySelector('[data-danger-input]');
    const countdownEl = root.querySelector('[data-danger-countdown]');
    const countdownSecondsEl = root.querySelector('[data-danger-countdown-seconds]');
    const feedbackEl = root.querySelector('[data-danger-feedback]');
    const confirmBtn = root.querySelector('[data-danger-confirm]');

    const cancelEls = Array.from(root.querySelectorAll('[data-danger-cancel]'));

    if (!(titleEl instanceof HTMLElement)) return;
    if (!(descEl instanceof HTMLElement)) return;
    if (!(summaryWrap instanceof HTMLElement)) return;
    if (!(paramsDl instanceof HTMLElement)) return;
    if (!(tokenEl instanceof HTMLElement)) return;
    if (!(inputLabelEl instanceof HTMLElement)) return;
    if (!(inputEl instanceof HTMLInputElement)) return;
    if (!(countdownEl instanceof HTMLElement)) return;
    if (!(countdownSecondsEl instanceof HTMLElement)) return;
    if (!(feedbackEl instanceof HTMLElement)) return;
    if (!(confirmBtn instanceof HTMLButtonElement)) return;

    let resolveCurrent = null;
    let onConfirmCurrent = null;
    let expectedToken = '';
    let inFlight = false;
    let confirmLabelCurrent = defaults.confirmLabel;
    let countdownLeft = 0;
    let countdownTimer = null;

    function setHidden(hidden) {
      root.hidden = hidden;
      root.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      if (!hidden) {
        try { inputEl.focus(); } catch {}
      }
    }

    function stopCountdown() {
      if (countdownTimer) {
        clearInterval(countdownTimer);
        countdownTimer = null;
      }
      countdownLeft = 0;
      countdownEl.hidden = true;
    }

    function updateCountdownUi() {
      const seconds = Math.max(0, Math.ceil(countdownLeft));
      if (seconds <= 0) {
        countdownEl.hidden = true;
      } else {
        countdownEl.hidden = false;
        countdownSecondsEl.textContent = String(seconds);
      }
    }

    function updateConfirmDisabled() {
      const typed = String(inputEl.value || '').trim();
      const tokenOk = expectedToken ? typed === expectedToken : true;
      const countdownOk = countdownLeft <= 0;
      confirmBtn.disabled = Boolean(inFlight || !tokenOk || !countdownOk);
    }

    function renderParams(params) {
      while (paramsDl.firstChild) paramsDl.removeChild(paramsDl.firstChild);
      if (!Array.isArray(params) || params.length === 0) {
        summaryWrap.hidden = true;
        return;
      }

      summaryWrap.hidden = false;
      for (const row of params) {
        const dt = document.createElement('dt');
        const labelValue = row && row.label !== undefined && row.label !== null ? row.label : '';
        dt.textContent = String(labelValue);

        const dd = document.createElement('dd');
        const valueValue = row && row.value !== undefined && row.value !== null ? row.value : '';
        dd.textContent = String(valueValue);

        paramsDl.appendChild(dt);
        paramsDl.appendChild(dd);
      }
    }

    function closeWith(result) {
      stopCountdown();
      setHidden(true);
      inFlight = false;
      updateConfirmDisabled();
      const resolve = resolveCurrent;
      resolveCurrent = null;
      onConfirmCurrent = null;
      if (typeof resolve === 'function') resolve(result);
    }

    function warnBusy() {
      // Lightweight hint: do not close while confirm action is running.
      feedbackEl.textContent = '操作进行中，请稍候...';
    }

    function requestClose() {
      if (inFlight) {
        warnBusy();
        return;
      }
      closeWith(false);
    }

    async function handleConfirmClick() {
      if (confirmBtn.disabled) return;
      if (typeof resolveCurrent !== 'function') return;

      feedbackEl.textContent = '';
      inFlight = true;
      inputEl.disabled = true;
      confirmBtn.disabled = true;
      confirmBtn.textContent = '处理中...';
      for (const el of cancelEls) {
        if (el instanceof HTMLButtonElement) el.disabled = true;
      }

      try {
        if (typeof onConfirmCurrent === 'function') {
          await onConfirmCurrent();
        }
        closeWith(true);
      } catch (error) {
        const msg = error instanceof Error ? error.message : '操作失败';
        feedbackEl.textContent = msg || '操作失败';
        inFlight = false;
        inputEl.disabled = false;
        for (const el of cancelEls) {
          if (el instanceof HTMLButtonElement) el.disabled = false;
        }
        confirmBtn.textContent = confirmLabelCurrent;
        updateConfirmDisabled();
      }
    }

    function open(options) {
      const opts = options && typeof options === 'object' ? options : {};

      const title = typeof opts.title === 'string' && opts.title ? opts.title : defaults.title;
      const desc = typeof opts.description === 'string' && opts.description ? opts.description : defaults.description;
      const inputLabel = typeof opts.inputLabel === 'string' && opts.inputLabel ? opts.inputLabel : defaults.inputLabel;
      const placeholder = typeof opts.inputPlaceholder === 'string' ? opts.inputPlaceholder : defaults.inputPlaceholder;

      confirmLabelCurrent = typeof opts.confirmLabel === 'string' && opts.confirmLabel ? opts.confirmLabel : defaults.confirmLabel;
      const cancelLabel = typeof opts.cancelLabel === 'string' && opts.cancelLabel ? opts.cancelLabel : defaults.cancelLabel;

      const token = typeof opts.confirmToken === 'string' ? opts.confirmToken : '';
      const countdownSeconds = Number.isFinite(opts.countdownSeconds) ? Number(opts.countdownSeconds) : Number(defaults.countdownSeconds || 0);

      stopCountdown();

      titleEl.textContent = title;
      descEl.textContent = desc;
      inputLabelEl.textContent = inputLabel;
      inputEl.placeholder = placeholder || '';
      inputEl.value = '';
      inputEl.disabled = false;

      expectedToken = token;
      tokenEl.textContent = token;

      confirmBtn.textContent = confirmLabelCurrent;
      confirmBtn.disabled = true;

      for (const el of cancelEls) {
        if (el instanceof HTMLButtonElement) {
          el.disabled = false;
          el.textContent = cancelLabel;
        }
      }

      feedbackEl.textContent = '';
      inFlight = false;
      onConfirmCurrent = typeof opts.onConfirm === 'function' ? opts.onConfirm : null;

      renderParams(opts.params);

      if (countdownSeconds > 0) {
        countdownLeft = countdownSeconds;
        updateCountdownUi();
        const startedAt = Date.now();
        countdownTimer = setInterval(() => {
          const elapsed = (Date.now() - startedAt) / 1000;
          countdownLeft = Math.max(0, countdownSeconds - elapsed);
          updateCountdownUi();
          updateConfirmDisabled();
          if (countdownLeft <= 0) {
            stopCountdown();
            updateConfirmDisabled();
          }
        }, 200);
      }

      setHidden(false);
      updateConfirmDisabled();

      return new Promise((resolve) => {
        resolveCurrent = resolve;
      });
    }

    confirmBtn.addEventListener('click', handleConfirmClick);
    inputEl.addEventListener('input', updateConfirmDisabled);

    for (const el of cancelEls) {
      el.addEventListener('click', (event) => {
        if (inFlight) {
          if (event && typeof event.preventDefault === 'function') event.preventDefault();
          warnBusy();
          return;
        }
        closeWith(false);
      });
    }

    window.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (root.hidden) return;
      if (inFlight) {
        warnBusy();
        return;
      }
      closeWith(false);
    });

    const api = window.masterDangerConfirm && typeof window.masterDangerConfirm === 'object' ? window.masterDangerConfirm : {};
    api.open = open;
    api.close = requestClose;
    window.masterDangerConfirm = api;
  })();
</script>
