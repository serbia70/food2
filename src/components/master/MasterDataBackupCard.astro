    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .backup-card-data {
    border-left: 4px solid #2563eb;
  }

  .backup-head {
    margin-bottom: 14px;
  }

  .backup-title {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
  }

  .backup-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #64748b;
  }

  .backup-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .backup-panel {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }

  .backup-panel-danger {
    background: #fff7ed;
    border-color: #fdba74;
  }

  .panel-title {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }

  .panel-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #64748b;
  }

  .panel-text-danger {
    color: #b45309;
  }

  .restore-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .backup-button {
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    font-weight: 800;
    cursor: pointer;
  }

  .backup-button-primary {
    background: #2563eb;
    color: #fff;
  }

  .backup-button-danger {
    background: #c2410c;
    color: #fff;
  }

  .backup-feedback {
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
  }

  .backup-feedback-muted {
    background: #f8fafc;
    color: #64748b;
  }

  @media (max-width: 860px) {
    .backup-grid,
    .restore-row {
      grid-template-columns: 1fr;
    }
  }
</style>
