---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['footer'] };
---

<section class="settings-card settings-card-footer">
  <div class="settings-head">
    <div>
      <div class="settings-title">页脚与联系设置</div>
      <div class="settings-subtitle">统一管理全站页脚文案、联系电话与版权信息。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterFooterSettings ? window.submitMasterFooterSettings(this) : false;">
    <label>
      <span>页脚文案</span>
      <input name="footerText" type="text" value={settings.footerText} placeholder="例如：营业时间以门店实际接单为准" />
    </label>
    <label>
      <span>联系电话</span>
      <input name="footerPhone" type="text" value={settings.footerPhone} placeholder="例如：+381 60 000 0000" />
    </label>
    <label class="settings-span-2">
      <span>版权信息</span>
      <input name="footerCopyright" type="text" value={settings.footerCopyright} placeholder="例如：© Serbia70 2026" />
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存页脚设置</button>
      <div id="master-footer-settings-feedback" class="settings-feedback">独立保存页脚信息，避免和其他系统配置互相影响。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #0f766e;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head {
    margin-bottom: 14px;
  }

  .settings-title {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
  }

  .settings-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #64748b;
  }

  .settings-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .settings-form label {
    display: grid;
    gap: 6px;
  }

  .settings-form span {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
  }

  .settings-form input,
  .settings-form select,
  .settings-form textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
    background: #fff;
  }

  .settings-span-2 {
    grid-column: 1 / -1;
  }

  .settings-actions {
    grid-column: 1 / -1;
    display: grid;
    gap: 8px;
  }

  .settings-submit {
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    background: #0f766e;
    color: #fff;
    font-weight: 800;
    cursor: pointer;
  }

  .settings-feedback {
    font-size: 12px;
    color: #64748b;
  }

  @media (max-width: 860px) {
    .settings-form {
      grid-template-columns: 1fr;
    }

    .settings-span-2 {
      grid-column: auto;
    }
  }
</style>
