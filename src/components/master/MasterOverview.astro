---
interface Props {
  totalShops: number;
  todayRevenue: number;
  todayOrders: number;
  monthCommission: number;
  totalBalance: number;
}

const {
  totalShops = 0,
  todayRevenue = 0,
  todayOrders = 0,
  monthCommission = 0,
  totalBalance = 0,
} = Astro.props as Props;

const cards = [
  { label: '店铺总数', value: totalShops, unit: '家', tone: '#2563eb', bg: '#eff6ff' },
  { label: '今日营业额', value: todayRevenue, unit: 'RSD', tone: '#dc2626', bg: '#fff1f2' },
  { label: '今日订单数', value: todayOrders, unit: '单', tone: '#0f766e', bg: '#ecfeff' },
  { label: '本月总提成', value: monthCommission, unit: 'RSD', tone: '#7c3aed', bg: '#f5f3ff' },
  { label: '账户总余额', value: totalBalance, unit: 'RSD', tone: '#15803d', bg: '#f0fdf4' },
];
---

<section class="master-overview">
  {cards.map((card) => (
    <div class="overview-card" style={`--card-tone:${card.tone};--card-bg:${card.bg};`}>
      <div class="overview-label">{card.label}</div>
      <div class="overview-value">{card.value.toLocaleString('zh-CN')}</div>
      <div class="overview-unit">{card.unit}</div>
    </div>
  ))}
</section>

<style>
  .master-overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }

  .overview-card {
    background: var(--card-bg);
    border: 1px solid color-mix(in srgb, var(--card-tone) 18%, #ffffff);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .overview-label {
    color: #64748b;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .overview-value {
    color: var(--card-tone);
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
  }

  .overview-unit {
    margin-top: 8px;
    color: #475569;
    font-size: 12px;
  }
</style>
