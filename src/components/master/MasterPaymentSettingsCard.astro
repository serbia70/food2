---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['wechat'] };
---

<section class="settings-card settings-card-payment">
  <div class="settings-head">
    <div>
      <div class="settings-title">收款码设置</div>
      <div class="settings-subtitle">配置商家续费页面展示的支付宝和微信收款码。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterPaymentSettings ? window.submitMasterPaymentSettings(this) : false;">
    <label>
      <span>支付宝收款码 URL</span>
      <div class="upload-row">
        <input name="alipayPaymentQr" type="text" value={settings.alipayPaymentQr} placeholder="/uploads/alipay.jpg 或 https://..." />
        <button type="button" class="upload-btn" onclick="window.triggerMasterUpload ? window.triggerMasterUpload('alipayPaymentQr') : null">上传</button>
      </div>
    </label>
    <label>
      <span>微信收款码 URL</span>
      <div class="upload-row">
        <input name="wechatPaymentQr" type="text" value={settings.wechatPaymentQr} placeholder="/uploads/wechat.jpg 或 https://..." />
        <button type="button" class="upload-btn" onclick="window.triggerMasterUpload ? window.triggerMasterUpload('wechatPaymentQr') : null">上传</button>
      </div>
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存收款码设置</button>
      <div id="master-payment-settings-feedback" class="settings-feedback">上传成功后会自动回填 URL，再单独点击保存写入系统设置。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #ea580c;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head { margin-bottom: 14px; }
  .settings-title { font-size: 20px; font-weight: 900; color: #0f172a; }
  .settings-subtitle { margin-top: 4px; font-size: 13px; color: #64748b; }
  .settings-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .settings-form label { display: grid; gap: 6px; }
  .settings-form span { font-size: 12px; font-weight: 700; color: #475569; }
  .upload-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
  .settings-form input { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 14px; background: #fff; }
  .upload-btn { border: 1px solid #cbd5e1; border-radius: 10px; background: #fff7ed; color: #9a3412; padding: 10px 14px; font-weight: 700; cursor: pointer; }
  .settings-actions { grid-column: 1 / -1; display: grid; gap: 8px; }
  .settings-submit { border: none; border-radius: 10px; padding: 12px 16px; background: #ea580c; color: #fff; font-weight: 800; cursor: pointer; }
  .settings-feedback { font-size: 12px; color: #64748b; }

  @media (max-width: 860px) {
    .settings-form { grid-template-columns: 1fr; }
  }
</style>
