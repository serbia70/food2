---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['rate'] };
---

<section class="settings-card settings-card-rate">
  <div class="settings-head">
    <div>
      <div class="settings-title">汇率与费率设置</div>
      <div class="settings-subtitle">控制汇率换算与展示费率参数，影响后台计费和展示逻辑。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterRateSettings ? window.submitMasterRateSettings(this) : false;">
    <label>
      <span>汇率</span>
      <input name="exchangeRate" type="number" step="0.01" value={settings.exchangeRate} />
    </label>
    <label>
      <span>展示最终费率</span>
      <input name="displayFinalRate" type="number" step="0.01" value={settings.displayFinalRate} />
    </label>
    <label>
      <span>基础费率</span>
      <input name="rateBase" type="number" step="0.01" value={settings.rateBase} />
    </label>
    <label>
      <span>费率偏移</span>
      <input name="rateOffset" type="number" step="0.01" value={settings.rateOffset} />
    </label>
    <label>
      <span>费率步进</span>
      <input name="rateStep" type="number" step="0.01" value={settings.rateStep} />
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存汇率与费率</button>
      <div id="master-rate-settings-feedback" class="settings-feedback">提交前会校验数值格式，避免把无效费率写进系统设置。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #1d4ed8;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head { margin-bottom: 14px; }
  .settings-title { font-size: 20px; font-weight: 900; color: #0f172a; }
  .settings-subtitle { margin-top: 4px; font-size: 13px; color: #64748b; }
  .settings-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .settings-form label { display: grid; gap: 6px; }
  .settings-form span { font-size: 12px; font-weight: 700; color: #475569; }
  .settings-form input { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 14px; background: #fff; }
  .settings-actions { grid-column: 1 / -1; display: grid; gap: 8px; }
  .settings-submit { border: none; border-radius: 10px; padding: 12px 16px; background: #1d4ed8; color: #fff; font-weight: 800; cursor: pointer; }
  .settings-feedback { font-size: 12px; color: #64748b; }

  @media (max-width: 860px) {
    .settings-form { grid-template-columns: 1fr; }
  }
</style>
