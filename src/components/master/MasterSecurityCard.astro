---
---

<section class="security-card">
  <div class="security-head">
    <div>
      <div class="security-title">超级密码</div>
      <div class="security-subtitle">修改主控台登录密码。建议修改后立即重新登录验证。</div>
    </div>
  </div>

  <form id="master-security-form" class="security-form" onsubmit="return window.submitMasterSecuritySettings ? window.submitMasterSecuritySettings(this) : false;">
    <label>
      <span>新密码</span>
      <input name="password" type="password" placeholder="输入新密码" required />
    </label>
    <label>
      <span>确认密码</span>
      <input name="confirmPassword" type="password" placeholder="再次输入新密码" required />
    </label>

    <div class="security-actions">
      <button type="submit" class="security-submit">保存超级密码</button>
      <div id="master-security-feedback" class="security-feedback">密码修改是高风险动作，会在提交前做前端校验。</div>
    </div>
  </form>
</section>

<style>
  .security-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #dc2626;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .security-head {
    margin-bottom: 14px;
  }

  .security-title {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
  }

  .security-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #64748b;
  }

  .security-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .security-form label {
    display: grid;
    gap: 6px;
  }

  .security-form span {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
  }

  .security-form input {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
    background: #fff;
  }

  .security-actions {
    grid-column: 1 / -1;
    display: grid;
    gap: 8px;
  }

  .security-submit {
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    background: #dc2626;
    color: #fff;
    font-weight: 800;
    cursor: pointer;
  }

  .security-feedback {
    font-size: 12px;
    color: #64748b;
  }

  @media (max-width: 860px) {
    .security-form {
      grid-template-columns: 1fr;
    }
  }
</style>
