---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['server'] };
---

<section class="settings-card settings-card-server">
  <div class="settings-head">
    <div>
      <div class="settings-title">MQTT / Telegram 配置</div>
      <div class="settings-subtitle">修改后会影响商家打印、消息链路和 Telegram 绑定回调，请仅填写已确认生效的配置。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterServerSettings ? window.submitMasterServerSettings(this) : false;">
    <label class="settings-span-2">
      <span>MQTT 服务器地址</span>
      <input name="mqttBroker" type="text" value={settings.mqttBroker} placeholder="例如：mqtt.serbia70.com" />
    </label>

    <label class="settings-span-2">
      <span>Telegram Webhook Secret</span>
      <input name="telegramWebhookSecret" type="text" value={settings.telegramWebhookSecret} placeholder="例如：telegram-webhook-secret" />
    </label>

    <label class="settings-span-2">
      <span>Telegram Chat ID</span>
      <input name="telegramChatId" type="text" value={settings.telegramChatId} placeholder="例如：123456789 或 -1001234567890" />
    </label>

    <label class="settings-span-2">
      <span>Telegram Bot Token</span>
      <input name="telegramBotToken" type="text" value={settings.telegramBotToken} placeholder="例如：123456:AA..." />
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存 MQTT / Telegram 配置</button>
      <button
        type="button"
        class="settings-secondary"
        data-master-telegram-test-button
        onclick="return window.submitMasterServerTelegramTest ? window.submitMasterServerTelegramTest(this.form) : false;"
      >
        发送测试信息
      </button>
      <div id="master-server-settings-feedback" class="settings-feedback">修改后请同步确认客户端、打印机和 Telegram 机器人回调配置是否仍然可用。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #dc2626;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head { margin-bottom: 14px; }
  .settings-title { font-size: 20px; font-weight: 900; color: #0f172a; }
  .settings-subtitle { margin-top: 4px; font-size: 13px; color: #64748b; }
  .settings-form { display: grid; gap: 14px; }
  .settings-form label { display: grid; gap: 6px; }
  .settings-form span { font-size: 12px; font-weight: 700; color: #475569; }
  .settings-form input { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 14px; background: #fff; }
  .settings-actions { display: grid; gap: 8px; }
  .settings-submit { border: none; border-radius: 10px; padding: 12px 16px; background: #dc2626; color: #fff; font-weight: 800; cursor: pointer; }
  .settings-secondary { border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px 16px; background: #fff; color: #0f172a; font-weight: 800; cursor: pointer; }
  .settings-feedback { font-size: 12px; color: #64748b; }
</style>
