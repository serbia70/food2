---
import type { MasterSettingsView } from '../../lib/master-settings-view';

const { settings } = Astro.props as { settings: MasterSettingsView['shopDefaults'] };
---

<section class="settings-card settings-card-shop-defaults">
  <div class="settings-head">
    <div>
      <div class="settings-title">店铺默认城市与营业时间</div>
      <div class="settings-subtitle">为新店铺预填默认城市与营业时段，减少重复配置。</div>
    </div>
  </div>

  <form class="settings-form" onsubmit="return window.submitMasterShopDefaultsSettings ? window.submitMasterShopDefaultsSettings(this) : false;">
    <label>
      <span>默认城市</span>
      <input name="defaultCity" type="text" value={settings.city} placeholder="例如：Beograd" />
    </label>
    <label>
      <span>默认开始营业</span>
      <input name="defaultOpenTime" type="time" value={settings.hours.open} />
    </label>
    <label>
      <span>默认结束营业</span>
      <input name="defaultCloseTime" type="time" value={settings.hours.close} />
    </label>

    <div class="settings-actions">
      <button type="submit" class="settings-submit">保存默认设置</button>
      <div id="master-shop-defaults-settings-feedback" class="settings-feedback">仅影响店铺默认值，不会覆盖已配置店铺。</div>
    </div>
  </form>
</section>

<style>
  .settings-card {
    background: #fff;
    border: 1px solid #d7dee7;
    border-left: 4px solid #0ea5e9;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05);
  }

  .settings-head {
    margin-bottom: 14px;
  }

  .settings-title {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
  }

  .settings-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #64748b;
  }

  .settings-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .settings-form label {
    display: grid;
    gap: 6px;
  }

  .settings-form span {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
  }

  .settings-form input {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
    background: #fff;
  }

  .settings-actions {
    grid-column: 1 / -1;
    display: grid;
    gap: 8px;
  }

  .settings-submit {
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    background: #0ea5e9;
    color: #fff;
    font-weight: 800;
    cursor: pointer;
  }

  .settings-feedback {
    font-size: 12px;
    color: #64748b;
  }

  @media (max-width: 860px) {
    .settings-form {
      grid-template-columns: 1fr;
    }
  }
</style>
