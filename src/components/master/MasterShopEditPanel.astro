---
---

<div id="master-shop-edit-panel" class="side-shell" hidden>
  <div class="side-backdrop" data-close-shop-edit></div>
  <aside class="side-panel">
    <div class="side-head">
      <div>
        <div class="side-title">编辑店铺</div>
        <div class="side-subtitle">修改基础信息与预订 / 外卖提成</div>
      </div>
      <button type="button" class="side-close" data-close-shop-edit>×</button>
    </div>

    <form id="master-shop-edit-form" class="side-form" onsubmit="return window.submitMasterShopEdit ? window.submitMasterShopEdit(this) : false;">
      <input type="hidden" name="id" />
      <input type="hidden" name="commissionMode" value="override" />
      <input type="hidden" name="enableDineIn" />

      <div class="form-section-title">基础信息</div>
      <label><span>店铺名称</span><input name="name" type="text" required /></label>
      <label><span>Slug</span><input name="slug" type="text" required /></label>
      <label><span>登录密码</span><input name="password" type="text" placeholder="留空表示不修改" /></label>
      <label>
        <span>状态</span>
        <select name="status">
          <option value="active">营业中</option>
          <option value="disabled">已停用</option>
          <option value="expired">已过期</option>
        </select>
      </label>

      <div class="form-section-title">提成设置</div>
      <section class="fee-section">
        <div class="fee-section-head">
          <div class="fee-section-title">预订</div>
          <div class="fee-section-note">覆盖全局默认预订技术服务费</div>
        </div>
        <label>
          <span>启用</span>
          <select name="reservationEnabled">
            <option value="1">开启</option>
            <option value="0">关闭</option>
          </select>
        </label>
        <label>
          <span>提成类型</span>
          <select name="reservationCommissionType">
            <option value="percentage">按百分比</option>
            <option value="per_order">按单固定额</option>
          </select>
        </label>
        <label><span>提成数值</span><input name="reservationCommissionValue" type="number" min="0" step="0.1" /></label>
      </section>

      <section class="fee-section">
        <div class="fee-section-head">
          <div class="fee-section-title">外卖</div>
          <div class="fee-section-note">覆盖全局默认外卖技术服务费</div>
        </div>
        <label>
          <span>启用</span>
          <select name="deliveryEnabled">
            <option value="1">开启</option>
            <option value="0">关闭</option>
          </select>
        </label>
        <label>
          <span>提成类型</span>
          <select name="deliveryCommissionType">
            <option value="percentage">按百分比</option>
            <option value="per_order">按单固定额</option>
          </select>
        </label>
        <label><span>提成数值</span><input name="deliveryCommissionValue" type="number" min="0" step="0.1" /></label>
      </section>

      <div class="side-feedback">这里只修改未来订单的提成计算规则，不会改变历史累计金额。</div>

      <div class="side-actions">
        <button type="button" class="side-secondary" data-reset-shop-fee-defaults onclick="return window.resetMasterShopFeeDefaults ? window.resetMasterShopFeeDefaults(document.getElementById('master-shop-edit-form')) : false;">恢复全局默认</button>
        <button type="submit" class="side-submit">保存店铺修改</button>
        <div id="master-shop-edit-feedback" class="side-feedback">保存后建议刷新当前列表确认结果。</div>
      </div>
    </form>
  </aside>
</div>

<style>
  .side-shell[hidden] { display: none; }
  .side-shell { position: fixed; inset: 0; z-index: 95; }
  .side-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.42); }
  .side-panel { position: absolute; top: 0; right: 0; width: min(520px, 100%); height: 100%; background: #fff; box-shadow: -18px 0 50px rgba(15, 23, 42, 0.16); display: flex; flex-direction: column; }
  .side-head { padding: 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; gap: 12px; }
  .side-title { font-size: 22px; font-weight: 900; color: #0f172a; }
  .side-subtitle { margin-top: 4px; color: #64748b; font-size: 13px; }
  .side-close { border: none; background: #f8fafc; color: #334155; width: 36px; height: 36px; border-radius: 10px; cursor: pointer; font-size: 22px; }
  .side-form { padding: 18px 20px 28px; overflow-y: auto; display: grid; gap: 12px; }
  .side-form label { display: grid; gap: 6px; }
  .side-form span { font-size: 12px; font-weight: 700; color: #475569; }
  .side-form input, .side-form select { width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 14px; background: #fff; }
  .form-section-title { margin-top: 8px; font-size: 13px; font-weight: 900; color: #0f172a; }
  .fee-section { display: grid; gap: 12px; padding: 14px; border: 1px solid #e2e8f0; border-radius: 14px; background: #f8fafc; }
  .fee-section-head { display: grid; gap: 4px; }
  .fee-section-title { font-size: 15px; font-weight: 900; color: #0f172a; }
  .fee-section-note { font-size: 12px; color: #64748b; }
  .side-actions { margin-top: 6px; display: grid; gap: 8px; }
  .side-submit { border: none; background: #111827; color: #fff; padding: 12px 14px; border-radius: 12px; cursor: pointer; font-weight: 800; }
  .side-secondary { border: 1px solid #cbd5e1; background: #fff; color: #334155; padding: 12px 14px; border-radius: 12px; cursor: pointer; font-weight: 800; }
  .side-feedback { font-size: 12px; color: #64748b; }
</style>
