---
import '../styles/global.css';
import compat from '../scripts/compat.js?raw';
interface Props {
  title: string;
  manifest?: string;
  themeColor?: string;
  serviceWorker?: string;
  serviceWorkerScope?: string;
}

const {
  title,
  manifest,
  themeColor = '#0f172a',
  serviceWorker,
  serviceWorkerScope = '/',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <script is:inline set:html={compat}></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="description" content="MeituanGo - 在线点餐系统" />
  {manifest ? <meta name="theme-color" content={themeColor} /> : null}
  {manifest ? <meta name="apple-mobile-web-app-capable" content="yes" /> : null}
  {manifest ? <meta name="apple-mobile-web-app-title" content={title} /> : null}
  <title>{title}</title>
  {manifest ? <link rel="manifest" href={manifest} /> : null}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style is:global>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f5f5f5;
      color: #333;
      height: 100vh;
      overflow: hidden;
    }
    /* 全局样式 */
    :root {
      --primary: #ffd101;
      --primary-dark: #e6bc00;
      --success: #52c41a;
      --danger: #ff4d4f;
      --warning: #faad14;
      --info: #1890ff;
    }
  </style>
</head>
<body>
  <slot />
  {
    serviceWorker ? (
      <script define:vars={{ serviceWorker, serviceWorkerScope }} is:inline>
        var ios12 = /iP(?:hone|ad|od).*OS 12_/.test(navigator.userAgent) || /CPU OS 12_/.test(navigator.userAgent);
        if (!ios12 && 'serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register(serviceWorker, { scope: serviceWorkerScope }).catch(function () {});
          });
        }
      </script>
    ) : null
  }
</body>
</html>
