---
import Layout from '../../layouts/Layout.astro';
import MenuList from '../../components/MenuList';
import Sidebar from '../../components/Sidebar';
import CartModal from '../../components/CartModal';
import UserModal from '../../components/UserModal';
import ReservationModal from '../../components/ReservationModal';
import ShopChatModal from '../../components/ShopChatModal';
import TablePageEntryIsland from '../../components/shop/TablePageEntryIsland.tsx';
import { API_BASE_URL } from '../../config';
import { classifyShopResponseStatus } from '../../lib/shop-status';
import { shouldRetryStream } from '../../lib/stream-retry';
import {
  buildTableButtonLabel,
  buildTableValue,
  isHallLikeZoneName,
  isPlaceholderZoneName,
  isSimpleHallMode,
} from '../../lib/table-config';
import { buildTableLookupKeys } from '../../scripts/shop/table-utils';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });
const safeSlug = encodeURIComponent(slug);

if (slug === 'admin') {
  const q = Astro.url.search || '';
  return Astro.redirect(`/admin${q}`, 302);
}

const parseJSON = <T = any>(raw: any, fallback: T): T => {
  try {
    if (typeof raw !== 'string' || raw.trim() === '') return fallback;
    return JSON.parse(raw) as T;
  } catch {
    return fallback;
  }
};

let shopRes: Response;
let menuRes: Response;
try {
  [shopRes, menuRes] = await Promise.all([
    fetch(`${API_BASE_URL}/${encodeURIComponent(slug)}/info`),
    fetch(`${API_BASE_URL}/${encodeURIComponent(slug)}/menu`),
  ]);
} catch {
  return new Response('Upstream unavailable', { status: 503 });
}

if (!shopRes.ok) {
  const status = classifyShopResponseStatus(shopRes.status);
  const message = status === 404 ? 'Not Found' : 'Upstream shop unavailable';
  return new Response(message, { status });
}

let shop: any;
try {
  shop = await shopRes.json();
} catch {
  return new Response('Invalid upstream response', { status: 502 });
}
const settings = parseJSON<any>(shop?.settings, {});
const menuLayout = settings?.menu_layout || 'image-2col';
const isMenuTextMode = settings?.menu_text_mode === true || menuLayout.startsWith('text'); // Check text mode setting


let rawMenu: any[] = [];
if (menuRes.ok) {
  try {
    const parsed = await menuRes.json();
    rawMenu = Array.isArray(parsed) ? parsed : [];
  } catch {
    rawMenu = [];
  }
}

const activeMenu = (Array.isArray(rawMenu) ? rawMenu : [])
  .map((cat: any) => ({
    id: `cat_${cat?.id}`,
    name: cat?.name || '未分类',
    subName: cat?.sub_name || '',
    products: (cat?.products || []).map((p: any) => ({
      ...p,
      subName: p?.sub_name || '',
      img: p?.img || '/favicon.svg',
    })),
  }))
  .filter((cat: any) => Array.isArray(cat.products) && cat.products.length > 0);


// Keep masterSettings for compatibility, but do not depend on master auth in public pages.
let masterSettings: any = {};

// Public master settings (no auth) for footer/contact display.
// Ensures the shop page footer matches `/master?tab=settings` without requiring a master token.
let publicMasterSettings: any = {};
try {
  const homeRes = await fetch(`${API_BASE_URL}/api/home`);
  if (homeRes.ok) {
    const d = await homeRes.json();
    publicMasterSettings = d?.settings || {};
  }
} catch {}

const footerPhone =
  publicMasterSettings.footer_phone || publicMasterSettings.footerPhone || masterSettings.footer_phone || '000000000';
const footerCopyright =
  publicMasterSettings.footer_copyright || publicMasterSettings.footerCopyright || masterSettings.footer_copyright || '© Fast Food';
const footerText =
  publicMasterSettings.footer_text || publicMasterSettings.footerText || masterSettings.footer_text || '订餐热线';
const mqttBroker = String(settings?.mqtt_broker || masterSettings?.mqtt_broker || 'mqtt.serbia70.com');
const mqttSecret = String(shop?.mqtt_secret || '');
const shopId = Number(shop?.id || 0);
const mqttUsername = String(settings?.mqtt_username || masterSettings?.mqtt_username || '');
const mqttPassword = String(settings?.mqtt_password || masterSettings?.mqtt_password || '');

const phone = settings?.contact?.phone || settings?.phone || shop?.phone || '0613083899';
const addressForMap = String(settings?.contact?.address || settings?.address || shop?.address || shop?.zone || shop?.name || slug || '').trim();
const mapUrl = String(settings?.contact?.map_url || settings?.map_url || (addressForMap ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressForMap)}` : '')).trim();

const today = new Date();
today.setHours(0, 0, 0, 0);

let isDineInExpired = false;
if (shop?.expire_date) {
  const expireDate = new Date(shop.expire_date);
  expireDate.setHours(0, 0, 0, 0);
  if (expireDate < today) isDineInExpired = true;
}

let isDeliveryLocked = Boolean(shop?.delivery_locked);
const deliveryLockReason = String(
  shop?.delivery_lock_reason ||
    '余额不足，请先充值后使用外卖 / Insufficient wallet balance, please top up first',
);

const tableNum = Astro.url.searchParams.get('table');
const mode = Astro.url.searchParams.get('mode');
const isAdmin = Astro.url.searchParams.get('isAdmin') === 'true';

let isTableLocked = false;
if (tableNum) {
  try {
    const tableRes = await fetch(
      `${API_BASE_URL}/api/order/by_table?slug=${encodeURIComponent(slug)}&table=${encodeURIComponent(tableNum)}`,
    );
    if (tableRes.ok) {
      const data = await tableRes.json();
      const orders = Array.isArray(data?.orders) ? data.orders : [];
      const hasActive = orders.some((o: any) => !['completed', 'cancelled', 'archived', 'review_needed'].includes(o?.status));
      if (hasActive && !isAdmin) isTableLocked = true;
    }
  } catch {}
}

let tableConfig: Array<{ name: string; count: number; prefix?: string }> = [];

const normalizeZones = (raw: any): Array<{ name: string; count: number; prefix?: string }> => {
  if (typeof raw === 'string') {
    const parsed = parseJSON<any>(raw, null);
    return normalizeZones(parsed);
  }
  let zones: any[] = [];
  if (Array.isArray(raw)) zones = raw;
  else if (raw && Array.isArray(raw.zones)) zones = raw.zones;

  return zones
    .map((z: any) => {
      const name = String(z?.name || '').trim();
      const count = Math.max(0, Number(z?.count || 0));
      const prefix = String(z?.prefix ?? '').trim();
      return { name, count, prefix };
    })
    .filter((z) => z.count > 0);
};

try {
  const parsedTableConfig = parseJSON<any>(shop?.table_config, null);
  tableConfig = normalizeZones(parsedTableConfig);
  if (tableConfig.length === 0) {
    tableConfig = normalizeZones(settings?.table_config);
  }
} catch {}

if (tableConfig.length === 0) {
  const fallbackTables = normalizeZones(settings?.tables);
  const fallback = fallbackTables.length > 0 ? fallbackTables : [{ name: 'Main Hall / 大厅', count: 10, prefix: '' }];
  tableConfig = normalizeZones(fallback);
}

if (tableConfig.length === 1) {
  const z = tableConfig[0];
  const name = String(z?.name || '').trim();
  const prefix = String(z?.prefix || '').trim();
  const isPlaceholder = /^区域\d+$/u.test(name);
  const isHallLike = /^(大厅|大堂|hall|main hall)$/iu.test(name);
  const isPrefixPlaceholder = /^区域\d+$/u.test(prefix);
  const isPrefixHallLike = /^(大厅|大堂|hall|main hall)$/iu.test(prefix);

  if ((isPlaceholder || isHallLike || !name) && (prefix === name || isPrefixPlaceholder || isPrefixHallLike)) {
    z.prefix = '';
  }
  if (isPlaceholder) {
    z.name = '大厅';
  }
}

const simpleHallMode = isSimpleHallMode(tableConfig);

const buildTableDisplay = (zone: { name?: string; prefix?: string; count?: number }, index: number) => {
  const count = Math.max(0, Number(zone?.count || 0));
  const label = buildTableButtonLabel(zone, index, simpleHallMode);
  if (count <= 1 && label !== String(index)) {
    return { text: label, unit: '包间 / Sala' };
  }
  return { text: label, unit: '号桌 / Sto' };
};

const tableZones = tableConfig.map((zone) => {
  const total = Math.max(0, Number(zone.count || 0));
  const tables = Array.from({ length: total }).map((_, i) => {
    const n = i + 1;
    const display = buildTableDisplay(zone, n);
    return {
      display: display.text,
      unitLabel: display.unit,
      value: buildTableValue(zone, n, simpleHallMode),
    };
  });
  return {
    name: zone.name || '大厅',
    tables,
  };
});


const parseDbTimeMs = (v: any) => {
  if (!v) return 0;
  const raw = String(v).trim();
  if (!raw) return 0;
  const iso = raw.includes('T') ? raw : raw.replace(' ', 'T');
  const d1 = new Date(iso.endsWith('Z') ? iso : `${iso}Z`);
  if (!Number.isNaN(d1.getTime())) return d1.getTime();
  const d2 = new Date(iso);
  if (!Number.isNaN(d2.getTime())) return d2.getTime();
  return 0;
};

const belgradeTimeOptions = {
  timeZone: 'Europe/Belgrade',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
};
const belgradeTime = new Intl.DateTimeFormat('sr-RS', belgradeTimeOptions);

const endedOrderStatusList = ['completed', 'cancelled', 'archived', 'paid'];
const endedOrderStatus = new Set(endedOrderStatusList);
const tableStatusMap: Record<string, { occupied: boolean; total: number; orderTime: string; activeCount: number }> = {};

const allTables = tableZones.flatMap((z) => z.tables.map((t) => t.value));
if (allTables.length > 0) {
  await Promise.all(
    allTables.map(async (tableValue) => {
      const keys = buildTableLookupKeys(tableValue);

      const merged = new Map<number, any>();
      for (const key of keys) {
        try {
          const r = await fetch(
            `${API_BASE_URL}/api/order/by_table?slug=${encodeURIComponent(slug)}&table=${encodeURIComponent(key)}`,
          );
          if (!r.ok) continue;
          const d = await r.json();
          const orders = Array.isArray(d?.orders) ? d.orders : [];
          for (const o of orders) {
            const id = Number(o?.id || 0);
            if (id > 0) merged.set(id, o);
          }
        } catch {}
      }

      const active = Array.from(merged.values()).filter(
        (o: any) => !endedOrderStatus.has(String(o?.status || '').toLowerCase()),
      );

      if (active.length === 0) {
        tableStatusMap[tableValue] = {
          occupied: false,
          total: 0,
          orderTime: '--:--',
          activeCount: 0,
        };
        return;
      }

      const total = active.reduce((sum: number, o: any) => sum + Number(o?.total_amount || 0), 0);
      const firstOrder = [...active].sort((a: any, b: any) => parseDbTimeMs(a?.created_at) - parseDbTimeMs(b?.created_at))[0];
      const firstMs = parseDbTimeMs(firstOrder?.created_at);
      const orderTime = firstMs ? belgradeTime.format(new Date(firstMs)) : '--:--';

      tableStatusMap[tableValue] = {
        occupied: true,
        total,
        orderTime,
        activeCount: active.length,
      };
    }),
  );
}

let ogImage = shop?.logo || `https://ui-avatars.com/api/?name=${encodeURIComponent(shop?.name || slug)}&background=f0f2f5&color=333&size=600&font-size=0.33&length=2&bold=true`;
if (String(ogImage).startsWith('/')) ogImage = `${Astro.url.origin}${ogImage}`;

const showClosedPage = false;
const enableDelivery = Number(shop?.enable_delivery ?? 1) !== 0;
const enableDineIn = Number(shop?.enable_dine_in ?? 1) !== 0;
const billingPlanType = String(shop?.billing_plan_type || 'subscription').toLowerCase();
const enableReservation = (billingPlanType === 'subscription' || billingPlanType === 'business') && Number(shop?.enable_reservation ?? 1) !== 0;
---

{showClosedPage ? (
  <Layout
    title="店铺打烊中"
    manifest={`/${safeSlug}/manifest.webmanifest`}
    serviceWorker="/shop-sw.js"
    serviceWorkerScope={`/${safeSlug}`}
    themeColor="#1e8f44"
  >
    <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; text-align:center; padding:20px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div style="background:white; padding:40px; border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,0.3); max-width:400px;">
        <div style="font-size:80px; margin-bottom:20px;">🌙</div>
        <h1 style="color:#4a5568; margin:0 0 10px; font-size:28px;">店铺打烊中</h1>
        <p style="color:#718096; line-height:1.8; font-size:14px;">本店服务已到期，请商家联系管理员续费。</p>
        <div style="margin-top:25px; padding:15px; background:#f7fafc; border-radius:10px;">
          <div style="font-weight:bold; color:#2d3748;">{shop?.name || slug}</div>
        </div>
      </div>
    </div>
  </Layout>
) : (
  <Layout
    title={shop?.name || slug}
    manifest={`/${safeSlug}/manifest.webmanifest`}
    serviceWorker="/shop-sw.js"
    serviceWorkerScope={`/${safeSlug}`}
    themeColor="#1e8f44"
  >
    {!tableNum && mode === 'tables' ? (
      <div style="position:fixed; top:0; left:0; right:0; bottom:0; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); z-index:1000; display:flex; flex-direction:column; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <div style="background:rgba(255,255,255,0.95); padding:20px 25px; border-bottom:1px solid rgba(0,0,0,0.1); display:flex; justify-content:space-between; align-items:center; box-shadow:0 4px 20px rgba(0,0,0,0.15); backdrop-filter:blur(10px);">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:45px; height:45px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:24px;">🪑</div>
            <div>
              <h2 style="margin:0; font-size:22px; font-weight:700; color:#2d3748; letter-spacing:-0.5px;">选择桌号</h2>
              <p style="margin:0; font-size:13px; color:#718096;">Izaberite sto za poručivanje</p>
            </div>
          </div>
          <div style="display:flex; gap:10px;">
            {enableReservation && (
              <button onclick="openReservationModal()" style="background:linear-gradient(135deg, #26a69a 0%, #00897b 100%); border:none; border-radius:10px; padding:12px 20px; font-size:16px; cursor:pointer; color:white; box-shadow:0 4px 15px rgba(38,166,154,0.4); display:flex; align-items:center; gap:6px; font-weight:700;">
                <span style="font-size:20px;">📅</span>
                <span style="font-size:16px;">预订 / Rezervacija</span>
              </button>
            )}
            <button onclick="goToDeliveryMode()" style="background:linear-gradient(135deg, #ff9800 0%, #f57c00 100%); border:none; border-radius:10px; padding:12px 20px; font-size:16px; cursor:pointer; color:white; box-shadow:0 4px 15px rgba(255,152,0,0.4); display:flex; align-items:center; gap:6px; font-weight:700;">
              <span style="font-size:20px;">🛵</span>
              <span style="font-size:16px;">外卖</span>
            </button>
          </div>
        </div>

        <div style="flex:1; overflow-y:auto; padding:25px;">
          {tableZones.map((zone) => (
            <div style="margin-bottom:35px; background:rgba(255,255,255,0.95); border-radius:20px; padding:25px; box-shadow:0 10px 40px rgba(0,0,0,0.2);">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; padding:15px 20px; background:linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.2);">
                <span style="font-size:28px;">🏛️</span>
                <div>
                  <h3 style="font-size:20px; font-weight:700; color:#fff; margin:0; letter-spacing:1px;">{zone.name}</h3>
                  <p style="font-size:13px; color:#fff; margin:4px 0 0; opacity:0.9;">Zone</p>
                </div>
              </div>

              <div class="table-grid-three">
                {zone.tables.map((table) => {
                  const status = tableStatusMap[table.value] || {
                    occupied: false,
                    total: 0,
                    orderTime: '--:--',
                    activeCount: 0,
                  };

                  return (
                    <div class={`table-card-status ${status.occupied ? 'is-occupied' : 'is-idle'}`} data-table={table.value}>
                      <div style="font-size:32px; font-weight:800; color:#2d3748; margin-bottom:8px;">{table.display}</div>
                      <div style="font-size:14px; color:#718096; font-weight:500; margin-bottom:8px;">{table.unitLabel}</div>
                      <div class={`table-state-badge ${status.occupied ? 'occupied' : 'idle'}`}>
                        {status.occupied ? '用餐中 / U toku' : '空闲 / Slobodan'}
                      </div>

                      {status.occupied ? (
                        <>
                          <div class="table-meta-row">点餐时间 / Vreme: {status.orderTime}</div>
                          <div class="table-meta-row amount">金额 / Iznos: {status.total} RSD</div>
                        </>
                      ) : (
                        <div class="table-meta-row">当前可点餐 / Spremno za porudžbinu</div>
                      )}

                      <div class="table-actions-row">
                        <button type="button" class="table-action-btn primary" onclick={`window.openTableOrder(${JSON.stringify(table.value)})`}>
                          点餐 / Poruci
                        </button>
                        {status.occupied && (
                          <>
                            <button type="button" class="table-action-btn warning" onclick={`window.openTableAdd(${JSON.stringify(table.value)})`}>
                              加餐 / Dodaj
                            </button>
                            <button
                              type="button"
                              class="table-action-btn info"
                              onclick={`window.openTableDetails(${JSON.stringify(table.value)}, ${JSON.stringify(table.display)})`}
                            >
                              订单详情 / Detalji
                            </button>
                          </>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <TablePageEntryIsland
          client:load
          slug={String(slug || '')}
          endedStatusList={endedOrderStatusList}
          belgradeTimeOptions={belgradeTimeOptions}
        />

        <div id="table-details-modal" class="table-details-modal" style="display:none;" onclick="if(event.target===this) window.closeTableDetailsModal()">
          <div class="table-details-card">
            <div class="table-details-header">
              <h3 id="table-details-title">订单详情</h3>
              <button type="button" class="table-details-close" onclick="window.closeTableDetailsModal()">×</button>
            </div>
            <div id="table-details-body" class="table-details-body"></div>
            <div id="table-details-total" class="table-details-total"></div>
            <button type="button" class="table-details-ok" onclick="window.closeTableDetailsModal()">确定 / OK</button>
          </div>
        </div>

        <style is:inline>
          .table-grid-three {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            max-width: 1080px;
            margin: 0 auto;
          }
          .table-card-status {
            background: #fff;
            border-radius: 16px;
            padding: 22px 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 2px solid #e2e8f0;
          }
          .table-card-status.is-occupied {
            border-color: #ffcc80;
            background: #fffaf2;
          }
          .table-state-badge {
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
          }
          .table-state-badge.occupied {
            background: #fff3e0;
            color: #ef6c00;
          }
          .table-state-badge.idle {
            background: #edf2f7;
            color: #546e7a;
          }
          .table-meta-row {
            font-size: 13px;
            color: #5f6b7a;
            margin-bottom: 4px;
          }
          .table-meta-row.amount {
            color: #d84315;
            font-weight: 700;
            margin-bottom: 10px;
          }
          .table-actions-row {
            display: flex;
            gap: 8px;
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
          }
          .table-action-btn {
            border: none;
            border-radius: 10px;
            padding: 8px 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            color: #fff;
          }
          .table-action-btn.primary {
            background: linear-gradient(135deg, #4f7efc 0%, #3a67e4 100%);
          }
          .table-action-btn.warning {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
          }
          .table-action-btn.info {
            background: linear-gradient(135deg, #26a69a 0%, #00897b 100%);
          }
          .table-details-modal {
            position: fixed;
            inset: 0;
            background: rgba(18, 24, 38, 0.42);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 14px;
          }
          .table-details-card {
            width: min(720px, 100%);
            max-height: 86vh;
            overflow: auto;
            background: #fff;
            border-radius: 14px;
            border: 1px solid #e6edf5;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.2);
            padding: 14px;
          }
          .table-details-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
          }
          .table-details-header h3 {
            margin: 0;
            color: #1f2d3d;
            font-size: 18px;
          }
          .table-details-close {
            border: none;
            background: #f4f6f8;
            color: #334e68;
            border-radius: 8px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            font-size: 20px;
            line-height: 1;
          }
          .table-details-body {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 10px;
          }
          .table-details-row {
            background: #f8fafc;
            border: 1px solid #e8eef5;
            border-radius: 10px;
            padding: 10px;
            color: #334e68;
            font-size: 13px;
            line-height: 1.5;
            white-space: pre-wrap;
          }
          .table-details-empty {
            color: #718096;
            text-align: center;
            padding: 18px 10px;
          }
          .table-details-total {
            font-weight: 700;
            color: #d84315;
            margin: 10px 0 12px;
            font-size: 16px;
          }
          .table-details-ok {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 11px;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            background: linear-gradient(135deg, #4f7efc 0%, #3a67e4 100%);
          }
          @media (max-width: 1100px) {
            .table-grid-three {
              grid-template-columns: repeat(2, minmax(0, 1fr));
            }
          }
          @media (max-width: 700px) {
            .table-grid-three {
              grid-template-columns: repeat(1, minmax(0, 1fr));
            }
          }
        </style>
      </div>
    ) : (
      <>
        <div id="shop-auth-banner" style="display:none; background: #fff4e5; color: #d48806; padding: 8px 15px; border-bottom: 1px solid #ffe58f; justify-content: space-between; align-items: center; cursor: pointer;" onclick="window.dispatchEvent(new CustomEvent('open-user-modal', {detail: {mode: 'register'}}))">
          <div style="display:flex; align-items:center; gap:8px; font-size:13px;">
            <span>🎁</span>
            <span><b>注册新人礼：</b>Google 一键注册成功即可领券</span>
          </div>
          <span style="font-weight:bold; font-size:12px; border:1px solid #d48806; padding:2px 8px; border-radius:4px;">立即注册</span>
        </div>

        <script is:inline>
          const user = localStorage.getItem('user_info');
          if (!user) {
            const banner = document.getElementById('shop-auth-banner');
            if (banner) banner.style.display = 'flex';
          }
        </script>

        <div class="custom-header">
          <div style="flex:1; overflow:hidden;">
            <div style="display:flex; align-items:center; gap:10px;">
              {shop?.logo && <img src={shop.logo} alt={shop.name} style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:1px solid #eee;" />}
              <div class="shop-name">{shop?.name || slug}</div>
            </div>
            <div class="shop-info">
              <span>🕒 {settings?.hours?.open || '08:00'}-{settings?.hours?.close || '22:00'}</span>
              <a href={`tel:${phone}`} style="margin-left:10px; color:#333; text-decoration:none; font-weight:bold;">📞 {phone}</a>
              {mapUrl && <a href={mapUrl} target="_blank" rel="noopener noreferrer" style="margin-left:10px; color:#1565a8; text-decoration:none; font-weight:bold;">📍 地图 / Mapa</a>}
            </div>
          </div>
        </div>

        <div class="app-container">
          <Sidebar categories={activeMenu} client:load={true} />
          <MenuList
            categories={activeMenu}
            footerPhone={footerPhone}
            footerCopyright={footerCopyright}
            footerText={footerText}
            menuLayout={menuLayout}
            client:load={true}
          />
        </div>

        <CartModal
          restaurantId={slug}
          shopSettings={settings}
          isDeliveryLocked={isDeliveryLocked}
          isTableLocked={isTableLocked}
          enableDelivery={enableDelivery}
          enableDineIn={enableDineIn}
          enableReservation={enableReservation}
          deliveryLockReason={deliveryLockReason}
          isAdmin={isAdmin}
          tableConfig={tableConfig}
          client:load
        />
        <ShopChatModal client:load />
        <UserModal client:load />
      </>
    )}

    {enableReservation && <ReservationModal restaurantId={slug} requiresPreOrder={false} client:load />}
    
    <script src="/vendor/mqttws31.min.js" is:inline></script>
    <script define:vars={{ slug, shopId, mqttSecret, mqttBroker, mqttUsername, mqttPassword }} is:inline>
      (function () {
        if (window.__shopMqttSyncInited) return;
        window.__shopMqttSyncInited = true;

        let reloading = false;
        let stream = null;
        let streamRetryTimer = null;
        let streamRetryStopped = false;

        async function probeStreamAvailability() {
          try {
            const res = await fetch('/api/stream/' + encodeURIComponent(String(slug || '')), {
              method: 'GET',
              headers: { Accept: 'application/json' },
            });
            const contentType = String(res.headers.get('content-type') || '').toLowerCase();
            if (!shouldRetryStream(Number(res.status || 0), contentType)) {
              return false;
            }
          } catch {}
          return true;
        }

        function parseBroker(raw) {
          const v = String(raw || '').trim();
          if (!v) return { host: 'mqtt.serbia70.com', port: 443, path: '/mqtt', useSSL: true };

          if (v.startsWith('ws://') || v.startsWith('wss://')) {
            try {
              const u = new URL(v);
              return {
                host: u.hostname,
                port: Number(u.port || (u.protocol === 'wss:' ? 443 : 80)),
                path: u.pathname || '/mqtt',
                useSSL: u.protocol === 'wss:',
              };
            } catch {}
          }

          if (v.indexOf('serbia70.com') !== -1) {
            return { host: 'mqtt.serbia70.com', port: 443, path: '/mqtt', useSSL: true };
          }

          return { host: v, port: 8083, path: '/mqtt', useSSL: false };
        }

        function shouldReloadByPayload(payload) {
          const evt = String((payload && (payload.event || payload.type)) || '').toLowerCase();
          const hotEvents = new Set([
            'new_order',
            'order',
            'status_update',
            'table_checkout',
            'table_status_sync',
            'remarks_update',
          ]);
          return hotEvents.has(evt);
        }

        function safeReload() {
          const suppressUntil = Number(window.__suppressMqttReloadUntil || 0);
          if (suppressUntil > Date.now()) {
            return;
          }
          if (reloading) return;
          reloading = true;
          setTimeout(function () {
            window.location.reload();
          }, 300);
        }

        function handleRealtimePayload(payload) {
          if (shouldReloadByPayload(payload)) {
            safeReload();
          }
        }

        function initStream() {
          if (streamRetryStopped) {
            return;
          }

          try {
            if (stream) {
              stream.close();
              stream = null;
            }

            stream = new EventSource('/api/stream/' + encodeURIComponent(String(slug || '')));
            stream.addEventListener('update', function (ev) {
              try {
                const payload = JSON.parse((ev && ev.data) || '{}');
                handleRealtimePayload(payload);
              } catch {}
            });

            stream.onerror = async function () {
              try {
                if (stream) stream.close();
              } catch {}
              stream = null;

              if (streamRetryStopped) {
                return;
              }

              const retryable = await probeStreamAvailability();
              if (!retryable) {
                streamRetryStopped = true;
                return;
              }

              if (streamRetryTimer) {
                clearTimeout(streamRetryTimer);
              }
              streamRetryTimer = setTimeout(initStream, 2000);
            };
          } catch {
            if (streamRetryTimer) {
              clearTimeout(streamRetryTimer);
            }
            streamRetryTimer = setTimeout(initStream, 3000);
          }
        }

        function initMqtt() {
          if (typeof Paho === 'undefined') {
            setTimeout(initMqtt, 400);
            return;
          }

          const broker = parseBroker(mqttBroker);
          const clientId = 'shop_' + String(slug || 'shop') + '_' + Math.random().toString(16).slice(2, 8);
          const client = new Paho.MQTT.Client(
            broker.host,
            Number(broker.port),
            broker.path || '/mqtt',
            clientId,
          );

          client.onConnectionLost = function () {
            setTimeout(initMqtt, 3000);
          };

          client.onMessageArrived = function (message) {
            try {
              const payload = JSON.parse(message.payloadString || '{}');
              handleRealtimePayload(payload);
            } catch {}
          };

          const options = {
            useSSL: !!broker.useSSL,
            timeout: 5,
            keepAliveInterval: 60,
            onSuccess: function () {
              if (Number(shopId) > 0) {
                client.subscribe('shop/' + String(shopId) + '/orders');
              }
              if (String(slug || '').trim() && String(mqttSecret || '').trim()) {
                client.subscribe('restaurant/' + String(slug) + '/' + String(mqttSecret) + '/order');
              }
            },
            onFailure: function () {
              setTimeout(initMqtt, 5000);
            },
          };

          if (String(mqttUsername || '').trim()) options.userName = String(mqttUsername || '').trim();
          if (String(mqttPassword || '').trim()) options.password = String(mqttPassword || '');

          client.connect(options);
        }

        setTimeout(initMqtt, 300);
      })();
    </script>
  </Layout>
)}
