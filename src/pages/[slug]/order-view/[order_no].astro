---
import Layout from '../../../layouts/Layout.astro';
import { API_BASE_URL } from '../../../config';

export const prerender = false;

const { slug, order_no } = Astro.params;
if (!slug || !order_no) return new Response('Not Found', { status: 404 });

const parseJSON = <T = any>(raw: any, fallback: T): T => {
  try {
    if (typeof raw !== 'string' || raw.trim() === '') return fallback;
    return JSON.parse(raw) as T;
  } catch {
    return fallback;
  }
};

let shopRes: Response;
let orderRes: Response;
try {
  [shopRes, orderRes] = await Promise.all([
    fetch(`${API_BASE_URL}/${encodeURIComponent(slug)}/info`),
    fetch(`${API_BASE_URL}/${encodeURIComponent(slug)}/order/${encodeURIComponent(order_no)}`),
  ]);
} catch {
  return new Response('Upstream unavailable', { status: 503 });
}

if (!shopRes.ok || !orderRes.ok) {
  return new Response('Not Found', { status: 404 });
}

let shop: any;
let order: any;
try {
  shop = await shopRes.json();
  order = await orderRes.json();
} catch {
  return new Response('Invalid upstream response', { status: 502 });
}
const settings = parseJSON<any>(shop?.settings, {});

// Public master settings (no auth) for footer/contact display.
// Ensures the order-view page can resolve fallback contact + mqtt settings without a master token.
let publicMasterSettings: any = {};
try {
  const homeRes = await fetch(`${API_BASE_URL}/api/home`);
  if (homeRes.ok) {
    const d = await homeRes.json();
    publicMasterSettings = d?.settings || {};
  }
} catch {}

const masterSettings = publicMasterSettings || {};

const phone =
  String(settings?.contact?.phone || settings?.phone || shop?.phone || masterSettings?.footerPhone || '');

const itemsRaw = parseJSON<any>(order?.itemsJson, [] as any);
const items = Array.isArray(itemsRaw)
  ? itemsRaw
  : itemsRaw && typeof itemsRaw === 'object'
    ? Object.values(itemsRaw)
    : [];

const statusMap: Record<string, string> = {
  pending: '待处理 / Pending',
  confirmed: '已接单 / Confirmed',
  delivering: '配送中 / Delivering',
  completed: '已完成 / Completed',
  cancelled: '已取消 / Cancelled',
  review_needed: '待审核 / Review Needed',
};

const statusKey = String(order?.status || '').toLowerCase();
const statusText = statusMap[statusKey] || String(order?.status || '');

let riderName = String(order?.courierName || '').trim();
let riderPhone = String(order?.courierPhone || '').trim();
if ((!riderName || !riderPhone) && order?.deliveryInfo) {
  const di = parseJSON<any>(order.deliveryInfo, null);
  if (di) {
    if (!riderName) riderName = String(di?.name || '').trim();
    if (!riderPhone) riderPhone = String(di?.phone || '').trim();
  }
}

const mqttBroker = String(settings?.mqttBroker || masterSettings?.mqttBroker || 'mqtt.serbia70.com');
const mqttSecret = String(shop?.mqttSecret || '');
const shopId = Number(shop?.id || 0);
const orderId = Number(order?.id || 0);

const createdAt = String(order?.createdAt || '').replace('T', ' ').replace('Z', '');
const scheduledFor = String(order?.scheduledFor || '').replace('T', ' ').replace('Z', '');
const isDeliveryOrder = String(order?.orderType || '').toLowerCase() === 'delivery';
const tableToken = String(order?.tableInfo || '').split(' ')[0] || '';
const backUrl = `/${slug}`;
const reorderUrl = isDeliveryOrder
  ? `/${slug}?mode=delivery`
  : tableToken
    ? `/${slug}?table=${encodeURIComponent(tableToken)}`
    : `/${slug}`;
---

<Layout title={`订单详情 - ${shop?.name || slug}`}>
  <div class="wrap">
    <div class="card">
      <h1>订单详情 / Detalji porudzbine</h1>
      <div class="line"><span>店铺 / Restoran:</span><b>{shop?.name || slug}</b></div>
      <div class="line"><span>订单号 / Broj:</span><b>#{order?.orderNo || order_no}</b></div>
      <div class="line"><span>状态 / Status:</span><b id="order-status">{statusText}</b></div>
      <div class="line"><span>下单时间 / Vreme:</span><b>{createdAt || '-'}</b></div>
      {scheduledFor && <div class="line"><span>预约送达 / Zakazano:</span><b>{scheduledFor}</b></div>}
      <div class="line"><span>联系商家 / Kontakt:</span>{phone ? <a href={`tel:${phone}`}>{phone}</a> : <b>-</b>}</div>
      {order?.tableInfo && <div class="line"><span>地址/桌号 / Adresa/Sto:</span><b>{order.tableInfo}</b></div>}

      <h2>已点商品 / Stavke</h2>
      <div class="items">
        {items.length === 0 ? (
          <div class="item empty">暂无商品明细</div>
        ) : (
          items.map((it: any) => {
            const n = String(it?.name || it?.productName || '商品');
            const sub = String(it?.subName || '').trim();
            const qty = Number(it?.quantity || it?.qty || 1);
            const price = Number(it?.price || 0);
            return (
              <div class="item">
                <div>
                  <b>{n}</b>
                  {sub && <span class="sub"> ({sub})</span>}
                </div>
                <div class="qty">x{qty}</div>
                <div class="price">{price > 0 ? `${price} RSD` : '-'}</div>
              </div>
            );
          })
        )}
      </div>

      <div class="total">结账金额 / Ukupno: <b id="order-total">{Number(order?.totalAmount || 0)} RSD</b></div>

      <div id="rider-card" class={`rider ${riderName || riderPhone ? '' : 'hide'}`}>
        <h3>送餐员信息 / Dostavljac</h3>
        <div id="rider-name">姓名: {riderName || '-'}</div>
        <div id="rider-phone">
          联系方式: {riderPhone ? <a href={`tel:${riderPhone}`}>{riderPhone}</a> : '-'}
        </div>
      </div>

      <div class="tips">页面已启用 MQTT 实时同步，骑手接单后会自动更新。</div>
    </div>
  </div>

  <div class="sticky-actions">
    <a class="btn-back" href={backUrl}>返回店铺 / Nazad</a>
    <a class="btn-reorder" href={reorderUrl}>再次下单 / Poruci ponovo</a>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js" is:inline></script>
  <script define:vars={{ slug, shopId, mqttSecret, mqttBroker, orderId, order_no }} is:inline>
    (function () {
      function parseBroker(raw) {
        const v = String(raw || '').trim();
        if (!v) return { host: 'mqtt.serbia70.com', port: 443, path: '/mqtt', useSSL: true };
        if (v.startsWith('ws://') || v.startsWith('wss://')) {
          try {
            const u = new URL(v);
            return {
              host: u.hostname,
              port: Number(u.port || (u.protocol === 'wss:' ? 443 : 80)),
              path: u.pathname || '/mqtt',
              useSSL: u.protocol === 'wss:',
            };
          } catch {}
        }
        if (v.indexOf('serbia70.com') !== -1) {
          return { host: 'mqtt.serbia70.com', port: 443, path: '/mqtt', useSSL: true };
        }
        return { host: v, port: 8083, path: '/mqtt', useSSL: false };
      }

      function shouldRefresh(payload) {
        const pid = Number((payload && (payload.orderId || payload.id)) || 0);
        const pno = String((payload && payload.orderNo) || '').trim();
        if (pid > 0 && Number(orderId || 0) > 0 && pid === Number(orderId)) return true;
        if (pno && pno === String(order_no || '')) return true;
        return false;
      }

      function initMqtt() {
        if (typeof Paho === 'undefined') {
          setTimeout(initMqtt, 400);
          return;
        }

        const b = parseBroker(mqttBroker);
        const clientId = 'ov_' + String(slug || 's') + '_' + Math.random().toString(16).slice(2, 8);
        const client = new Paho.MQTT.Client(b.host, Number(b.port), b.path || '/mqtt', clientId);

        client.onConnectionLost = function () {
          setTimeout(initMqtt, 3000);
        };

        client.onMessageArrived = function (m) {
          try {
            const payload = JSON.parse(m.payloadString || '{}');
            if (shouldRefresh(payload)) {
              window.location.reload();
            }
          } catch {}
        };

        const opts = {
          useSSL: !!b.useSSL,
          timeout: 5,
          keepAliveInterval: 60,
          onSuccess: function () {
            if (Number(shopId) > 0) client.subscribe('shop/' + String(shopId) + '/orders');
            if (String(slug || '').trim() && String(mqttSecret || '').trim()) {
              client.subscribe('restaurant/' + String(slug) + '/' + String(mqttSecret) + '/order');
              client.subscribe('restaurant/' + String(slug) + '/' + String(mqttSecret) + '/status');
            }
          },
          onFailure: function () {
            setTimeout(initMqtt, 5000);
          },
        };

        client.connect(opts);
      }

      setTimeout(initMqtt, 200);
    })();
  </script>

<style is:inline>
  * { box-sizing: border-box; }
  .wrap { max-width: 800px; margin: 24px auto 130px; padding: 0 16px; }
  .card { background: #fff; border-radius: 20px; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,.08); border: 1px solid #f0f0f0; }
  h1 { margin: 0 0 20px; font-size: 24px; color: #1a1a2e; font-weight: 700; position: relative; padding-bottom: 15px; }
  h1::after { content: ''; position: absolute; bottom: 0; left: 0; width: 60px; height: 4px; background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); border-radius: 2px; }
  h2 { margin: 28px 0 16px; font-size: 20px; color: #2d3748; font-weight: 600; }
  .line { display: flex; gap: 12px; margin: 12px 0; color: #2d3748; align-items: baseline; padding: 10px 14px; background: #f8fafc; border-radius: 10px; transition: all 0.2s; }
  .line:hover { background: #edf2f7; }
  .line span { color: #718096; min-width: 140px; font-weight: 500; font-size: 14px; }
  .line b { color: #1a202c; font-weight: 600; }
  .line a { color: #4299e1; text-decoration: none; font-weight: 600; transition: color 0.2s; }
  .line a:hover { color: #3182ce; text-decoration: underline; }
  #order-status { color: #059669; background: #d1fae5; padding: 4px 12px; border-radius: 20px; font-size: 14px; }
  .items { border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; background: #fff; }
  .item { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; padding: 16px 20px; border-bottom: 1px solid #f1f5f9; align-items: center; transition: background 0.2s; }
  .item:hover { background: #f8fafc; }
  .item:last-child { border-bottom: none; }
  .item.empty { display: block; color: #a0aec0; text-align: center; padding: 40px 20px; }
  .item b { color: #2d3748; font-weight: 600; font-size: 16px; }
  .sub { color: #718096; font-size: 14px; }
  .qty { color: #4a5568; font-weight: 500; font-size: 14px; background: #f1f5f9; padding: 4px 10px; border-radius: 20px; }
  .price { color: #d32f2f; font-weight: 700; font-size: 16px; }
  .total { margin-top: 24px; padding: 20px; background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%); border-radius: 16px; font-size: 20px; color: #1a202c; display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
  #order-total { color: #d32f2f; font-size: 24px; font-weight: 700; }
  .rider { margin-top: 24px; padding: 20px; border-radius: 16px; background: linear-gradient(135deg, #ebf8ff 0%, #e6fffa 100%); border: 1px solid #90cdf4; }
  .rider h3 { margin: 0 0 12px; color: #2b6cb0; font-size: 16px; }
  .rider.hide { display: none; }
  .rider a { color: #2b6cb0; text-decoration: none; font-weight: 600; }
  .rider a:hover { color: #2c5282; }
  .tips { margin-top: 20px; padding: 16px 20px; font-size: 14px; color: #4a5568; background: #fffbeb; border: 1px solid #fbd38d; border-radius: 12px; display: flex; align-items: center; gap: 10px; }
  .tips::before { content: '💡'; font-size: 18px; }
  .sticky-actions {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid #e2e8f0;
    backdrop-filter: blur(10px);
    box-shadow: 0 -4px 20px rgba(0,0,0,.05);
  }
  .sticky-actions a {
    text-decoration: none;
    text-align: center;
    padding: 16px 20px;
    border-radius: 14px;
    font-weight: 600;
    font-size: 16px;
    border: 1px solid transparent;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .sticky-actions a:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }
  .sticky-actions .btn-back {
    background: #f7fafc;
    color: #4a5568;
    border-color: #e2e8f0;
  }
  .sticky-actions .btn-back:hover { background: #edf2f7; }
  .sticky-actions .btn-reorder {
    background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
    color: #fff;
    box-shadow: 0 4px 14px rgba(72, 187, 120, 0.4);
  }
  .sticky-actions .btn-reorder:hover { box-shadow: 0 6px 20px rgba(72, 187, 120, 0.5); }
  @media (max-width: 640px) {
    .wrap { margin: 16px auto 120px; padding: 0 12px; }
    .card { padding: 20px; border-radius: 16px; }
    h1 { font-size: 20px; }
    h2 { font-size: 18px; }
    .line { flex-direction: column; gap: 4px; padding: 12px; }
    .line span { min-width: 0; font-size: 13px; }
    .item { grid-template-columns: 1fr; gap: 8px; padding: 14px 16px; }
    .sticky-actions { padding: 12px; }
    .sticky-actions a { font-size: 15px; padding: 14px 16px; }
    .total { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>
</Layout>
