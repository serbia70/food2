---
import Layout from '../../../layouts/Layout.astro';
import { API_BASE_URL } from '../../../config';
import { isHallLikeZoneName, isPlaceholderZoneName } from '../../../lib/table-config';
import { orderMatchesAnyConfiguredTable } from '../../../lib/admin-table-ref';
import { asObject, parseMaybeJSON, normalizeJSONString, resolveTableConfig, buildTableCards } from '../../../lib/admin-dashboard-utils';
import AdminHeader from '../../../components/admin/AdminHeader.astro';
import AdminTabs from '../../../components/admin/AdminTabs.astro';
import TabOrders from '../../../components/admin/TabOrders.astro';
import TabReservations from '../../../components/admin/TabReservations.astro';
import TabTables from '../../../components/admin/TabTables.astro';
import TabMenu from '../../../components/admin/TabMenu.astro';
import TabSettings from '../../../components/admin/TabSettings.astro';
import TabStats from '../../../components/admin/TabStats.astro';
import TabMarketing from '../../../components/admin/TabMarketing.astro';
import TabCustomers from '../../../components/admin/TabCustomers.astro';
import TabData from '../../../components/admin/TabData.astro';
import TabPassword from '../../../components/admin/TabPassword.astro';
import TabRenew from '../../../components/admin/TabRenew.astro';
import AdminModals from '../../../components/admin/AdminModals.astro';
import AdminScripts from '../../../components/admin/AdminScripts.astro';
import '../../../styles/admin-global.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });
const safeSlug = encodeURIComponent(slug);

const token = Astro.cookies.get('admin_token')?.value;
if (!token) {
  const q = Astro.url.search || '';
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login${q}`, 302);
}

async function fetchJSON(url: string, init: RequestInit = {}) {
  try {
    const mergedInit: RequestInit = {
      ...init,
      cache: 'no-store',
      headers: {
        ...(init.headers || {}),
        'Cache-Control': 'no-cache',
        Pragma: 'no-cache',
      },
    };
    const res = await fetch(url, mergedInit);
    const text = await res.text();
    let data: any = null;
    try {
      data = text ? JSON.parse(text) : null;
    } catch {
      data = null;
    }
    return { ok: res.ok, status: res.status, data };
  } catch {
    return { ok: false, status: 503, data: null };
  }
}

function isHallZoneName(v: any) {
  return isHallLikeZoneName(v);
}

const authHeaders = { Authorization: `Bearer ${token}` };

const [statusResp, shopResp, menuResp, ordersResp, billingResp] = await Promise.all([
  fetchJSON(`${API_BASE_URL}/api/admin/status`, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/info`),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/menu`),
  fetchJSON(`${API_BASE_URL}/api/admin/orders?_=${Date.now()}`, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/api/admin/billing`, { headers: authHeaders }),
]);

const statusCode = Number(statusResp.status || 0);
const statusIsAuthError = statusCode === 401 || statusCode === 403;

if (statusIsAuthError) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const rawShop = asObject(shopResp.data);
if (!shopResp.ok || !rawShop?.id) {
  return new Response('Not Found', { status: 404 });
}

const statusShopId = Number(statusResp.data?.shop_id || 0);
if (statusResp.ok && statusShopId > 0 && statusShopId !== Number(rawShop.id)) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const shop = {
  ...rawShop,
  id: Number(rawShop.id || 0),
  slug: String(rawShop.slug || slug),
  name: String(rawShop.name || slug),
  settings: typeof rawShop.settings === 'string' ? rawShop.settings : JSON.stringify(rawShop.settings || {}),
  table_config:
    typeof rawShop.table_config === 'string'
      ? rawShop.table_config
      : JSON.stringify(rawShop.table_config || {}),
};

const settings = asObject(parseMaybeJSON(shop.settings));

const billingData = asObject(billingResp.data?.billing);
const subscriptionFeeRSD = Number(billingResp.data?.subscription_fee_rsd || settings.subscription_fee_rsd || 1200);
const businessFeeRSD = Number(billingResp.data?.business_fee_rsd || settings.business_fee_rsd || 1800);
const billingBalanceRSD = Number(billingData.balance_rsd || 0);
const billingPlanType = String(billingData.plan_type || 'subscription').toLowerCase();
const pendingPlanType = String(billingData.pending_plan_type || '').toLowerCase();
const billingStatus = String(billingData.billing_status || 'active');
const billingNextChargeDate = String(billingData.next_charge_date || '');
const billingGraceUntil = String(billingData.grace_until || '');
const billingAlertLevel = String(billingData.billing_alert_level || 'normal');
const upgradeChargeRSD = Number(billingData.upgrade_charge_rsd || 0);

// 从后端获取真实的营业额（包含已清理的记录）
const lastMonthRevenue = Number(billingData.last_month_revenue || 0);
const thisMonthRevenue = Number(billingData.this_month_revenue || 0);

const deliveryChargeRSD = Number(rawShop?.delivery_charge_rsd || 0);

const deliveryLocked = Boolean(rawShop?.delivery_locked);
const deliveryLockReason = String(rawShop?.delivery_lock_reason || '');
const isPaidPlan = billingPlanType === 'subscription' || billingPlanType === 'business';
const showReservationTab = isPaidPlan && Number(shop?.enable_reservation ?? 0) !== 0;
const showStatsTab = isPaidPlan;
const showMarketingTab = billingPlanType === 'business';
const showCustomersTab = billingPlanType === 'subscription' || billingPlanType === 'business';

const rawMenu = Array.isArray(menuResp.data) ? menuResp.data : [];
const categories = rawMenu.map((c: any) => ({
  id: Number(c?.id || 0),
  name: String(c?.name || ''),
  sub_name: String(c?.sub_name || ''),
  sort_order: Number(c?.sort_order || 0),
}));

const products = rawMenu.flatMap((c: any) => {
  const list = Array.isArray(c?.products) ? c.products : [];
  return list.map((p: any) => ({
    ...p,
    id: Number(p?.id || 0),
    category_id: Number(p?.category_id || c?.id || 0),
    price: Number(p?.price || 0),
    sort_order: Number(p?.sort_order || 0),
    name: String(p?.name || ''),
    sub_name: String(p?.sub_name || ''),
    img: String(p?.img || ''),
  }));
});

const rawOrders = Array.isArray(ordersResp.data) ? ordersResp.data : [];
const orders = rawOrders.map((o: any) => ({
  ...o,
  id: Number(o?.id || 0),
  order_no: String(o?.order_no || o?.id || ''),
  order_type: String(o?.order_type || 'dine_in'),
  status: String(o?.status || 'pending'),
  total_amount: Number(o?.total_amount || 0),
  items_json: normalizeJSONString(o?.items_json, '{}'),
  remarks_json: normalizeJSONString(o?.remarks_json, '[]'),
  table_info: String(o?.table_info || ''),
  user_phone: String(o?.user_phone || ''),
  scheduled_for: String(o?.scheduled_for || ''),
  created_at: String(o?.created_at || ''),
  is_deleted: Number(o?.is_deleted || 0),
}));

const tableConfig = resolveTableConfig(shop, settings);
const firstZoneName = String(tableConfig?.[0]?.name || '').trim();
const firstZonePrefix = String(tableConfig?.[0]?.prefix || '').trim();
const useSimpleHallLabel =
  tableConfig.length === 1 &&
  (!firstZoneName && !firstZonePrefix || isHallZoneName(firstZoneName) || isHallZoneName(firstZonePrefix) || isPlaceholderZoneName(firstZoneName) || isPlaceholderZoneName(firstZonePrefix));
const tableCardsData = buildTableCards(orders, tableConfig);
const unmatchedDineInOrders = orders
  .filter(
    (o: any) =>
      o.order_type === 'dine_in' &&
      o.status !== 'completed' &&
      o.status !== 'cancelled' &&
      o.status !== 'archived' &&
      o.status !== 'paid' &&
      o.is_deleted !== 1,
  )
  .filter((o: any) => !orderMatchesAnyConfiguredTable(o.table_info, tableConfig));
const activeDeliveryOrders = orders.filter(
  (o: any) =>
    o.order_type === 'delivery' &&
    (o.status === 'pending' || o.status === 'confirmed' || o.status === 'delivering') &&
    o.is_deleted !== 1,
);

const daysLeft = 0;
const isExpired = false;
const isWarning = false;
const isNotice = false;
const expireDateStr = '按月自动扣费';

const now = new Date();
const prevMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
const prevMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59, 59, 999);
const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);

const commissionType = shop.commission_type === 'percentage' ? 'percentage' : 'per_order';
const commissionValue = Number(shop.commission_value || 30);

// 计算累计消耗
const lastMonthCommission = Math.round(lastMonthRevenue * (commissionValue / 100));
const thisMonthCommission = Math.round(thisMonthRevenue * (commissionValue / 100));

// 如果余额为负，则视为“待付”
const debtAmount = billingBalanceRSD < 0 ? Math.abs(billingBalanceRSD) : 0;

const isBillPeriod = now.getDate() <= 6;

const lastMonthKey = prevMonthStart.toISOString().slice(0, 7);
const isLastMonthPaid = String(shop.last_paid_month || '') === lastMonthKey;
const showPayWarning = isBillPeriod && lastMonthCommission > 0 && !isLastMonthPaid;
const lastMonthName = prevMonthStart.getMonth() + 1;

const brokerIp = String(settings.mqtt_broker || 'mqtt.serbia70.com');

let shopCategories = Array.isArray(settings.categories)
  ? settings.categories.filter((c: any) => c && c.id !== 'more')
  : [];
if (shopCategories.length === 0) {
  shopCategories = [
    { id: 'food', name: '外卖美食', icon: '🍔' },
    { id: 'mart', name: '超市便利', icon: '🛒' },
    { id: 'fruit', name: '蔬菜水果', icon: '🍎' },
    { id: 'drink', name: '甜点饮品', icon: '🥤' },
    { id: 'hotel', name: '酒店民宿', icon: '🏨' },
    { id: 'job', name: '招聘求职', icon: '💼' },
    { id: 'service', name: '生活服务', icon: '🔧' },
  ];
}

const cities = {
  Belgrade: ['New Belgrade', 'Zemun', 'Old Town', 'Vracar', 'Palilula', 'Vozdovac'],
  'Novi Sad': ['City Center', 'Liman', 'Detelinara'],
  Nis: ['Mediana', 'Pantelej'],
};
---

<Layout
  title={`后台管理 - ${shop.name}`}
  manifest={`/admin/${safeSlug}/manifest.webmanifest`}
  serviceWorker="/admin-sw.js"
  serviceWorkerScope={`/admin/${safeSlug}`}
  themeColor="#0b3b60"
>
  <script type="application/json" id="cities-data" is:inline>{JSON.stringify(cities)}</script>
  <script type="application/json" id="table-config-data" is:inline>{JSON.stringify(tableConfig)}</script>
  <script type="application/json" id="categories-data" is:inline>{JSON.stringify(categories)}</script>
  <script type="application/json" id="products-data" is:inline>{JSON.stringify(products)}</script>
  <input type="hidden" id="shop-id-hidden" value={String(shop.id)} />

  {
    isExpired ? (
      <div style="background:#d32f2f; color:#fff; padding:15px; text-align:center; position:fixed; top:0; left:0; right:0; z-index:9999;">
        <h3 style="margin:0;">服务已到期</h3>
        <p style="margin:6px 0 0;">请联系管理员缴纳费用后恢复服务。</p>
      </div>

    ) : (
      <div style="display:flex; flex-direction:column; gap:5px; margin-bottom:10px;">
        <div
          style={`text-align:center; padding:8px; font-size:13px; font-weight:bold; border-radius:4px; ${
            isWarning
              ? 'background:#ffebee; color:#d32f2f; border:1px solid #ffcdd2;'
              : isNotice
                ? 'background:#fff8e1; color:#f57c00; border:1px solid #ffe0b2;'
                : 'background:#e8f5e9; color:#2e7d32; border:1px solid #c8e6c9;'
          }`}
        >
          {billingPlanType === 'subscription'
            ? `订阅版：每月 1 号自动扣费（月费 ${subscriptionFeeRSD} RSD）`
            : billingPlanType === 'business'
              ? `商务版：每月 1 号自动扣费（月费 ${businessFeeRSD} RSD）`
              : '套餐信息异常，请联系平台管理员'}
          <span
            id="mqtt-status-indicator"
            style="margin-left:10px; font-size:11px; padding:2px 6px; border-radius:10px; background:#eee; color:#999;"
          >
            MQTT: 连接中...
          </span>
        </div>

        <div
          style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:8px;"
        >
          <div style="background:#ecfdf5; border:1px solid #86efac; border-radius:8px; padding:10px;">
            <div style="font-size:12px; color:#166534;">钱包余额</div>
            <div style="font-size:20px; font-weight:800; color:#166534;">{billingBalanceRSD} RSD</div>
            <div style="font-size:12px; color:#166534; margin-top:2px;">套餐：{billingPlanType === 'business' ? '商务版' : '订阅版'}</div>
          </div>
          <div style="background:#eff6ff; border:1px solid #93c5fd; border-radius:8px; padding:10px;">
            <div style="font-size:12px; color:#1e3a8a;">外卖扣点门槛</div>
            <div style="font-size:20px; font-weight:800; color:#1d4ed8;">{deliveryChargeRSD} RSD</div>
            <div style="font-size:12px; color:#1e40af; margin-top:2px;">用于余额锁单判断，实际扣点按提成规则计算</div>
          </div>
          <div style={`border-radius:8px; padding:10px; border:1px solid ${deliveryLocked ? '#fecaca' : '#86efac'}; background:${deliveryLocked ? '#fef2f2' : '#f0fdf4'};`}>
            <div style={`font-size:12px; color:${deliveryLocked ? '#991b1b' : '#166534'};`}>外卖状态</div>
            <div style={`font-size:20px; font-weight:800; color:${deliveryLocked ? '#b91c1c' : '#15803d'};`}>
              {deliveryLocked ? '受限（需充值）' : '正常可接单'}
            </div>
            <div style={`font-size:12px; margin-top:2px; color:${deliveryLocked ? '#991b1b' : '#166534'};`}>
              {deliveryLocked ? (deliveryLockReason || '余额不足，请先充值') : '扣点成功后自动放行下一单'}
            </div>
          </div>
          <div style={`border-radius:8px; padding:10px; border:1px solid ${isPaidPlan ? '#fcd34d' : '#cbd5e1'}; background:${isPaidPlan ? '#fffbeb' : '#f8fafc'};`}>
            <div style="font-size:12px; color:#92400e;">缴费提醒</div>
            <div style="font-size:13px; font-weight:700; color:#78350f; margin-top:3px;">
              {billingPlanType === 'subscription'
                ? `每月1号自动扣费（月费 ${subscriptionFeeRSD} RSD）`
                : billingPlanType === 'business'
                  ? `每月1号自动扣费（月费 ${businessFeeRSD} RSD）`
                  : '套餐信息异常'}
            </div>
            {isPaidPlan && billingNextChargeDate && (
              <div style="font-size:12px; color:#92400e; margin-top:3px;">下次扣费日：{billingNextChargeDate}</div>
            )}
            {isPaidPlan && billingGraceUntil && (
              <div style="font-size:12px; color:#b91c1c; margin-top:3px;">宽限截止：{billingGraceUntil}</div>
            )}
          </div>
        </div>

        {
          billingAlertLevel !== 'normal' && (
            <div
              style={`text-align:center; padding:10px; font-size:13px; font-weight:bold; border-radius:4px; border:1px solid ${
                billingAlertLevel === 'overdue'
                  ? '#fecaca'
                  : billingAlertLevel === 'critical'
                    ? '#fecaca'
                    : '#fde68a'
              }; background:${
                billingAlertLevel === 'overdue'
                  ? '#fef2f2'
                  : billingAlertLevel === 'critical'
                    ? '#fff1f2'
                    : '#fffbeb'
              }; color:${
                billingAlertLevel === 'overdue'
                  ? '#7f1d1d'
                  : billingAlertLevel === 'critical'
                    ? '#991b1b'
                    : '#92400e'
              };`}
            >
              {billingAlertLevel === 'overdue'
                ? `欠费宽限中，请尽快充值（余额 ${billingBalanceRSD} RSD）`
                : billingAlertLevel === 'critical'
                  ? `余额低于 200 RSD（当前 ${billingBalanceRSD} RSD），请立即充值`
                  : `余额低于 1000 RSD（当前 ${billingBalanceRSD} RSD），建议尽快充值`}
            </div>
          )
        }

        {
          lastMonthCommission > 0 && (
            <div
              style={`text-align:center; padding:10px; font-size:13px; font-weight:bold; border-radius:4px; border:1px solid ${isLastMonthPaid ? '#c8e6c9' : '#b3e5fc'}; background:${isLastMonthPaid ? '#e8f5e9' : '#e1f5fe'}; color:${isLastMonthPaid ? '#2e7d32' : '#0277bd'};`}
            >
              <div style="font-size:15px; margin-bottom:4px;">
                {isLastMonthPaid
                  ? `${lastMonthName} 月已结清: ${lastMonthCommission} RSD`
                  : `${lastMonthName} 月待付佣金: ${lastMonthCommission} RSD`}
              </div>
              {showPayWarning && <div style="margin-top:5px; color:#c62828;">请于 6 号前完成支付</div>}
            </div>
          )
        }
      </div>
    )
  }

  <div id="page-wrapper" style="max-width:1400px; margin:0 auto; width:100%; box-sizing:border-box;">
    <div class="admin-container">
      <AdminHeader shop={shop} restaurantId={slug} />
      <AdminTabs showReservationTab={showReservationTab} showStatsTab={showStatsTab} showMarketingTab={showMarketingTab} showCustomersTab={showCustomersTab} />
      <TabTables tableCardsData={tableCardsData} activeDeliveryOrders={activeDeliveryOrders} unmatchedDineInOrders={unmatchedDineInOrders} useSimpleHallLabel={useSimpleHallLabel} />
      <TabOrders orders={orders} useSimpleHallLabel={useSimpleHallLabel} />
      {showReservationTab && <TabReservations />}
      <TabMenu categories={categories} products={products} shop={shop} />
      <TabSettings
        settings={settings}
        shop={shop}
        shopCategories={shopCategories}
        brokerIp={brokerIp}
        restaurantId={shop.id}
        cities={cities}
      />
      {showStatsTab && <TabStats />}
      {showMarketingTab && <TabMarketing shopSlug={slug} shopSettings={settings} />}
      {showCustomersTab && <TabCustomers shopSlug={slug} />}
      <TabData restaurantId={shop.id} />
      <TabPassword />
      <TabRenew
        lastMonthCommission={lastMonthCommission}
        thisMonthCommission={thisMonthCommission}
        debtAmount={debtAmount}
        isBillPeriod={isBillPeriod}

        showPayWarning={showPayWarning}
        isLastMonthPaid={isLastMonthPaid}
        lastMonthName={lastMonthName}
        billingAlertLevel={billingAlertLevel}
        billingBalanceRSD={billingBalanceRSD}
        subscriptionFeeRSD={subscriptionFeeRSD}
        businessFeeRSD={businessFeeRSD}
        billingStatus={billingStatus}
        billingNextChargeDate={billingNextChargeDate}
        billingGraceUntil={billingGraceUntil}
        billingPlanType={billingPlanType}
        pendingPlanType={pendingPlanType}
        upgradeChargeRSD={upgradeChargeRSD}
      />
    </div>
  </div>

  <AdminModals categories={categories} />

  <div style="display:none;" aria-hidden="true">
    {orders.map((o: any) => (
      <span
        class="hidden-data"
        data-oid={o.id}
        data-order-id={o.id}
        data-order-no={o.order_no}
        data-items={o.items_json}
        data-total={o.total_amount}
        data-table={o.table_info}
        data-status={o.status}
        data-remarks={o.remarks_json}
      ></span>
    ))}
  </div>

  <AdminScripts
    shopId={shop.id}
    shopSlug={shop.slug}
    tableConfig={tableConfig}
    settings={settings}
    brokerIp={brokerIp}
    shop={shop}
  />

  <div id="reject-modal" class="modal-overlay" style="display:none;" onclick="if(event.target === this) window.closeRejectModal()">
    <div class="modal-content" style="max-width:400px; background:#fff; padding:20px; border-radius:8px;">
      <h3 style="margin-top:0; color:#d32f2f;">拒绝订单</h3>
      <p style="color:#666; font-size:14px;">请选择拒绝原因:</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;">
        <button class="reject-reason-btn" onclick="selectRejectReason('已打烊 / Closed')">已打烊</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('缺货/售罄 / Out of stock')">缺货/售罄</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('距离太远 / Too far')">距离太远</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('无法联系 / Cannot contact')">无法联系</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('订单信息错误 / Invalid info')">信息错误</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('其他 / Other')">其他</button>
      </div>
      <textarea id="reject-reason-input" placeholder="请输入具体原因..." style="width:100%; height:80px; padding:10px; border:1px solid #ddd; border-radius:4px; margin-bottom:15px; box-sizing:border-box;"></textarea>
      <input type="hidden" id="reject-order-id" />
      <div style="display:flex; gap:10px;">
        <button onclick="window.closeRejectModal()" style="flex:1; padding:10px; background:#eee; border:none; border-radius:4px; cursor:pointer;">取消</button>
        <button onclick="window.confirmReject()" style="flex:1; padding:10px; background:#f44336; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">确认拒绝</button>
      </div>
    </div>
  </div>

  <style is:inline>
    .reject-reason-btn {
      background: #fff;
      border: 1px solid #ddd;
      padding: 8px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }
    .reject-reason-btn:hover {
      background: #ffebee;
      border-color: #ef9a9a;
    }
    .reject-reason-btn.selected {
      background: #f44336;
      color: #fff;
      border-color: #d32f2f;
    }
  </style>
</Layout>
