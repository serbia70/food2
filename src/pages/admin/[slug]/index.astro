---
import Layout from '../../../layouts/Layout.astro';
import { API_BASE_URL, MASTER_TOKEN } from '../../../config';
import AdminHeader from '../../../components/admin/AdminHeader.astro';
import AdminTabs from '../../../components/admin/AdminTabs.astro';
import TabOrders from '../../../components/admin/TabOrders.astro';
import TabReservations from '../../../components/admin/TabReservations.astro';
import TabTables from '../../../components/admin/TabTables.astro';
import TabMenu from '../../../components/admin/TabMenu.astro';
import TabSettings from '../../../components/admin/TabSettings.astro';
import TabStats from '../../../components/admin/TabStats.astro';
import TabData from '../../../components/admin/TabData.astro';
import TabPassword from '../../../components/admin/TabPassword.astro';
import TabRenew from '../../../components/admin/TabRenew.astro';
import AdminModals from '../../../components/admin/AdminModals.astro';
import AdminScripts from '../../../components/admin/AdminScripts.astro';
import '../../../styles/admin-global.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });
const safeSlug = encodeURIComponent(slug);

const token = Astro.cookies.get('admin_token')?.value;
if (!token) {
  const q = Astro.url.search || '';
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login${q}`, 302);
}

async function fetchJSON(url: string, init: RequestInit = {}) {
  try {
    const mergedInit: RequestInit = {
      ...init,
      cache: 'no-store',
      headers: {
        ...(init.headers || {}),
        'Cache-Control': 'no-cache',
        Pragma: 'no-cache',
      },
    };
    const res = await fetch(url, mergedInit);
    const text = await res.text();
    let data: any = null;
    try {
      data = text ? JSON.parse(text) : null;
    } catch {
      data = null;
    }
    return { ok: res.ok, status: res.status, data };
  } catch {
    return { ok: false, status: 503, data: null };
  }
}

function asObject(v: any): Record<string, any> {
  return v && typeof v === 'object' && !Array.isArray(v) ? v : {};
}

function parseMaybeJSON(v: any): any {
  if (typeof v !== 'string') return v;
  const t = v.trim();
  if (!t) return null;
  try {
    return JSON.parse(t);
  } catch {
    return null;
  }
}

function normalizeJSONString(v: any, fallback: string): string {
  if (v == null) return fallback;
  if (typeof v === 'string') {
    const t = v.trim();
    if (!t) return fallback;
    try {
      return JSON.stringify(JSON.parse(t));
    } catch {
      return fallback;
    }
  }
  try {
    return JSON.stringify(v);
  } catch {
    return fallback;
  }
}

function parseDBDateMs(v: any): number {
  if (!v) return 0;
  const raw = String(v).trim();
  if (!raw) return 0;
  const iso = raw.includes('T') ? raw : raw.replace(' ', 'T');
  const d1 = new Date(iso.endsWith('Z') ? iso : `${iso}Z`);
  if (!Number.isNaN(d1.getTime())) return d1.getTime();
  const d2 = new Date(iso);
  if (!Number.isNaN(d2.getTime())) return d2.getTime();
  return 0;
}

function formatHHmm(v: any): string {
  const ms = parseDBDateMs(v);
  if (!ms) return '--:--';
  return new Intl.DateTimeFormat('sr-RS', {
    timeZone: 'Europe/Belgrade',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(new Date(ms));
}

function resolveTableConfig(shop: any, settings: any): Array<{ name: string; prefix: string; count: number }> {
  const candidates: any[] = [
    parseMaybeJSON(shop?.table_config),
    settings?.table_config,
    settings?.tables,
  ];

  let zones: any[] = [];
  for (const c of candidates) {
    if (Array.isArray(c)) {
      zones = c;
      break;
    }
    if (c && Array.isArray(c.zones)) {
      zones = c.zones;
      break;
    }
  }

  const normalized = zones
    .map((z, i) => {
      const name = String(z?.name || '').trim();
      let prefix = String(z?.prefix ?? '').trim();
      const n = Number(z?.count);
      const count = Number.isFinite(n) && n > 0 ? Math.min(300, Math.floor(n)) : 1;
      return { name, prefix, count };
    })
    .filter((z) => z.count > 0);

  if (normalized.length === 1) {
    const z = normalized[0];
    const placeholderName = /^区域\d+$/u.test(String(z.name || '').trim());
    const hallLikeName = isHallZoneName(z.name);
    const hallLikePrefix = isHallZoneName(z.prefix);
    const placeholderPrefix = /^区域\d+$/u.test(String(z.prefix || '').trim());

    if ((placeholderName || hallLikeName || !String(z.name || '').trim()) && (z.prefix === z.name || hallLikePrefix || placeholderPrefix)) {
      z.prefix = '';
    }
    if (placeholderName) {
      z.name = '';
    }
  }

  if (normalized.length > 0) return normalized;
  return [{ name: '大厅', prefix: '', count: 12 }];
}

function buildTableCards(orders: any[], tableConfig: Array<{ name: string; prefix: string; count: number }>) {
  const activeDineIn = orders.filter(
    (o) =>
      o.order_type === 'dine_in' &&
      o.status !== 'completed' &&
      o.status !== 'cancelled' &&
      o.status !== 'archived' &&
      o.status !== 'paid' &&
      o.is_deleted !== 1,
  );

  const latestActiveId = activeDineIn.reduce((max, o) => Math.max(max, Number(o.id || 0)), 0);
  const cards: any[] = [];
  const simpleHall = isSimpleHallTableConfig(tableConfig);
  const simpleHallMaxCount = simpleHall ? Math.max(0, Number(tableConfig?.[0]?.count || 0)) : 0;

  for (const zone of tableConfig) {
    for (let i = 1; i <= zone.count; i++) {
      const tableNum = buildTableValue(zone, i, tableConfig);
      const tableRef = parseTableRef(tableNum);
      const displayNum = String(i);
      const tableOrders = activeDineIn.filter((o) => {
        const tableInfo = String(o.table_info || '').trim();
        if (!tableInfo) return false;
        const orderRef = parseTableRef(tableInfo);
        const sameExact = !!(orderRef.key && tableRef.key && orderRef.key === tableRef.key);
        const sameNumberWithCompatibleArea =
          !!(tableRef.number &&
            orderRef.number &&
            tableRef.number === orderRef.number &&
            (tableRef.area === orderRef.area || (!tableRef.area && !orderRef.area)));
        const singleRoomLegacyMatch =
          !!(!tableRef.number && tableRef.area && orderRef.area && tableRef.area === orderRef.area);
        const legacySimpleHallMatch =
          !!(
            simpleHall &&
            tableRef.number &&
            inferLegacySimpleHallNumber(tableInfo, simpleHallMaxCount) === tableRef.number
          );
        return sameExact || sameNumberWithCompatibleArea || singleRoomLegacyMatch || legacySimpleHallMatch;
      });

      const hasOrder = tableOrders.length > 0;
      const hasReviewRequest = tableOrders.some((o) => o.status === 'review_needed');
      const total = tableOrders.reduce((sum, o) => sum + Number(o.total_amount || 0), 0);

      let orderTime = '';
      let orderTimeTimestamp = 0;
      let isNew = false;
      let latestPickupNo = '';

      if (hasOrder) {
        const sorted = [...tableOrders].sort(
          (a, b) => parseDBDateMs(a.created_at) - parseDBDateMs(b.created_at),
        );
        const firstOrder = sorted[0];
        orderTime = formatHHmm(firstOrder?.created_at);

        const latestInTable = [...tableOrders].sort((a, b) => Number(b.id || 0) - Number(a.id || 0))[0];
        orderTimeTimestamp = parseDBDateMs(latestInTable?.created_at);
        isNew = Number(latestInTable?.id || 0) === latestActiveId && Date.now() - orderTimeTimestamp < 60_000;
        const latestOrderNo = String(latestInTable?.order_no || latestInTable?.id || '');
        latestPickupNo = latestOrderNo ? latestOrderNo.slice(-3) : '';
      }

      cards.push({
        zoneName: zone.name,
        zoneCount: zone.count,
        tableNum,
        tableLabel: buildTableDisplayLabel(zone, i, tableConfig),
        displayNum,
        hasOrder,
        hasReviewRequest,
        total,
        orderTime,
        isNew,
        orderTimeTimestamp,
        latestPickupNo,
      });
    }
  }

  return cards;
}

function normalizeTableArea(input: string): string {
  return String(input || '').replace(/\s+/g, '').trim().toLowerCase();
}

function extractTableNumber(input: any): string {
  const raw = String(input || '').trim();
  if (!raw) return '';
  const cleaned = raw.replace(/\s*(号桌|桌号|桌)\s*$/u, '').trim();
  const m = cleaned.match(/(\d+)\s*$/u);
  if (!m) return '';
  return String(Number(m[1] || '0') || m[1]);
}

function parseTableRef(input: any): { area: string; number: string; key: string } {
  const raw = String(input || '').trim();
  if (!raw) return { area: '', number: '', key: '' };
  const cleaned = raw.replace(/\s*(号桌|桌号|桌)\s*$/u, '').trim();
  const m = cleaned.match(/^(.*?)\s*(\d+)$/u);
  if (!m) {
    const areaOnly = normalizeTableArea(cleaned);
    return { area: areaOnly, number: '', key: areaOnly };
  }
  const area = normalizeTableArea(m[1] || '');
  const num = String(Number(m[2] || '0') || m[2]);
  return { area, number: num, key: `${area}${num}` };
}

function inferLegacySimpleHallNumber(raw: any, maxCount: number): string {
  const compact = String(raw || '').replace(/\s+/g, '').trim();
  if (!compact) return '';

  const ref = parseTableRef(compact);
  if (ref.number && (!ref.area || isHallZoneName(ref.area) || isPlaceholderZoneName(ref.area))) {
    return ref.number;
  }

  if (!/^区域\d+$/u.test(compact) || maxCount <= 0) return '';

  let best = '';
  for (let n = 1; n <= maxCount; n++) {
    const s = String(n);
    if (compact.endsWith(s) && s.length >= best.length) {
      best = s;
    }
  }
  return best;
}

function orderMatchesAnyTable(orderTableInfo: any, tableConfig: Array<{ name: string; prefix: string; count: number }>) {
  const orderRef = parseTableRef(orderTableInfo);
  if (!orderRef.key && !orderRef.number) return false;
  const simpleHall = isSimpleHallTableConfig(tableConfig);
  const simpleHallMaxCount = simpleHall ? Math.max(0, Number(tableConfig?.[0]?.count || 0)) : 0;

  for (const zone of tableConfig) {
    for (let i = 1; i <= zone.count; i++) {
      const tableRef = parseTableRef(buildTableValue(zone, i, tableConfig));
      const sameExact = !!(orderRef.key && tableRef.key && orderRef.key === tableRef.key);
      const sameNumberWithCompatibleArea =
        !!(orderRef.number &&
          tableRef.number &&
          orderRef.number === tableRef.number &&
          (orderRef.area === tableRef.area || (!orderRef.area && !tableRef.area)));
      const singleRoomLegacyMatch =
        !!(!tableRef.number && tableRef.area && orderRef.area && tableRef.area === orderRef.area);
      const legacySimpleHallMatch =
        !!(
          simpleHall &&
          tableRef.number &&
          inferLegacySimpleHallNumber(orderTableInfo, simpleHallMaxCount) === tableRef.number
        );
      if (sameExact || sameNumberWithCompatibleArea || singleRoomLegacyMatch || legacySimpleHallMatch) {
        return true;
      }
    }
  }

  return false;
}

function resolveZonePrefix(
  zone: { name?: string; prefix?: string },
  tableConfig: Array<{ name: string; prefix: string; count: number }>,
) {
  const explicit = String(zone?.prefix || '').trim();
  if (explicit) return explicit;

  const name = String(zone?.name || '').trim();
  if (!name) return '';
  if (isSimpleHallTableConfig(tableConfig)) return '';
  if (isHallZoneName(name) || isPlaceholderZoneName(name)) return '';
  return name;
}

function buildTableValue(
  zone: { name?: string; prefix?: string; count?: number },
  index: number,
  tableConfig: Array<{ name: string; prefix: string; count: number }>,
) {
  const base = resolveZonePrefix(zone, tableConfig);
  const n = String(index);
  const count = Math.max(0, Number(zone?.count || 0));
  if (count <= 1) {
    if (base) return base;
    return `${n}号桌`;
  }
  if (base) return `${base}${n}号桌`;
  return `${n}号桌`;
}

function buildTableDisplayLabel(
  zone: { name?: string; prefix?: string; count?: number },
  index: number,
  tableConfig: Array<{ name: string; prefix: string; count: number }>,
) {
  return buildTableValue(zone, index, tableConfig);
}

function isHallZoneName(v: any) {
  const s = String(v || '').trim().toLowerCase();
  const compact = s.replace(/\s+/g, '');
  if (!s) return false;
  return s === '大厅' || s === '大堂' || s === 'hall' || s === 'main hall' || compact === 'mainhall';
}

function isPlaceholderZoneName(v: any) {
  return /^区域\d+$/u.test(String(v || '').trim());
}

function isSimpleHallTableConfig(tableConfig: Array<{ name: string; prefix: string; count: number }>) {
  if (!Array.isArray(tableConfig) || tableConfig.length !== 1) return false;
  const z = tableConfig[0] || { name: '', prefix: '', count: 0 };
  const name = String(z.name || '').trim();
  const prefix = String(z.prefix || '').trim();
  const hallLikeName = !name || isHallZoneName(name) || isPlaceholderZoneName(name);
  const hallLikePrefix = !prefix || isHallZoneName(prefix) || isPlaceholderZoneName(prefix);
  return hallLikeName && hallLikePrefix;
}

const authHeaders = { Authorization: `Bearer ${token}` };

const [statusResp, shopResp, menuResp, ordersResp] = await Promise.all([
  fetchJSON(`${API_BASE_URL}/api/admin/status`, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/info`),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/menu`),
  fetchJSON(`${API_BASE_URL}/api/admin/orders?_=${Date.now()}`, { headers: authHeaders }),
]);

const statusCode = Number(statusResp.status || 0);
const statusIsAuthError = statusCode === 401 || statusCode === 403;

if (statusIsAuthError) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const rawShop = asObject(shopResp.data);
if (!shopResp.ok || !rawShop?.id) {
  return new Response('Not Found', { status: 404 });
}

const statusShopId = Number(statusResp.data?.shop_id || 0);
if (statusResp.ok && statusShopId > 0 && statusShopId !== Number(rawShop.id)) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const shop = {
  ...rawShop,
  id: Number(rawShop.id || 0),
  slug: String(rawShop.slug || slug),
  name: String(rawShop.name || slug),
  settings: typeof rawShop.settings === 'string' ? rawShop.settings : JSON.stringify(rawShop.settings || {}),
  table_config:
    typeof rawShop.table_config === 'string'
      ? rawShop.table_config
      : JSON.stringify(rawShop.table_config || {}),
};

const settings = asObject(parseMaybeJSON(shop.settings));

let resolvedExpireDate =
  shop?.expire_date ||
  shop?.expireDate ||
  settings?.expire_date ||
  settings?.expireDate ||
  '';

if (!resolvedExpireDate && MASTER_TOKEN) {
  const masterResp = await fetchJSON(`${API_BASE_URL}/api/master/init`, {
    headers: { Authorization: `Bearer ${MASTER_TOKEN}` },
  });
  const shops = Array.isArray(masterResp.data?.shops) ? masterResp.data.shops : [];
  const matched = shops.find((s: any) => String(s?.slug || '') === String(shop.slug));
  if (matched?.expire_date) {
    resolvedExpireDate = String(matched.expire_date);
  }
}

const rawMenu = Array.isArray(menuResp.data) ? menuResp.data : [];
const categories = rawMenu.map((c: any) => ({
  id: Number(c?.id || 0),
  name: String(c?.name || ''),
  sub_name: String(c?.sub_name || ''),
  sort_order: Number(c?.sort_order || 0),
}));

const products = rawMenu.flatMap((c: any) => {
  const list = Array.isArray(c?.products) ? c.products : [];
  return list.map((p: any) => ({
    ...p,
    id: Number(p?.id || 0),
    category_id: Number(p?.category_id || c?.id || 0),
    price: Number(p?.price || 0),
    sort_order: Number(p?.sort_order || 0),
    name: String(p?.name || ''),
    sub_name: String(p?.sub_name || ''),
    img: String(p?.img || ''),
  }));
});

const rawOrders = Array.isArray(ordersResp.data) ? ordersResp.data : [];
const orders = rawOrders.map((o: any) => ({
  ...o,
  id: Number(o?.id || 0),
  order_no: String(o?.order_no || o?.id || ''),
  order_type: String(o?.order_type || 'dine_in'),
  status: String(o?.status || 'pending'),
  total_amount: Number(o?.total_amount || 0),
  items_json: normalizeJSONString(o?.items_json, '{}'),
  remarks_json: normalizeJSONString(o?.remarks_json, '[]'),
  table_info: String(o?.table_info || ''),
  user_phone: String(o?.user_phone || ''),
  created_at: String(o?.created_at || ''),
  is_deleted: Number(o?.is_deleted || 0),
}));

const tableConfig = resolveTableConfig(shop, settings);
const firstZoneName = String(tableConfig?.[0]?.name || '').trim();
const firstZonePrefix = String(tableConfig?.[0]?.prefix || '').trim();
const useSimpleHallLabel =
  tableConfig.length === 1 &&
  (!firstZoneName && !firstZonePrefix || isHallZoneName(firstZoneName) || isHallZoneName(firstZonePrefix) || isPlaceholderZoneName(firstZoneName) || isPlaceholderZoneName(firstZonePrefix));
const tableCardsData = buildTableCards(orders, tableConfig);
const unmatchedDineInOrders = orders
  .filter(
    (o: any) =>
      o.order_type === 'dine_in' &&
      o.status !== 'completed' &&
      o.status !== 'cancelled' &&
      o.status !== 'archived' &&
      o.status !== 'paid' &&
      o.is_deleted !== 1,
  )
  .filter((o: any) => !orderMatchesAnyTable(o.table_info, tableConfig));
const activeDeliveryOrders = orders.filter(
  (o: any) =>
    o.order_type === 'delivery' &&
    (o.status === 'pending' || o.status === 'confirmed' || o.status === 'delivering') &&
    o.is_deleted !== 1,
);

const today = new Date();
today.setHours(0, 0, 0, 0);
let daysLeft = 0;
let isExpired = false;
let isWarning = false;
let isNotice = false;
let expireDateStr = '未设置';

if (resolvedExpireDate) {
  const expire = new Date(String(resolvedExpireDate));
  if (!Number.isNaN(expire.getTime())) {
    expire.setHours(0, 0, 0, 0);
    daysLeft = Math.ceil((expire.getTime() - today.getTime()) / 86400000);
    isExpired = daysLeft <= 0;
    isWarning = daysLeft > 0 && daysLeft <= 3;
    isNotice = daysLeft > 3 && daysLeft <= 7;
    expireDateStr = String(resolvedExpireDate).slice(0, 10);
  }
}

const now = new Date();
const prevMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
const prevMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59, 59, 999);
const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);

const commissionType = shop.commission_type === 'percentage' ? 'percentage' : 'per_order';
const commissionValue = Number(shop.commission_value || 30);

const chargeableOrders = orders.filter((o: any) => o.status !== 'cancelled' && o.is_deleted !== 1);
const lastMonthOrders = chargeableOrders.filter((o: any) => {
  const ms = parseDBDateMs(o.created_at);
  return ms >= prevMonthStart.getTime() && ms <= prevMonthEnd.getTime();
});
const thisMonthOrders = chargeableOrders.filter((o: any) => {
  const ms = parseDBDateMs(o.created_at);
  return ms >= thisMonthStart.getTime();
});

const lastMonthCommission =
  commissionType === 'per_order'
    ? lastMonthOrders.length * commissionValue
    : Math.round(lastMonthOrders.reduce((sum: number, o: any) => sum + Number(o.total_amount || 0), 0) * (commissionValue / 100));

const thisMonthCommission =
  commissionType === 'per_order'
    ? thisMonthOrders.length * commissionValue
    : Math.round(thisMonthOrders.reduce((sum: number, o: any) => sum + Number(o.total_amount || 0), 0) * (commissionValue / 100));

const isBillPeriod = now.getDate() <= 6;
const lastMonthKey = prevMonthStart.toISOString().slice(0, 7);
const isLastMonthPaid = String(shop.last_paid_month || '') === lastMonthKey;
const showPayWarning = isBillPeriod && lastMonthCommission > 0 && !isLastMonthPaid;
const lastMonthName = prevMonthStart.getMonth() + 1;

const brokerIp = String(settings.mqtt_broker || 'mqtt.serbia70.com');

let shopCategories = Array.isArray(settings.categories)
  ? settings.categories.filter((c: any) => c && c.id !== 'more')
  : [];
if (shopCategories.length === 0) {
  shopCategories = [
    { id: 'food', name: '外卖美食', icon: '🍔' },
    { id: 'mart', name: '超市便利', icon: '🛒' },
    { id: 'fruit', name: '蔬菜水果', icon: '🍎' },
    { id: 'drink', name: '甜点饮品', icon: '🥤' },
    { id: 'hotel', name: '酒店民宿', icon: '🏨' },
    { id: 'job', name: '招聘求职', icon: '💼' },
    { id: 'service', name: '生活服务', icon: '🔧' },
  ];
}

const cities = {
  Belgrade: ['New Belgrade', 'Zemun', 'Old Town', 'Vracar', 'Palilula', 'Vozdovac'],
  'Novi Sad': ['City Center', 'Liman', 'Detelinara'],
  Nis: ['Mediana', 'Pantelej'],
};
---

<Layout
  title={`后台管理 - ${shop.name}`}
  manifest={`/admin/${safeSlug}/manifest.webmanifest`}
  serviceWorker="/admin-sw.js"
  serviceWorkerScope={`/admin/${safeSlug}`}
  themeColor="#0b3b60"
>
  <script type="application/json" id="cities-data" is:inline>{JSON.stringify(cities)}</script>
  <script type="application/json" id="table-config-data" is:inline>{JSON.stringify(tableConfig)}</script>
  <script type="application/json" id="categories-data" is:inline>{JSON.stringify(categories)}</script>
  <script type="application/json" id="products-data" is:inline>{JSON.stringify(products)}</script>
  <input type="hidden" id="shop-id-hidden" value={String(shop.id)} />

  {
    isExpired ? (
      <div style="background:#d32f2f; color:#fff; padding:15px; text-align:center; position:fixed; top:0; left:0; right:0; z-index:9999;">
        <h3 style="margin:0;">服务已到期</h3>
        <p style="margin:6px 0 0;">请联系管理员续费后恢复服务。</p>
      </div>
    ) : (
      <div style="display:flex; flex-direction:column; gap:5px; margin-bottom:10px;">
        <div
          style={`text-align:center; padding:8px; font-size:13px; font-weight:bold; border-radius:4px; ${
            isWarning
              ? 'background:#ffebee; color:#d32f2f; border:1px solid #ffcdd2;'
              : isNotice
                ? 'background:#fff8e1; color:#f57c00; border:1px solid #ffe0b2;'
                : 'background:#e8f5e9; color:#2e7d32; border:1px solid #c8e6c9;'
          }`}
        >
          {isWarning
            ? `服务即将到期 (剩余 ${daysLeft} 天)`
            : isNotice
              ? `服务到期提醒 (剩余 ${daysLeft} 天) - ${expireDateStr}`
              : `服务有效期至: ${expireDateStr}${resolvedExpireDate ? ` (剩余 ${daysLeft} 天)` : ''}`}
          <span
            id="mqtt-status-indicator"
            style="margin-left:10px; font-size:11px; padding:2px 6px; border-radius:10px; background:#eee; color:#999;"
          >
            MQTT: 连接中...
          </span>
        </div>

        {
          lastMonthCommission > 0 && (
            <div
              style={`text-align:center; padding:10px; font-size:13px; font-weight:bold; border-radius:4px; border:1px solid ${isLastMonthPaid ? '#c8e6c9' : '#b3e5fc'}; background:${isLastMonthPaid ? '#e8f5e9' : '#e1f5fe'}; color:${isLastMonthPaid ? '#2e7d32' : '#0277bd'};`}
            >
              <div style="font-size:15px; margin-bottom:4px;">
                {isLastMonthPaid
                  ? `${lastMonthName} 月已结清: ${lastMonthCommission} RSD`
                  : `${lastMonthName} 月待付佣金: ${lastMonthCommission} RSD`}
              </div>
              {showPayWarning && <div style="margin-top:5px; color:#c62828;">请于 6 号前完成支付</div>}
            </div>
          )
        }
      </div>
    )
  }

  <div id="page-wrapper" style="max-width:1400px; margin:0 auto; width:100%; box-sizing:border-box;">
    <div class="admin-container">
      <AdminHeader shop={shop} restaurantId={slug} />
      <AdminTabs />
      <TabTables tableCardsData={tableCardsData} activeDeliveryOrders={activeDeliveryOrders} unmatchedDineInOrders={unmatchedDineInOrders} useSimpleHallLabel={useSimpleHallLabel} />
      <TabOrders orders={orders} useSimpleHallLabel={useSimpleHallLabel} />
      <TabReservations />
      <TabMenu categories={categories} products={products} shop={shop} />
      <TabSettings
        settings={settings}
        shop={shop}
        shopCategories={shopCategories}
        brokerIp={brokerIp}
        restaurantId={shop.id}
        cities={cities}
      />
      <TabStats />
      <TabData restaurantId={shop.id} />
      <TabPassword />
      <TabRenew
        isWarning={isWarning}
        expireDateStr={expireDateStr}
        daysLeft={daysLeft}
        lastMonthCommission={lastMonthCommission}
        thisMonthCommission={thisMonthCommission}
        isBillPeriod={isBillPeriod}
        showPayWarning={showPayWarning}
        isLastMonthPaid={isLastMonthPaid}
        lastMonthName={lastMonthName}
      />
    </div>
  </div>

  <AdminModals categories={categories} />

  <AdminScripts
    shopId={shop.id}
    shopSlug={shop.slug}
    tableConfig={tableConfig}
    settings={settings}
    brokerIp={brokerIp}
    shop={shop}
  />

  <div id="reject-modal" class="modal-overlay" style="display:none;" onclick="if(event.target === this) window.closeRejectModal()">
    <div class="modal-content" style="max-width:400px; background:#fff; padding:20px; border-radius:8px;">
      <h3 style="margin-top:0; color:#d32f2f;">拒绝订单</h3>
      <p style="color:#666; font-size:14px;">请选择拒绝原因:</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;">
        <button class="reject-reason-btn" onclick="selectRejectReason('已打烊 / Closed')">已打烊</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('缺货/售罄 / Out of stock')">缺货/售罄</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('距离太远 / Too far')">距离太远</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('无法联系 / Cannot contact')">无法联系</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('订单信息错误 / Invalid info')">信息错误</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('其他 / Other')">其他</button>
      </div>
      <textarea id="reject-reason-input" placeholder="请输入具体原因..." style="width:100%; height:80px; padding:10px; border:1px solid #ddd; border-radius:4px; margin-bottom:15px; box-sizing:border-box;"></textarea>
      <input type="hidden" id="reject-order-id" />
      <div style="display:flex; gap:10px;">
        <button onclick="window.closeRejectModal()" style="flex:1; padding:10px; background:#eee; border:none; border-radius:4px; cursor:pointer;">取消</button>
        <button onclick="window.confirmReject()" style="flex:1; padding:10px; background:#f44336; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">确认拒绝</button>
      </div>
    </div>
  </div>

  <style is:inline>
    .reject-reason-btn {
      background: #fff;
      border: 1px solid #ddd;
      padding: 8px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }
    .reject-reason-btn:hover {
      background: #ffebee;
      border-color: #ef9a9a;
    }
    .reject-reason-btn.selected {
      background: #f44336;
      color: #fff;
      border-color: #d32f2f;
    }
  </style>
</Layout>
