---
import Layout from '../../../layouts/Layout.astro';
import { API_BASE_URL, APP_VERSION } from '../../../config';
import { isHallLikeZoneName, isPlaceholderZoneName } from '../../../lib/table-config';
import { orderMatchesAnyConfiguredTable } from '../../../lib/admin-table-ref';
import { asObject, parseMaybeJSON, normalizeJSONString, normalizeRemarkJSONString, resolveTableConfig, buildTableCards, isActiveDineInOrder } from '../../../lib/admin-dashboard-utils';
import { fetchJSON } from '../../../lib/admin-fetch-json';
import { buildAdminOrderChannelBillingView } from '../../../lib/admin-order-channel-billing-view.ts';
import { buildDineInBillingState } from '../../../lib/dine-in-billing.ts';
import { buildAdminTabVisibility, resolveShopTier, type ShopTierView } from '../../../lib/shop-tier.ts';
import { resolveShopDisplaySettings } from '../../../lib/shop-display-settings';
import AdminHeader from '../../../components/admin/AdminHeader.astro';
import AdminTabs from '../../../components/admin/AdminTabs.astro';
import TabOrders from '../../../components/admin/TabOrders.astro';
import TabReservations from '../../../components/admin/TabReservations.astro';
import TabTables from '../../../components/admin/TabTables.astro';
import TabMenu from '../../../components/admin/TabMenu.astro';
import TabSettings from '../../../components/admin/TabSettings.astro';
import TabStats from '../../../components/admin/TabStats.astro';
import TabMarketing from '../../../components/admin/TabMarketing.astro';
import TabCustomers from '../../../components/admin/TabCustomers.astro';
import TabPassword from '../../../components/admin/TabPassword.astro';
import TabRenew from '../../../components/admin/TabRenew.astro';
import AdminModals from '../../../components/admin/AdminModals.astro';
import AdminScripts from '../../../components/admin/AdminScripts.astro';
import '../../../styles/admin-global.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });
const safeSlug = encodeURIComponent(slug);
const adminServiceWorker = import.meta.env.DEV ? undefined : `/admin-sw.js?v=${encodeURIComponent(APP_VERSION)}`;

const token = Astro.cookies.get('admin_token')?.value;
if (!token) {
  const q = Astro.url.search || '';
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login${q}`, 302);
}

const authHeaders = { Authorization: `Bearer ${token}` };

async function loadProtectedMasterSettings(): Promise<Record<string, unknown>> {
  const cookie = Astro.request.headers.get('cookie') || '';
  const adminMasterHeaders: Record<string, string> = { Authorization: `Bearer ${token}` };
  if (cookie) adminMasterHeaders.cookie = cookie;

  const adminSettingsUrl = new URL('/api/admin/settings/master', Astro.url);
  const adminMethod = 'POST';
  const adminMasterRes = await fetch(adminSettingsUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      ...adminMasterHeaders,
    },
    body: '{}',
  }).catch(() => null);

  if (!adminMasterRes?.ok) return {};
  const adminMasterText = await adminMasterRes.text().catch(() => '');
  let adminMasterRaw: unknown = {};
  if (adminMasterText) {
    try {
      adminMasterRaw = JSON.parse(adminMasterText);
    } catch {
      adminMasterRaw = {};
    }
  }
  const adminMasterData = asObject(
    adminMasterRaw && typeof adminMasterRaw === 'object' && 'success' in adminMasterRaw && (adminMasterRaw as { success?: unknown }).success === true
      ? (adminMasterRaw as { data?: unknown; settings?: unknown }).data || (adminMasterRaw as { data?: unknown; settings?: unknown }).settings || adminMasterRaw
      : adminMasterRaw,
  );
  const resolvedAdminSettings = asObject(adminMasterData.settings || adminMasterData);
  resolvedAdminSettings.__adminSettingsDebug = {
    adminMethod,
    adminResponsePreview: adminMasterText.slice(0, 400),
  };
  return resolvedAdminSettings;
}

const ordersApiUrl = new URL(`/api/admin/orders?_=${Date.now()}`, Astro.url);

const [statusResp, shopResp, menuResp, ordersResp, billingResp, homeResp, masterSettings] = await Promise.all([
  fetchJSON(`${API_BASE_URL}/api/admin/status`, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/info`),
  fetchJSON(`${API_BASE_URL}/${encodeURIComponent(slug)}/menu`),
  fetchJSON(ordersApiUrl, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/api/admin/billing`, { headers: authHeaders }),
  fetchJSON(`${API_BASE_URL}/api/home`),
  loadProtectedMasterSettings(),
]);
const homeData = asObject(homeResp.data);

const statusCode = Number(statusResp.status || 0);
const statusIsAuthError = statusCode === 401 || statusCode === 403;

if (statusIsAuthError) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const fallbackHomeShop = Array.isArray(homeData?.shops)
  ? homeData.shops.find((entry: any) => String(entry?.slug || '') === String(slug))
  : null;
const rawShop = asObject(shopResp.data || fallbackHomeShop);

const statusShopId = Number(statusResp.data?.shop_id || 0);
const canonicalShopId = Number(rawShop?.id || fallbackHomeShop?.id || 0);
if (statusResp.ok && statusShopId > 0 && canonicalShopId > 0 && statusShopId !== canonicalShopId) {
  Astro.cookies.delete('admin_token', { path: '/' });
  return Astro.redirect(`/admin/${encodeURIComponent(slug)}/login`, 302);
}

const safeShopId = Number(rawShop?.id || fallbackHomeShop?.id || slug || 0);
const rawTableConfig = rawShop.tableConfig ?? rawShop.table_config;
const shop = {
  ...rawShop,
  id: safeShopId,
  slug: String(rawShop.slug || slug),
  name: String(rawShop.name || slug),
  settings: typeof rawShop.settings === 'string' ? rawShop.settings : JSON.stringify(rawShop.settings || {}),
  table_config:
    typeof rawTableConfig === 'string'
      ? rawTableConfig
      : JSON.stringify(rawTableConfig || {}),
  tableConfig:
    typeof rawTableConfig === 'string'
      ? rawTableConfig
      : JSON.stringify(rawTableConfig || {}),
};

const settings = asObject(parseMaybeJSON(shop.settings));
const adminSettingsDebug = asObject(masterSettings.__adminSettingsDebug);
const masterSettingsDiagnostics = {
  topLevelKeys: Object.keys(masterSettings),
  telegramKeys: Object.keys(asObject(masterSettings.telegram)),
  serverKeys: Object.keys(asObject(masterSettings.server)),
  successValue: masterSettings.success,
  adminMethod: String(adminSettingsDebug.adminMethod || ''),
  adminResponsePreview: String(adminSettingsDebug.adminResponsePreview || ''),
};
const mergedAdminSettings = {
  ...masterSettings,
  ...settings,
  telegram: {
    ...asObject(masterSettings.telegram),
    ...asObject(settings.telegram),
  },
  server: {
    ...asObject(masterSettings.server),
    ...asObject(settings.server),
  },
};
mergedAdminSettings.__debugMasterSettings = masterSettingsDiagnostics;
const resolvedDisplaySettings = resolveShopDisplaySettings(shop, settings, masterSettings);

const billingPlanTier = String(rawShop?.billingPlanType || rawShop?.billing_plan_type || '').trim();
const hasTierMode = String(rawShop?.shopTierMode ?? '').trim() !== '';
const hasTierOverride = String(rawShop?.shopTierOverride ?? '').trim() !== '';
const shopTierView: ShopTierView = resolveShopTier({
  defaultShopTier: mergedAdminSettings.defaultShopTier,
  shopTierMode: hasTierMode || hasTierOverride ? rawShop?.shopTierMode : billingPlanTier ? 'override' : rawShop?.shopTierMode,
  shopTierOverride: hasTierMode || hasTierOverride ? rawShop?.shopTierOverride : billingPlanTier || rawShop?.shopTierOverride,
});
const billingPlanType = shopTierView.effectiveTier;

const shopCommissionMode = String(rawShop?.commissionMode ?? rawShop?.commission_mode ?? '').trim().toLowerCase();
const settingsCommissionMode = String(settings?.commissionMode ?? settings?.commission_mode ?? '').trim().toLowerCase();
const isGlobalCommissionMode = shopCommissionMode === 'global' || (!shopCommissionMode && settingsCommissionMode === 'global');
const resolvedGlobalBillingSettings = isGlobalCommissionMode ? {
  ...masterSettings,
  reservationCommissionType: masterSettings.reservationCommissionType ?? masterSettings.reservation_commission_type ?? masterSettings.subscription_delivery_commission_type,
  reservationCommissionValue: masterSettings.reservationCommissionValue ?? masterSettings.reservation_commission_value ?? masterSettings.subscription_delivery_commission_value,
  deliveryCommissionType: (shopTierView.effectiveTier === 'business' ? masterSettings.business_delivery_commission_type : masterSettings.subscription_delivery_commission_type) ?? masterSettings.deliveryCommissionType ?? masterSettings.delivery_commission_type,
  deliveryCommissionValue: (shopTierView.effectiveTier === 'business' ? masterSettings.business_delivery_commission_value : masterSettings.subscription_delivery_commission_value) ?? masterSettings.deliveryCommissionValue ?? masterSettings.delivery_commission_value,
} : null;
const billingSettings = resolvedGlobalBillingSettings || mergedAdminSettings;

const billingData = asObject(billingResp.data?.billing);
const adminBillingView = buildAdminOrderChannelBillingView({
  billing: billingData,
  shop,
  settings: billingSettings,
});
const billingBalanceRSD = adminBillingView.billingBalanceRsd;
const billingAlertLevel = adminBillingView.balanceReminderLevel;
const dineInBilling = buildDineInBillingState(shop);
const dineInToggleLabel = Number(shop.enableDineIn ?? 1) !== 0 ? '堂食开关：开启' : '堂食开关：关闭';

// 从后端获取真实的营业额（包含已清理的记录）
const lastMonthRevenue = Number(billingData.lastMonthRevenue || 0);
const thisMonthRevenue = Number(billingData.thisMonthRevenue || 0);
const showReservationTab = adminBillingView.reservationPlan.enabled;
const { showStatsTab, showMarketingTab, showCustomersTab } = buildAdminTabVisibility(shopTierView);

const rawMenu = Array.isArray(menuResp.data) ? menuResp.data : [];
const categories = rawMenu.map((c: any) => ({
  id: Number(c?.id || 0),
  name: String(c?.name || ''),
  subName: String(c?.subName || ''),
  sortOrder: Number(c?.sortOrder || 0),
}));

const normalizeMenuImageUrl = (raw: unknown): string => {
  if (typeof raw !== 'string' || raw.trim() === '') return '';
  const img = raw.trim();
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  if (img.startsWith('/uploads/')) return `${API_BASE_URL}${img}`;
  if (img.startsWith('/assets/uploads/')) return `${API_BASE_URL}${img}`;
  return img;
};

const products = rawMenu.flatMap((c: any) => {
  const list = Array.isArray(c?.products) ? c.products : [];
  return list.map((p: any) => ({
    ...p,
    id: Number(p?.id || 0),
    categoryId: Number(p?.categoryId || c?.id || 0),
    price: Number(p?.price || 0),
    sortOrder: Number(p?.sortOrder || 0),
    name: String(p?.name || ''),
    subName: String(p?.subName || ''),
    img: normalizeMenuImageUrl(p?.img || p?.imageUrl),
  }));
});

const ordersLoadFailed = !ordersResp.ok || !Array.isArray(ordersResp.data);
const ordersLoadErrorDetail = String(ordersResp.errorDetail || ordersResp.error || ordersResp.code || ordersResp.status || '').trim();
const rawOrders = Array.isArray(ordersResp.data) ? ordersResp.data : [];
const orders = rawOrders.map((o: any) => ({
  ...o,
  id: Number(o?.id || 0),
  orderNo: String(o?.orderNo || o?.order_no || o?.id || ''),
  orderType: String(o?.orderType || o?.order_type || (String(o?.tableInfo || o?.table_info || '').trim() ? 'dine_in' : '')),
  status: String(o?.status || (String(o?.tableInfo || o?.table_info || '').trim() ? 'pending' : '')),
  totalAmount: Number(o?.totalAmount ?? o?.total_amount ?? 0),
  itemsJson: normalizeJSONString(o?.itemsJson ?? o?.items_json, '{}'),
  remarksJson: normalizeRemarkJSONString(o?.remarksJson ?? o?.remarks_json),
  tableInfo: String(o?.tableInfo || o?.table_info || ''),
  userPhone: String(o?.userPhone || o?.user_phone || ''),
  scheduledFor: String(o?.scheduledFor || o?.scheduled_for || ''),
  pickupEtaMinutes: Number(o?.pickupEtaMinutes ?? o?.pickup_eta_minutes ?? 0),
  pickupReadyAt: String(o?.pickupReadyAt || o?.pickup_ready_at || ''),
  riderBroadcastedAt: String(o?.riderBroadcastedAt || o?.rider_broadcasted_at || ''),
  riderRemindCount: Number(o?.riderRemindCount ?? o?.rider_remind_count ?? 0),
  riderLastRemindedAt: String(o?.riderLastRemindedAt || o?.rider_last_reminded_at || ''),
  riderContactAttemptedAt: String(o?.riderContactAttemptedAt || o?.rider_contact_attempted_at || ''),
  courierName: String(o?.courierName || o?.courier_name || ''),
  courierPhone: String(o?.courierPhone || o?.courier_phone || ''),
  createdAt: String(o?.createdAt || o?.created_at || ''),
  isDeleted: Number(o?.isDeleted ?? o?.is_deleted ?? 0),
}));

const tableConfig = resolveTableConfig(shop, settings);
const firstZoneName = String(tableConfig?.[0]?.name || '').trim();
const firstZonePrefix = String(tableConfig?.[0]?.prefix || '').trim();
const useSimpleHallLabel =
  tableConfig.length === 1 &&
  (!firstZoneName && !firstZonePrefix || isHallLikeZoneName(firstZoneName) || isHallLikeZoneName(firstZonePrefix) || isPlaceholderZoneName(firstZoneName) || isPlaceholderZoneName(firstZonePrefix));
const tableCardsData = buildTableCards(orders, tableConfig);
const unmatchedDineInOrders = orders
  .filter(isActiveDineInOrder)
  .filter((o: any) => !orderMatchesAnyConfiguredTable(o.tableInfo, tableConfig));
const activeDeliveryOrders = orders.filter(
  (o: any) =>
    o.orderType === 'delivery' &&
    (o.status === 'pending' || o.status === 'confirmed' || o.status === 'awaiting_courier' || o.status === 'delivering' || o.status === 'picked_up') &&
    o.isDeleted !== 1,
);

const commissionValue = adminBillingView.deliveryPlan.commissionValue;

// 计算累计消耗
const lastMonthCommission = Math.round(lastMonthRevenue * (commissionValue / 100));
const thisMonthCommission = Math.round(thisMonthRevenue * (commissionValue / 100));

// 如果余额为负，则视为“待付”
const debtAmount = billingBalanceRSD < 0 ? Math.abs(billingBalanceRSD) : 0;

const brokerIp = String(settings.mqttBroker || masterSettings.mqttBroker || masterSettings.mqtt_broker || 'mqtt.serbia70.com');

let shopCategories = Array.isArray(settings.categories)
  ? settings.categories.filter((c: any) => c && c.id !== 'more')
  : [];
if (shopCategories.length === 0) {
  shopCategories = [
    { id: 'food', name: '外卖美食', icon: '🍔' },
    { id: 'mart', name: '超市便利', icon: '🛒' },
    { id: 'fruit', name: '蔬菜水果', icon: '🍎' },
    { id: 'drink', name: '甜点饮品', icon: '🥤' },
    { id: 'hotel', name: '酒店民宿', icon: '🏨' },
    { id: 'job', name: '招聘求职', icon: '💼' },
    { id: 'service', name: '生活服务', icon: '🔧' },
  ];
}

const cities = {
  Belgrade: ['New Belgrade', 'Zemun', 'Old Town', 'Vracar', 'Palilula', 'Vozdovac'],
  'Novi Sad': ['City Center', 'Liman', 'Detelinara'],
  Nis: ['Mediana', 'Pantelej'],
};
---

<Layout
  title={`后台管理 - ${shop.name}`}
  manifest={`/admin/${safeSlug}/manifest.webmanifest`}
  serviceWorker={adminServiceWorker}
  serviceWorkerScope={`/admin/${safeSlug}`}
  themeColor="#0b3b60"
>
  <script type="application/json" id="cities-data" is:inline>{JSON.stringify(cities)}</script>
  <script type="application/json" id="table-config-data" is:inline>{JSON.stringify(tableConfig)}</script>
  <script type="application/json" id="categories-data" is:inline>{JSON.stringify(categories)}</script>
  <script type="application/json" id="products-data" is:inline>{JSON.stringify(products)}</script>
  <input type="hidden" id="shop-id-hidden" value={String(shop.id)} />

  <div style="display:flex; flex-direction:column; gap:5px; margin-bottom:10px;">
    <div style="text-align:center; padding:8px; font-size:13px; font-weight:bold; border-radius:4px; background:#e8f5e9; color:#2e7d32; border:1px solid #c8e6c9;">
      <span id="mqtt-status-indicator" style="margin-left:10px; font-size:11px; padding:2px 6px; border-radius:10px; background:#eee; color:#999;">
        MQTT: 连接中...
      </span>
    </div>

    {
      billingAlertLevel !== 'normal' && (
        <div
          style={`text-align:center; padding:10px; font-size:13px; font-weight:bold; border-radius:4px; border:1px solid ${
            billingAlertLevel === 'overdue'
              ? '#fecaca'
              : billingAlertLevel === 'critical'
                ? '#fecaca'
                : '#fde68a'
          }; background:${
            billingAlertLevel === 'overdue'
              ? '#fef2f2'
              : billingAlertLevel === 'critical'
                ? '#fff1f2'
                : '#fffbeb'
          }; color:${
            billingAlertLevel === 'overdue'
              ? '#7f1d1d'
              : billingAlertLevel === 'critical'
                ? '#991b1b'
                : '#92400e'
          };`}
        >
          {billingAlertLevel === 'overdue'
            ? `欠费宽限中，请尽快充值（余额 ${billingBalanceRSD} RSD）`
            : billingAlertLevel === 'critical'
              ? `余额低于 200 RSD（当前 ${billingBalanceRSD} RSD），请立即充值`
              : `余额低于 1000 RSD（当前 ${billingBalanceRSD} RSD），建议尽快充值`}
        </div>
      )
    }

    {
      lastMonthCommission > 0 && (
        <div
          style="text-align:center; padding:10px; font-size:13px; font-weight:bold; border-radius:4px; border:1px solid #b3e5fc; background:#e1f5fe; color:#0277bd;"
        >
          <div style="font-size:15px; margin-bottom:4px;">上月待付佣金: {lastMonthCommission} RSD</div>
        </div>
      )
    }
  </div>

  <div id="page-wrapper" style="max-width:1400px; margin:0 auto; width:100%; box-sizing:border-box;">
    <div class="admin-container">
      <AdminHeader shop={shop} restaurantId={slug} />
      <AdminTabs showReservationTab={showReservationTab} showStatsTab={showStatsTab} showMarketingTab={showMarketingTab} showCustomersTab={showCustomersTab} />
      <TabTables
        tableCardsData={tableCardsData}
        activeDeliveryOrders={activeDeliveryOrders}
        adminOrdersUnavailable={ordersLoadFailed}
        adminOrdersErrorDetail={ordersLoadErrorDetail}
        unmatchedDineInOrders={unmatchedDineInOrders}
        useSimpleHallLabel={useSimpleHallLabel}
        billingPlanType={billingPlanType}
        dineInBillingExpiresAt={dineInBilling.expiresAt}
        dineInBillingGraceUntil={dineInBilling.graceUntil}
        dineInBillingStatusLabel={dineInBilling.statusLabel}
        dineInToggleLabel={dineInToggleLabel}
      />
      <TabOrders orders={orders} useSimpleHallLabel={useSimpleHallLabel} />
      {showReservationTab && <TabReservations />}
      <TabMenu categories={categories} products={products} shop={shop} />
      <TabSettings
        settings={settings}
        shop={shop}
        shopCategories={shopCategories}
        brokerIp={brokerIp}
        restaurantId={shop.id}
        cities={cities}
        resolvedDisplaySettings={resolvedDisplaySettings}
      />
      {showStatsTab && <TabStats />}
      {showMarketingTab && <TabMarketing shopSlug={slug} shopSettings={settings} />}
      {showCustomersTab && <TabCustomers shopSlug={slug} />}
      <TabPassword />
      <TabRenew
        lastMonthCommission={lastMonthCommission}
        thisMonthCommission={thisMonthCommission}
        debtAmount={debtAmount}
        billingAlertLevel={billingAlertLevel}
        billingBalanceRSD={billingBalanceRSD}
        billingPlanType={billingPlanType}
        walletCopy={adminBillingView.walletCopy}
        walletHint={adminBillingView.walletHint}
        balanceReminderText={adminBillingView.balanceReminderText}
        balanceReminderLevel={adminBillingView.balanceReminderLevel}
        reservationPlan={adminBillingView.reservationPlan}
        deliveryPlan={adminBillingView.deliveryPlan}
      />
    </div>
  </div>

  <AdminModals categories={categories} />

  <div style="display:none;" aria-hidden="true">
    {orders.map((o: any) => (
      <span
        class="hidden-data"
        data-oid={o.id}
        data-order-id={o.id}
        data-order-no={o.orderNo}
        data-items={o.itemsJson}
        data-total={o.totalAmount}
        data-table={o.tableInfo}
        data-status={o.status}
        data-user-phone={o.userPhone}
        data-scheduled-for={o.scheduledFor}
        data-remarks={o.remarksJson}
      ></span>
    ))}
  </div>

  <AdminScripts
    shopId={shop.id}
    shopSlug={shop.slug}
    tableConfig={tableConfig}
    settings={mergedAdminSettings}
    brokerIp={brokerIp}
    shop={shop}
  />

  {import.meta.env.DEV ? (
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            return Promise.all(
              registrations
                .filter(function (registration) { return registration.scope.includes('/admin/'); })
                .map(function (registration) { return registration.unregister(); })
            ).then(function (results) {
              if (results.some(Boolean) && !sessionStorage.getItem('__admin_sw_dev_reload__')) {
                sessionStorage.setItem('__admin_sw_dev_reload__', '1');
                window.location.reload();
              }
            });
          }).catch(function () {});
        });
      }
    </script>
  ) : null}

  <div id="reject-modal" class="modal-overlay" style="display:none;" onclick="if(event.target === this) window.closeRejectModal()">
    <div class="modal-content" style="max-width:400px; background:#fff; padding:20px; border-radius:8px;">
      <h3 style="margin-top:0; color:#d32f2f;">拒绝订单</h3>
      <p style="color:#666; font-size:14px;">请选择拒绝原因:</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;">
        <button class="reject-reason-btn" onclick="selectRejectReason('已打烊 / Closed')">已打烊</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('缺货/售罄 / Out of stock')">缺货/售罄</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('距离太远 / Too far')">距离太远</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('无法联系 / Cannot contact')">无法联系</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('订单信息错误 / Invalid info')">信息错误</button>
        <button class="reject-reason-btn" onclick="selectRejectReason('其他 / Other')">其他</button>
      </div>
      <textarea id="reject-reason-input" placeholder="请输入具体原因..." style="width:100%; height:80px; padding:10px; border:1px solid #ddd; border-radius:4px; margin-bottom:15px; box-sizing:border-box;"></textarea>
      <input type="hidden" id="reject-order-id" />
      <div style="display:flex; gap:10px;">
        <button onclick="window.closeRejectModal()" style="flex:1; padding:10px; background:#eee; border:none; border-radius:4px; cursor:pointer;">取消</button>
        <button onclick="window.confirmReject()" style="flex:1; padding:10px; background:#f44336; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">确认拒绝</button>
      </div>
    </div>
  </div>

  <style is:inline>
    .reject-reason-btn {
      background: #fff;
      border: 1px solid #ddd;
      padding: 8px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }
    .reject-reason-btn:hover {
      background: #ffebee;
      border-color: #ef9a9a;
    }
    .reject-reason-btn.selected {
      background: #f44336;
      color: #fff;
      border-color: #d32f2f;
    }
  </style>
</Layout>
