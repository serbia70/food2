---
import Layout from '../layouts/Layout.astro';
import { API_BASE_URL, MASTER_TOKEN } from '../config';
import PlatformBottomNav from '../components/PlatformBottomNav.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const currentCat = url.searchParams.get('cat') || 'all';
const currentCity = url.searchParams.get('city') || 'Belgrade';
const currentZone = url.searchParams.get('zone') || 'all';

const cities: Record<string, string[]> = {
  Belgrade: ['全部区域', '新贝尔格莱德', '泽蒙', '老城', '弗拉查尔', '帕利卢拉', '沃日多瓦茨'],
  'Novi Sad': ['全部区域', '市中心', '利曼', '代泰利纳拉'],
  Nis: ['全部区域', '梅迪亚纳', '潘泰莱'],
};
const zones = cities[currentCity] || cities.Belgrade;

type ShopView = {
  id: number;
  slug: string;
  name: string;
  logo?: string;
  address: string;
  zone: string;
  city: string;
  category: string;
  delivery_type: 'merchant' | 'platform';
  products: Array<{ name: string; price: number; img?: string }>;
};

let shopsArray: ShopView[] = [];
let categories: any[] = [];
let backendError = '';

try {
  const initRes = await fetch(`${API_BASE_URL}/api/home`);

  if (!initRes.ok) {
    backendError = `后端连接失败: ${initRes.status}`;
  } else {
    const initData = await initRes.json();
    const shops = Array.isArray(initData?.shops) ? initData.shops : [];
    const masterSettings = initData?.settings || {};
    categories = Array.isArray(masterSettings?.categories) ? masterSettings.categories : [];

    shopsArray = (
      await Promise.all(
        shops.map(async (shop: any) => {
          let shopSettings: any = {};
          try {
            shopSettings = JSON.parse(shop.settings || '{}');
          } catch {}

          const city = String(shopSettings.city || currentCity || 'Belgrade');
          const zoneSource = String(shopSettings.delivery?.zones || '');
          const firstZone = zoneSource
            .split(',')
            .map((z: string) => z.trim())
            .filter(Boolean)[0];
          const zone = firstZone || '新贝尔格莱德';

          const logo = shopSettings.logo || '';
          const address =
            String(shop.address || '').trim() ||
            String(shopSettings.address || '').trim() ||
            `${zone}, ${city}`;

          let products: Array<{ name: string; price: number; img?: string }> = [];
          try {
            const menuRes = await fetch(`${API_BASE_URL}/${encodeURIComponent(shop.slug)}/menu`);
            if (menuRes.ok) {
              const menu = await menuRes.json();
              const flat: any[] = [];
              (Array.isArray(menu) ? menu : []).forEach((cat: any) => {
                (cat?.products || []).forEach((p: any) => flat.push(p));
              });
              products = flat.slice(0, 12).map((p) => ({
                name: p?.name || '未命名商品',
                price: Number(p?.price || 0),
                img: p?.img || '/favicon.svg',
              }));
            }
          } catch {}

          return {
            id: Number(shop.id || 0),
            slug: String(shop.slug || ''),
            name: String(shop.name || `店铺 ${shop.slug}`),
            logo,
            address,
            zone,
            city,
            category: String(shopSettings.category || 'food'),
            delivery_type: shopSettings.delivery_type === 'platform' ? 'platform' : 'merchant',
            products,
          } as ShopView;
        }),
      )
    ).filter((s) => !!s.slug);

    if (currentCat !== 'all') {
      shopsArray = shopsArray.filter((s) => s.category === currentCat);
    }
    if (currentCity) {
      shopsArray = shopsArray.filter((s) => s.city === currentCity || s.city === 'Belgrade');
    }
    if (currentZone !== 'all' && currentZone !== '全部区域') {
      shopsArray = shopsArray.filter((s) => s.zone.includes(currentZone));
    }
  }
} catch (e: any) {
  backendError = `后端连接失败: ${e?.message || 'fetch failed'}`;
}

if (!categories || categories.length === 0) {
  categories = [
    { id: 'food', name: '外卖美食', icon: '🍔', color: '#ffca28' },
    { id: 'mart', name: '超市便利', icon: '🛒', color: '#4caf50' },
    { id: 'hotel', name: '酒店民宿', icon: '🏨', color: '#ef5350' },
  ];
}
---

<Layout title="Serbia70 外卖平台">
  <div class="page-container">
    <div
      id="auth-guide-banner"
      style="display:none; background: linear-gradient(90deg, #00b140, #00d250); color: white; padding: 12px 15px; justify-content: space-between; align-items: center; cursor: pointer;"
      onclick="location.href='/user/login?mode=register'"
    >
      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:20px;">⭐</span>
        <div>
          <div style="font-weight:bold; font-size:14px;">欢迎使用外卖平台</div>
          <div style="font-size:11px; opacity:0.9;">Google 账号一键注册，同步订单更方便</div>
        </div>
      </div>
      <div style="background:white; color:#00b140; padding:4px 12px; border-radius:15px; font-size:12px; font-weight:bold;">立即一键注册</div>
    </div>

    <div class="home-header">
      <div class="top-row">
        <div class="city-selector" onclick="toggleCityModal()">
          <span>📍 {currentCity}</span>
          <small>▼</small>
        </div>
        <div class="search-bar">
          <span class="search-icon">🔍</span>
          <input type="text" placeholder="搜索商家、美食..." />
        </div>
      </div>

      <div class="zone-scroll">
        {zones.map((z) => (
          <a
            href={`?city=${currentCity}&zone=${z}&cat=${currentCat}`}
            class={`zone-pill ${currentZone === z || (currentZone === 'all' && z === '全部区域') ? 'active' : ''}`}
          >
            {z}
          </a>
        ))}
      </div>
    </div>

    <div class="category-nav">
      <a href={`?city=${currentCity}&zone=${currentZone}&cat=all`} class="cat-item">
        <div class="cat-icon" style="background:#607d8b;">✨</div>
        <span>全部</span>
      </a>
      {categories.map((c: any) => (
        <a href={`?city=${currentCity}&zone=${currentZone}&cat=${c.id}`} class="cat-item">
          <div class="cat-icon" style={`background:${c.color};`}>{c.icon}</div>
          <span>{c.name}</span>
        </a>
      ))}
    </div>

    <div class="section-title">
      <h3>为你优选</h3>
      <span class="badge">营业中</span>
    </div>

    {backendError && (
      <div style="margin:0 12px 12px; padding:10px 12px; background:#fff1f0; border:1px solid #ffa39e; color:#cf1322; border-radius:8px;">
        {backendError}
      </div>
    )}

    <div class="shop-list">
      {shopsArray.length === 0 && (
        <div class="empty-state">
          <p>暂无商家入驻</p>
          <a href="/merchant/register" class="btn-link">我是商家，立即入驻</a>
        </div>
      )}

      {shopsArray.map((shop) => (
        <a href={`/${shop.slug}`} class="shop-card">
          <div class="shop-header">
            <div class="shop-logo">
              {shop.logo ? (
                <img src={shop.logo} style="width:100%; height:100%; object-fit:cover;" />
              ) : (
                <div style={`width:100%; height:100%; background:hsl(${shop.id * 40}, 70%, 80%); display:flex; align-items:center; justify-content:center; color:#666; font-size:20px; font-weight:bold;`}>
                  {shop.name.charAt(0)}
                </div>
              )}
            </div>
            <div class="shop-info">
              <div class="shop-row-1">
                <div class="shop-name-wrap">
                  <h4 class="shop-name">{shop.name}</h4>
                  <span class="status-badge">营业中</span>
                </div>
              </div>

              <div class="shop-delivery-info">起送 800 | 配送 150 | 满 1500 免</div>

              <div class="shop-row-2">
                <div class="shop-address">📍 {shop.address || shop.zone || shop.city}</div>
                <span class={`delivery-tag ${shop.delivery_type === 'platform' ? 'platform' : 'merchant'}`}>
                  {shop.delivery_type === 'platform' ? '平台' : '商家'}
                </span>
              </div>
            </div>
          </div>

          {shop.products && shop.products.length > 0 && (
            <div class="shop-products">
              {shop.products.map((p) => (
                <div class="prod-thumb">
                  <div class="prod-img-box">
                    <img src={p.img || '/favicon.svg'} alt={p.name} loading="lazy" onerror="this.src='/favicon.svg'" />
                  </div>
                  <div class="prod-name">{p.name}</div>
                  <div class="prod-price">{p.price} RSD</div>
                </div>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </div>

  <PlatformBottomNav active="home" />

  <style>
    .page-container { height: 100vh; overflow-y: auto; padding-bottom: 80px; -webkit-overflow-scrolling: touch; }
    body { background: #f5f5f5; overflow: hidden !important; }
    .home-header { background: #00b140; padding: 10px 15px; position: sticky; top: 0; z-index: 100; }
    .top-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .city-selector { color: white; font-weight: bold; font-size: 14px; display: flex; align-items: center; gap: 4px; cursor: pointer; }
    .search-bar { background: white; border-radius: 20px; padding: 6px 15px; display: flex; align-items: center; gap: 10px; flex: 1; }
    .search-bar input { border: none; outline: none; flex: 1; font-size: 14px; width: 100%; }
    .zone-scroll { display: flex; overflow-x: auto; gap: 10px; padding-bottom: 5px; scrollbar-width: none; -ms-overflow-style: none; }
    .zone-scroll::-webkit-scrollbar { display: none; }
    .zone-pill { background: rgba(255,255,255,.2); color: white; padding: 4px 12px; border-radius: 15px; font-size: 12px; white-space: nowrap; text-decoration: none; }
    .zone-pill.active { background: white; color: #00b140; font-weight: bold; }
    .category-nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding: 20px 15px; background: white; margin-bottom: 10px; }
    .cat-item { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 12px; color: #333; text-decoration: none; }
    .cat-icon { width: 45px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: white; }
    .section-title { padding: 15px; display: flex; align-items: center; justify-content: space-between; }
    .section-title h3 { margin: 0; font-size: 18px; }
    .badge { background: #e8f5e9; color: #2e7d32; padding: 2px 6px; border-radius: 4px; font-size: 10px; }
    .shop-list { padding: 0 10px; }
    .shop-card { display: flex; flex-direction: column; background: white; border-radius: 12px; padding: 12px; margin-bottom: 10px; text-decoration: none; color: inherit; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
    .shop-header { display: flex; gap: 12px; align-items: flex-start; }
    .shop-logo { width: 60px; height: 60px; border-radius: 8px; overflow: hidden; flex-shrink: 0; }
    .shop-info { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 0; min-height: 60px; }
    .shop-row-1 { display: flex; align-items: center; gap: 8px; }
    .shop-name-wrap { display: flex; align-items: center; gap: 6px; min-width: 0; flex: 1; }
    .shop-name { margin: 0; font-size: 16px; font-weight: bold; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .status-badge { border: 1px solid #00b140; color: #00b140; font-size: 10px; padding: 0 3px; border-radius: 2px; white-space: nowrap; flex-shrink: 0; height: 16px; line-height: 14px; }
    .shop-delivery-info { font-size: 11px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .shop-row-2 { display: flex; justify-content: space-between; align-items: center; }
    .shop-address { font-size: 12px; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; margin-right: 8px; }
    .delivery-tag { padding: 1px 4px; border-radius: 3px; font-size: 10px; white-space: nowrap; flex-shrink: 0; }
    .delivery-tag.merchant { background: #fff3e0; color: #e65100; border: 1px solid #ffe0b2; }
    .delivery-tag.platform { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
    .shop-products { display: flex; gap: 10px; flex-wrap: nowrap; overflow-x: auto; height: auto; padding: 12px 4px; margin-top: 8px; border-top: 1px solid #f5f5f5; scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
    .shop-products::-webkit-scrollbar { display: none; }
    .prod-thumb { width: 85px; flex-shrink: 0; display: flex; flex-direction: column; gap: 4px; }
    .prod-img-box { width: 85px; height: 85px; border-radius: 8px; overflow: hidden; background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
    .prod-img-box img { width: 100%; height: 100%; object-fit: cover; }
    .prod-name { font-size: 11px; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .prod-price { font-size: 12px; color: #ff5722; font-weight: bold; }
    .empty-state { text-align: center; padding: 40px; color: #999; }
    .btn-link { color: #00b140; font-weight: bold; }
  </style>

  <script is:inline>
    const userStorage = localStorage.getItem('food_order_user') || localStorage.getItem('user_info');
    const banner = document.getElementById('auth-guide-banner');
    if (!userStorage && banner) banner.style.display = 'flex';

    function toggleCityModal() {
      const cityList = ['Belgrade', 'Novi Sad', 'Nis'];
      const pageUrl = new URL(window.location.href);
      const current = pageUrl.searchParams.get('city') || 'Belgrade';
      const next = cityList[(cityList.indexOf(current) + 1) % cityList.length];
      pageUrl.searchParams.set('city', next);
      pageUrl.searchParams.set('zone', 'all');
      window.location.href = pageUrl.toString();
    }
  </script>
</Layout>
