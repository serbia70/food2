---
import MasterCreateShopCard from '../../components/master/MasterCreateShopCard.astro';
import MasterCategoriesSettingsCard from '../../components/master/MasterCategoriesSettingsCard.astro';
import MasterFooterSettingsCard from '../../components/master/MasterFooterSettingsCard.astro';
import MasterOverview from '../../components/master/MasterOverview.astro';
import MasterPaymentSettingsCard from '../../components/master/MasterPaymentSettingsCard.astro';
import MasterPricingSettingsCard from '../../components/master/MasterPricingSettingsCard.astro';
import MasterRateSettingsCard from '../../components/master/MasterRateSettingsCard.astro';
import MasterSecurityCard from '../../components/master/MasterSecurityCard.astro';
import MasterServerSettingsCard from '../../components/master/MasterServerSettingsCard.astro';
import MasterStorageSettingsCard from '../../components/master/MasterStorageSettingsCard.astro';
import MasterBackupSettingsCard from '../../components/master/MasterBackupSettingsCard.astro';
import MasterCodeBackupCard from '../../components/master/MasterCodeBackupCard.astro';
import MasterDataBackupCard from '../../components/master/MasterDataBackupCard.astro';
import MasterShopEditPanel from '../../components/master/MasterShopEditPanel.astro';
import MasterShopManagementTable from '../../components/master/MasterShopManagementTable.astro';
import MasterShopTopupPanel from '../../components/master/MasterShopTopupPanel.astro';
import MasterWechatSettingsCard from '../../components/master/MasterWechatSettingsCard.astro';
import { MASTER_TOKEN } from '../../config';
import { normalizeMasterTab } from '../../lib/master-active-tab';
import { buildEditShopSuccessMessage } from '../../lib/master-edit-feedback';
import { formatCommissionRule } from '../../lib/master-commission-view';
import { resolveMasterAuth } from '../../lib/master-auth';
import { buildMasterSettingsView } from '../../lib/master-settings-view';
import { buildMasterShopView } from '../../lib/master-shop-view';

export const prerender = false;

if (!Astro.cookies.get('master_token')?.value) {
  return Astro.redirect('/master/login', 302);
}

type ShopSummary = {
  id?: number;
  name?: string;
  slug?: string;
  billing_status?: string;
  today_revenue?: number;
  today_order_count?: number;
  delivery_revenue?: number;
  delivery_order_count?: number;
  dine_in_revenue?: number;
  dine_in_order_count?: number;
  commission_month_rsd?: number;
  commission_total_rsd?: number;
  unsettled_commission_rsd?: number;
  billing_balance_rsd?: number;
  avg_order_amount?: number;
  total_order_count?: number;
};

let shops: ShopSummary[] = [];
let loadError = '';
let masterSettings: Record<string, any> = {};

const MASTER_INIT_PROXY_PATH = '/api/master/init';
const MASTER_INIT_COOKIE_HEADER = 'cookie';

try {
  const auth = resolveMasterAuth(Astro.request, Astro.cookies, MASTER_TOKEN, { allowFallbackToken: false });
  const cookie = Astro.request.headers.get(MASTER_INIT_COOKIE_HEADER) || '';
  const initUrl = new URL(MASTER_INIT_PROXY_PATH, Astro.url);
  const res = await fetch(initUrl, {
    method: 'GET',
    headers: {
      ...(auth ? { Authorization: auth } : {}),
      ...(cookie ? { cookie } : {}),
    },
  });
  if (res.ok) {
    const data = await res.json().catch(() => ({}));
    shops = Array.isArray(data?.shops) ? data.shops : [];
    masterSettings = data?.settings && typeof data.settings === 'object' ? data.settings : {};
  } else {
    loadError = `加载失败 (${res.status})`;
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : '加载失败';
}

const hasMasterCookie = Boolean(Astro.cookies.get('master_token')?.value);
const isUnauthorized = loadError === '加载失败 (401)';
const activeTab = normalizeMasterTab(Astro.url.searchParams.get('tab'));
const canLoadProtectedMasterActions = hasMasterCookie && !isUnauthorized;
const shouldShowMasterContent = !loadError;

const totals = shops.reduce(
  (acc, shop) => {
    acc.totalShops += 1;
    acc.todayRevenue += Number(shop.today_revenue || 0);
    acc.todayOrders += Number(shop.today_order_count || 0);
    acc.monthCommission += Number(shop.commission_month_rsd || 0);
    acc.totalBalance += Number(shop.billing_balance_rsd || 0);
    return acc;
  },
  {
    totalShops: 0,
    todayRevenue: 0,
    todayOrders: 0,
    monthCommission: 0,
    totalBalance: 0,
  },
);

const shopViews = shops.map((shop) => buildMasterShopView(shop));
const settingsView = buildMasterSettingsView(masterSettings);
const shopViewsData = JSON.stringify(shopViews);

type MasterCta =
  | { key: 'login'; kind: 'link'; label: string; href: string; className: string }
  | { key: 'logout' | 'refresh'; kind: 'button'; label: string; onClick: string; className: string };

const MASTER_CTA = {
  login: (label: string, className = 'primary-btn'): MasterCta => ({
    key: 'login',
    kind: 'link',
    label,
    href: '/master/login',
    className,
  }),
  logout: (className = 'ghost-btn'): MasterCta => ({
    key: 'logout',
    kind: 'button',
    label: '退出',
    onClick: 'logoutMaster()',
    className,
  }),
  refresh: (className = 'ghost-btn'): MasterCta => ({
    key: 'refresh',
    kind: 'button',
    label: '刷新页面',
    onClick: 'window.location.reload()',
    className,
  }),
} as const;

const heroCtas: MasterCta[] = [
  MASTER_CTA.login(hasMasterCookie ? '重新登录' : '登录'),
  ...(hasMasterCookie ? [MASTER_CTA.logout('danger-btn')] : []),
  MASTER_CTA.refresh(),
];

const noticeCtas: MasterCta[] = [MASTER_CTA.login('去登录'), MASTER_CTA.logout(), MASTER_CTA.refresh()];

const escapeHtml = (input: string) =>
  input
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const renderMasterCtasHtml = (ctas: MasterCta[]) =>
  ctas
    .map((cta) => {
      const label = escapeHtml(cta.label);
      const className = escapeHtml(cta.className);
      if (cta.kind === 'link') {
        const href = escapeHtml(cta.href);
        return `<a class="${className}" href="${href}">${label}</a>`;
      }
      const onClick = escapeHtml(cta.onClick);
      return `<button class="${className}" type="button" onclick="${onClick}">${label}</button>`;
    })
    .join('');

const heroCtasHtml = renderMasterCtasHtml(heroCtas);
const noticeCtasHtml = renderMasterCtasHtml(noticeCtas);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Master Dashboard</title>
    <style>
      :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
        color: var(--text);
      }

      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 20px 48px;
      }

      .hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 24px;
      }

      .hero-title {
        font-size: 34px;
        font-weight: 900;
        line-height: 1.05;
        margin: 0;
      }

      .hero-subtitle {
        margin-top: 8px;
        color: var(--muted);
        font-size: 14px;
      }

      .ghost-btn {
        border: 1px solid #cbd5e1;
        background: rgba(255,255,255,.82);
        color: #0f172a;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
      }

      .primary-btn {
        border: 1px solid #0f172a;
        background: #0f172a;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 800;
        text-decoration: none;
      }

      .danger-btn {
        border: 1px solid #ef4444;
        background: #fff5f5;
        color: #b91c1c;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 800;
      }

      .notice {
        border: 1px dashed #cbd5e1;
        background: rgba(255,255,255,.78);
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        color: var(--muted);
      }

      .notice-actions {
        margin-top: 16px;
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .tab-btn {
        border: 1px solid #d4dbe4;
        background: #e2e8f0;
        color: #334155;
        padding: 10px 16px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 800;
      }

      .tab-btn.active {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
      }

      .master-stack {
        display: grid;
        gap: 18px;
      }

      .master-stack[hidden],
      .settings-grid[hidden] {
        display: none !important;
      }

      .settings-grid {
        display: grid;
        gap: 18px;
      }
    </style>
    <script define:vars={{ shopViewsData, canLoadProtectedMasterActions }} is:inline>
      function isUnauthorizedResponse(res, data) {
        return res?.status === 401 || data?.error === 'unauthorized';
      }

      async function handleMasterUnauthorized() {
        try {
          await fetch('/api/master/logout', { method: 'POST' });
        } catch {}
        window.location.href = '/master/login';
      }

      async function handleCreateShop(form) {
        const feedback = document.getElementById('master-create-shop-feedback');
        const submitBtn = form?.querySelector('button[type="submit"]');
        if (!(feedback instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) return;

        const formData = new FormData(form);
        const payload = {
          name: String(formData.get('name') || '').trim(),
          slug: String(formData.get('slug') || '').trim(),
          password: String(formData.get('password') || '').trim(),
        };

        feedback.textContent = '创建中...';
        submitBtn.disabled = true;

        try {
          const res = await fetch('/api/master/shops', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (isUnauthorizedResponse(res, data)) {
            await handleMasterUnauthorized();
            return;
          }
          if (!res.ok || data?.success === false) {
            feedback.textContent = data?.error || '创建失败，请检查字段或后端能力';
            submitBtn.disabled = false;
            return;
          }
          feedback.textContent = '创建请求已提交，建议刷新页面确认新店铺是否已出现。';
          form.reset();
        } catch (error) {
          feedback.textContent = '创建失败，请稍后重试';
        }

        submitBtn.disabled = false;
      }

      window.submitMasterCreateShop = function (form) {
        handleCreateShop(form);
        return false;
      };

      async function handlePricingSettings(form) {
        const feedback = document.getElementById('master-pricing-settings-feedback');
        const submitBtn = form?.querySelector('button[type="submit"]');
        if (!(feedback instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) return;

        const formData = new FormData(form);
        const payload = {
          subscriptionFeeRsd: Number(formData.get('subscriptionFeeRsd') || 0),
          businessFeeRsd: Number(formData.get('businessFeeRsd') || 0),
          subscriptionDeliveryCommissionType: String(formData.get('subscriptionCommissionType') || 'percentage'),
          subscriptionDeliveryCommissionValue: Number(formData.get('subscriptionCommissionValue') || 0),
          businessDeliveryCommissionType: String(formData.get('businessCommissionType') || 'percentage'),
          businessDeliveryCommissionValue: Number(formData.get('businessCommissionValue') || 0),
        };

        feedback.textContent = '保存中...';
        submitBtn.disabled = true;

        try {
          const res = await fetch('/api/master/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (isUnauthorizedResponse(res, data)) {
            await handleMasterUnauthorized();
            return;
          }
          feedback.textContent = !res.ok || data?.success === false ? data?.error || '保存失败，请检查后端支持范围' : '套餐与提成设置已保存';
        } catch {
          feedback.textContent = '保存失败，请稍后重试';
        }

        submitBtn.disabled = false;
      }

      window.submitMasterPricingSettings = function (form) {
        handlePricingSettings(form);
        return false;
      };

      async function submitSettingsAction(form, config) {
        const feedback = document.getElementById(config.feedbackId);
        const submitBtn = form?.querySelector('button[type="submit"]');
        if (!(feedback instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) return;

        feedback.textContent = config.loadingText || '保存中...';
        submitBtn.disabled = true;

        try {
          const payload = config.buildPayload(form);
          const res = await fetch(config.endpoint || '/api/master/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (isUnauthorizedResponse(res, data)) {
            await handleMasterUnauthorized();
            return;
          }
          if (!res.ok || data?.success === false) {
            feedback.textContent = data?.error || config.errorText || '保存失败，请检查后端支持范围';
            submitBtn.disabled = false;
            return;
          }
          feedback.textContent = config.successText || '保存成功';
        } catch {
          feedback.textContent = config.networkErrorText || '保存失败，请稍后重试';
        }

        submitBtn.disabled = false;
      }

      function readNumberField(formData, key, label) {
        const value = Number(formData.get(key));
        if (!Number.isFinite(value)) {
          throw new Error(`${label}必须是数字`);
        }
        return value;
      }

      function setFeedback(feedbackId, message) {
        const feedback = document.getElementById(feedbackId);
        if (feedback instanceof HTMLElement) {
          feedback.textContent = message;
        }
      }

      function setStatusFeedback(feedbackId, message, status = 'muted') {
        const feedback = document.getElementById(feedbackId);
        if (!(feedback instanceof HTMLElement)) return;
        feedback.textContent = message;
        feedback.dataset.status = status;
      }

      window.submitMasterCategoriesSettings = async function (form) {
        const feedbackId = 'master-categories-settings-feedback';
        try {
          const formData = new FormData(form);
          const rawJson = String(formData.get('categoriesJson') || '').trim();
          const categories = JSON.parse(rawJson || '[]');
          setFeedback(feedbackId, '保存分类配置中...');
          const res = await fetch('/api/master/categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(categories),
          });
          const data = await res.json().catch(() => ({}));
          setFeedback(feedbackId, !res.ok || data?.success === false ? data?.error || '分类配置保存失败' : '分类配置已保存');
        } catch (error) {
          setFeedback(feedbackId, error instanceof Error ? `分类 JSON 无效：${error.message}` : '分类 JSON 无效');
        }
        return false;
      };

      window.submitMasterServerSettings = async function (form) {
        await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-server-settings-feedback',
          loadingText: '保存 MQTT 配置中...',
          successText: 'MQTT 配置已保存',
          buildPayload(currentForm) {
            const formData = new FormData(currentForm);
            return {
              mqttBroker: String(formData.get('mqttBroker') || '').trim(),
            };
          },
        });
        return false;
      };

      window.submitMasterFooterSettings = async function (form) {
        await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-footer-settings-feedback',
          loadingText: '保存页脚设置中...',
          successText: '页脚设置已保存',
          buildPayload(currentForm) {
            const formData = new FormData(currentForm);
            return {
              footerText: String(formData.get('footerText') || '').trim(),
              footerPhone: String(formData.get('footerPhone') || '').trim(),
              footerCopyright: String(formData.get('footerCopyright') || '').trim(),
            };
          },
        });
        return false;
      };

      window.submitMasterRateSettings = async function (form) {
        const feedback = document.getElementById('master-rate-settings-feedback');
        try {
          await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-rate-settings-feedback',
            loadingText: '保存汇率与费率中...',
            successText: '汇率与费率设置已保存',
            buildPayload(currentForm) {
              const formData = new FormData(currentForm);
              return {
                exchange_rate: readNumberField(formData, 'exchangeRate', '汇率'),
                display_final_rate: readNumberField(formData, 'displayFinalRate', '展示最终费率'),
                rate_base: readNumberField(formData, 'rateBase', '基础费率'),
                rate_offset: readNumberField(formData, 'rateOffset', '费率偏移'),
                rate_step: readNumberField(formData, 'rateStep', '费率步进'),
              };
            },
          });
        } catch (error) {
          if (feedback instanceof HTMLElement) {
            feedback.textContent = error instanceof Error ? error.message : '数值校验失败';
          }
        }
        return false;
      };

      window.submitMasterWechatSettings = async function (form) {
        await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-wechat-settings-feedback',
          loadingText: '保存微信联系设置中...',
          successText: '微信联系设置已保存',
          buildPayload(currentForm) {
            const formData = new FormData(currentForm);
            return {
              wechatId: String(formData.get('wechatId') || '').trim(),
              wechat_contact_qr: String(formData.get('wechatContactQr') || '').trim(),
            };
          },
        });
        return false;
      };

      window.submitMasterPaymentSettings = async function (form) {
        await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-payment-settings-feedback',
          loadingText: '保存收款码设置中...',
          successText: '收款码设置已保存',
          buildPayload(currentForm) {
            const formData = new FormData(currentForm);
            return {
              alipay_payment_qr: String(formData.get('alipayPaymentQr') || '').trim(),
              wechat_payment_qr: String(formData.get('wechatPaymentQr') || '').trim(),
            };
          },
        });
        return false;
      };

      window.submitMasterStorageSettings = async function (form) {
        await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-storage-settings-feedback',
          loadingText: '保存图片 / R2 设置中...',
          successText: '图片 / R2 设置已保存',
          buildPayload(currentForm) {
            const formData = new FormData(currentForm);
            return {
              imageStorage: String(formData.get('imageStorage') || 'local').trim(),
              r2PublicDomain: String(formData.get('r2PublicDomain') || '').trim(),
              uploadStrictR2: formData.get('uploadStrictR2') === 'on',
            };
          },
        });
        return false;
      };

      window.triggerMasterUpload = async function (fieldName) {
        if (!fieldName) return;
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        input.onchange = async () => {
          const file = input.files?.[0];
          if (!file) return;

          const formData = new FormData();
          formData.append('file', file);
          const field = document.querySelector(`[name="${fieldName}"]`);
          const button = document.querySelector(`[onclick*="'${fieldName}'"]`);

          if (button instanceof HTMLButtonElement) {
            button.disabled = true;
            button.textContent = '上传中';
          }

          try {
            const res = await fetch('/api/master/upload', {
              method: 'POST',
              body: formData,
            });
            const data = await res.json().catch(() => ({}));
            if (isUnauthorizedResponse(res, data)) {
              await handleMasterUnauthorized();
              return;
            }
            if (!res.ok || !data?.success || !data?.url) {
              alert(data?.error || '上传失败');
              return;
            }
            if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
              field.value = data.url;
            }
            alert('上传成功，已回填地址');
          } catch {
            alert('上传失败，请稍后重试');
          } finally {
            if (button instanceof HTMLButtonElement) {
              button.disabled = false;
              button.textContent = '上传';
            }
          }
        };
        input.click();
      };

      function syncBackupMode(source) {
        const root = source?.closest('form') || document;
        const target = source instanceof HTMLSelectElement ? source.value : '';
        root.querySelectorAll('[data-backup-mode]').forEach((section) => {
          if (!(section instanceof HTMLElement)) return;
          const mode = section.getAttribute('data-backup-mode');
          if (mode === 's3') {
            section.hidden = target !== 's3';
          } else if (mode === 'host') {
            section.hidden = target === 's3';
          }
        });
      }

      window.submitMasterBackupSettings = async function (form) {
        const feedback = document.getElementById('master-backup-settings-feedback');
        try {
          await submitSettingsAction(form, {
            endpoint: '/api/master/settings',
            feedbackId: 'master-backup-settings-feedback',
            loadingText: '保存备份设置中...',
            successText: '备份设置已保存',
            buildPayload(currentForm) {
              const formData = new FormData(currentForm);
              const backupTarget = String(formData.get('backupTarget') || '').trim();
              const backupRetention = readNumberField(formData, 'backupRetention', '保留数量');
              if (backupRetention < 1) {
                throw new Error('保留数量不能小于 1');
              }
              const payload = {
                backupTime: String(formData.get('backupTime') || '').trim(),
                backupRetention,
                backupTarget,
                backupHost: String(formData.get('backupHost') || '').trim(),
                backupUser: String(formData.get('backupUser') || '').trim(),
                backupPass: String(formData.get('backupPass') || '').trim(),
                backupPath: String(formData.get('backupPath') || '').trim(),
                backupEndpoint: String(formData.get('backupEndpoint') || '').trim(),
                backupBucket: String(formData.get('backupBucket') || '').trim(),
              };
              if (backupTarget === 's3' && (!payload.backupEndpoint || !payload.backupBucket)) {
                throw new Error('S3 模式下必须填写 Endpoint 和 Bucket');
              }
              return payload;
            },
          });
        } catch (error) {
          if (feedback instanceof HTMLElement) {
            feedback.textContent = error instanceof Error ? error.message : '备份设置校验失败';
          }
        }
        return false;
      };

      function validateRestoreFilename(name) {
        return typeof name === 'string' && name.trim().length > 0;
      }

      function normalizeCodeBackups(input) {
        if (!Array.isArray(input)) return [];
        return input
          .map((item) => {
            if (!item || typeof item !== 'object') return null;
            const name = typeof item.name === 'string' ? item.name.trim() : '';
            const displayName = typeof item.displayName === 'string' ? item.displayName.trim() : name;
            const created = typeof item.created === 'string' ? item.created.trim() : '';
            if (!name || !displayName || !created) return null;
            return { name, displayName, created };
          })
          .filter(Boolean);
      }

      function renderMasterCodeBackupList(backups) {
        const list = document.getElementById('master-code-backup-list');
        if (!(list instanceof HTMLElement)) return;

        if (!Array.isArray(backups) || backups.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'backup-empty';
          empty.textContent = '暂无代码备份';
          list.replaceChildren(empty);
          return;
        }

