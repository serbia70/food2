---
import MasterCreateShopCard from '../../components/master/MasterCreateShopCard.astro';
import MasterCategoriesSettingsCard from '../../components/master/MasterCategoriesSettingsCard.astro';
import MasterFooterSettingsCard from '../../components/master/MasterFooterSettingsCard.astro';
import MasterOverview from '../../components/master/MasterOverview.astro';
import MasterPaymentSettingsCard from '../../components/master/MasterPaymentSettingsCard.astro';
import MasterPricingSettingsCard from '../../components/master/MasterPricingSettingsCard.astro';
import MasterRateSettingsCard from '../../components/master/MasterRateSettingsCard.astro';
import MasterSecurityCard from '../../components/master/MasterSecurityCard.astro';
import MasterServerSettingsCard from '../../components/master/MasterServerSettingsCard.astro';
import MasterStorageSettingsCard from '../../components/master/MasterStorageSettingsCard.astro';
import MasterBackupSettingsCard from '../../components/master/MasterBackupSettingsCard.astro';
import MasterCodeBackupCard from '../../components/master/MasterCodeBackupCard.astro';
import MasterDataBackupCard from '../../components/master/MasterDataBackupCard.astro';
import MasterDangerConfirm from '../../components/master/MasterDangerConfirm.astro';
import MasterShopEditPanel from '../../components/master/MasterShopEditPanel.astro';
import MasterShopManagementTable from '../../components/master/MasterShopManagementTable.astro';
import MasterShopTopupPanel from '../../components/master/MasterShopTopupPanel.astro';
import MasterShopDineInPanel from '../../components/master/MasterShopDineInPanel.astro';
import MasterWechatSettingsCard from '../../components/master/MasterWechatSettingsCard.astro';
import { MASTER_TOKEN } from '../../config';
import { normalizeMasterTab } from '../../lib/master-active-tab';
import { resolveMasterAuth } from '../../lib/master-auth';
import { buildMasterDashboardView } from '../../lib/master-dashboard-view';

export const prerender = false;

const masterTokenCookie = Astro.cookies.get('master_token');
if (!(masterTokenCookie && masterTokenCookie.value)) {
  return Astro.redirect('/master/login', 302);
}

type ShopSummary = {
  id?: number;
  name?: string;
  slug?: string;
  billing_status?: string;
  today_revenue?: number;
  today_order_count?: number;
  delivery_revenue?: number;
  delivery_order_count?: number;
  dine_in_revenue?: number;
  dine_in_order_count?: number;
  commission_month_rsd?: number;
  commission_total_rsd?: number;
  unsettled_commission_rsd?: number;
  billing_balance_rsd?: number;
  avg_order_amount?: number;
  total_order_count?: number;
};

let shops: ShopSummary[] = [];
let loadError = '';
let masterSettings: Record<string, unknown> = {};

const MASTER_INIT_PROXY_PATH = '/api/master/init';
const MASTER_INIT_COOKIE_HEADER = 'cookie';

try {
  const auth = resolveMasterAuth(Astro.request, Astro.cookies, MASTER_TOKEN, { allowFallbackToken: false });
  const cookie = Astro.request.headers.get(MASTER_INIT_COOKIE_HEADER) || '';
  const initUrl = new URL(MASTER_INIT_PROXY_PATH, Astro.url);
  const res = await fetch(initUrl, {
    method: 'GET',
    headers: {
      ...(auth ? { Authorization: auth } : {}),
      ...(cookie ? { cookie } : {}),
    },
  });
  if (res.ok) {
    const data = await res.json().catch(() => ({}));
    const dataShops = data && data.shops;
    shops = Array.isArray(dataShops) ? dataShops : [];
    const dataSettings = data && data.settings;
    masterSettings = dataSettings && typeof dataSettings === 'object' ? dataSettings : {};
  } else {
    loadError = `加载失败 (${res.status})`;
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : '加载失败';
}

const masterCookie = Astro.cookies.get('master_token');
const hasMasterCookie = Boolean(masterCookie && masterCookie.value);
const isUnauthorized = loadError === '加载失败 (401)';
const activeTab = normalizeMasterTab(Astro.url.searchParams.get('tab'));
const canLoadProtectedMasterActions = hasMasterCookie && !isUnauthorized;

const dashboardView = buildMasterDashboardView({
  shops,
  settings: masterSettings,
  activeTab,
  isUnauthorized,
  loadError,
});
const shopViewsData = JSON.stringify(dashboardView.shopManagement.shops);
const shopEditPanelData = JSON.stringify(dashboardView.panels.shopEdit);
const shopTopupPanelData = JSON.stringify(dashboardView.panels.shopTopup);
const shopDineInPanelData = JSON.stringify(dashboardView.panels.shopDineIn);

const shouldShowMasterContent = dashboardView.pageState.kind === 'ready';
const hasDashboardNotices = dashboardView.notices.length > 0;
const activeNotice = hasDashboardNotices ? dashboardView.notices[0] : null;
const dashboardActions = dashboardView.actions;
const heroActions =
  dashboardView.pageState.kind === 'ready'
    ? [
        { key: 'login', kind: 'link' as const, label: hasMasterCookie ? '重新登录' : '登录', href: '/master/login', className: 'primary-btn' },
        ...(hasMasterCookie
          ? [{ key: 'logout', kind: 'button' as const, label: '退出', handler: 'logoutMaster' as const, className: 'danger-btn' }]
          : []),
        { key: 'refresh', kind: 'button' as const, label: '刷新页面', handler: 'reloadPage' as const, className: 'ghost-btn' },
      ]
    : dashboardActions;

const NOTICE_KIND_CLASSNAME: Record<'info' | 'warning' | 'error', string> = {
  info: 'notice-info',
  warning: 'notice-warning',
  error: 'notice-error',
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Master Dashboard</title>
    <style>
      :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
        color: var(--text);
      }

      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 20px 48px;
      }

      .hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 24px;
      }

      .hero-title {
        font-size: 34px;
        font-weight: 900;
        line-height: 1.05;
        margin: 0;
      }

      .hero-subtitle {
        margin-top: 8px;
        color: var(--muted);
        font-size: 14px;
      }

      .ghost-btn {
        border: 1px solid #cbd5e1;
        background: rgba(255,255,255,.82);
        color: #0f172a;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
      }

      .primary-btn {
        border: 1px solid #0f172a;
        background: #0f172a;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 800;
        text-decoration: none;
      }

      .danger-btn {
        border: 1px solid #ef4444;
        background: #fff5f5;
        color: #b91c1c;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 800;
      }

      .notice {
        border: 1px dashed #cbd5e1;
        background: rgba(255,255,255,.78);
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        color: var(--muted);
      }

      .notice-warning {
        border-color: #f59e0b;
        background: #fffbeb;
        color: #92400e;
      }

      .notice-error {
        border-color: #ef4444;
        background: #fff5f5;
        color: #991b1b;
      }

      .notice-actions {
        margin-top: 16px;
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .tab-btn {
        border: 1px solid #d4dbe4;
        background: #e2e8f0;
        color: #334155;
        padding: 10px 16px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 800;
      }

      .tab-btn.active {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
      }

      .master-stack {
        display: grid;
        gap: 18px;
      }

      .master-stack[hidden],
      .settings-grid[hidden] {
        display: none !important;
      }

      .settings-grid {
        display: grid;
        gap: 18px;
      }
    </style>
    <script define:vars={{ shopViewsData, shopEditPanelData, shopTopupPanelData, shopDineInPanelData, canLoadProtectedMasterActions }} is:inline>
      window.__masterRuntime = {
        shopViewsData,
        shopEditPanelData,
        shopTopupPanelData,
        shopDineInPanelData,
        canLoadProtectedMasterActions,
      };
    </script>
    <script>
      import { buildEditShopSuccessMessage } from '../../lib/master-edit-feedback';
      import { buildMasterPricingSettingsPayload } from '../../lib/master-pricing-settings-payload';
      import {
  buildMasterShopEditPayload,
  MASTER_SHOP_FEE_FALLBACKS,
  resetMasterShopFeeOverrides,
} from '../../lib/master-shop-edit-payload';
      import { initMasterShopPanels } from '../../scripts/master/shop-panels';
      import { initMasterBackupActions } from '../../scripts/master/backup-actions';
      import { createMasterSettingsActions } from '../../scripts/master/settings-actions';
      import { initMasterSettingsForms } from '../../scripts/master/settings-forms';
      import { initMasterShopAdminActions } from '../../scripts/master/shop-admin-actions';
      import { initMasterShopTableActions } from '../../scripts/master/shop-table-actions';
      import { initMasterUploadActions } from '../../scripts/master/upload-actions';
      import { initMasterSecurityActions } from '../../scripts/master/security-actions';
      import { initMasterShopCreateActions } from '../../scripts/master/shop-create-actions';
      import { initMasterPricingActions } from '../../scripts/master/pricing-actions';
      import { createMasterRuntimeHelpers } from '../../scripts/master/runtime-helpers';
      import { initMasterRuntimeActions } from '../../scripts/master/runtime-actions';

      const runtimeHelpers = createMasterRuntimeHelpers({
        logoutPath: '/api/master/logout',
        loginPath: '/master/login',
      });
      const runtimeState = runtimeHelpers.createRuntimeState(window.__masterRuntime || {});
      const masterRequestGuards = {
        isUnauthorizedResponse: runtimeHelpers.isUnauthorizedResponse,
        handleMasterUnauthorized: runtimeHelpers.handleMasterUnauthorized,
      };
      const shopEditPanelDefaults = runtimeHelpers.parseRuntimeObject(runtimeState.shopEditPanelData);

      const masterSettingsActions = createMasterSettingsActions(masterRequestGuards);

      const shopPanelBindings = initMasterShopPanels({
        shopViews: runtimeHelpers.parseRuntimeArray(runtimeState.shopViewsData),
        shopEditPanelDefaults,
        shopTopupPanelDefaults: runtimeHelpers.parseRuntimeObject(runtimeState.shopTopupPanelData),
        shopDineInPanelDefaults: runtimeHelpers.parseRuntimeObject(runtimeState.shopDineInPanelData),
        buildMasterShopEditPayload,
        buildEditShopSuccessMessage,
        ...masterRequestGuards,
      });

      const settingsFormBindings = initMasterSettingsForms(masterSettingsActions);

      const backupActionBindings = initMasterBackupActions({
        ...masterSettingsActions,
        ...masterRequestGuards,
        canLoadProtectedMasterActions: runtimeState.canLoadProtectedMasterActions,
      });

      const shopAdminBindings = initMasterShopAdminActions(masterRequestGuards);

      const shopTableBindings = initMasterShopTableActions({
        canLoadProtectedMasterActions: runtimeState.canLoadProtectedMasterActions,
      });

      const uploadActionBindings = initMasterUploadActions(masterRequestGuards);

      const securityActionBindings = initMasterSecurityActions(masterRequestGuards);

      const shopCreateBindings = initMasterShopCreateActions(masterRequestGuards);

      const pricingActionBindings = initMasterPricingActions({
        buildMasterPricingSettingsPayload,
        ...masterRequestGuards,
      });

      const runtimeActionBindings = initMasterRuntimeActions({
        resetMasterShopFeeOverrides,
        masterShopFeeFallbacks: MASTER_SHOP_FEE_FALLBACKS,
        shopEditPanelDefaults,
        handleMasterUnauthorized: masterRequestGuards.handleMasterUnauthorized,
      });
      Object.assign(window, {
        openMasterShopEdit: shopPanelBindings.openMasterShopEdit,
        openMasterShopTopup: shopPanelBindings.openMasterShopTopup,
        openMasterShopDineIn: shopPanelBindings.openMasterShopDineIn,
        submitMasterShopEdit: shopPanelBindings.submitMasterShopEdit,
        submitMasterShopTopup: shopPanelBindings.submitMasterShopTopup,
        submitMasterShopDineIn: shopPanelBindings.submitMasterShopDineIn,
        submitMasterShopTier: shopPanelBindings.submitMasterShopTier,
        submitMasterCategoriesSettings: settingsFormBindings.submitMasterCategoriesSettings,
        submitMasterServerSettings: settingsFormBindings.submitMasterServerSettings,
        submitMasterFooterSettings: settingsFormBindings.submitMasterFooterSettings,
        submitMasterRateSettings: settingsFormBindings.submitMasterRateSettings,
        submitMasterWechatSettings: settingsFormBindings.submitMasterWechatSettings,
        submitMasterPaymentSettings: settingsFormBindings.submitMasterPaymentSettings,
        submitMasterStorageSettings: settingsFormBindings.submitMasterStorageSettings,
        submitMasterBackupSettings: backupActionBindings.submitMasterBackupSettings,
        createMasterCodeBackup: backupActionBindings.createMasterCodeBackup,
        deleteMasterCodeBackup: backupActionBindings.deleteMasterCodeBackup,
        triggerMasterDataBackup: backupActionBindings.triggerMasterDataBackup,
        triggerMasterRestore: backupActionBindings.triggerMasterRestore,
        impersonateMasterShop: shopAdminBindings.impersonateMasterShop,
        deleteMasterShop: shopAdminBindings.deleteMasterShop,
        openMasterStorefront: shopTableBindings.openMasterStorefront,
        triggerMasterUpload: uploadActionBindings.triggerMasterUpload,
        submitMasterSecuritySettings: securityActionBindings.submitMasterSecuritySettings,
        submitMasterCreateShop: shopCreateBindings.submitMasterCreateShop,
        submitMasterPricingSettings: pricingActionBindings.submitMasterPricingSettings,
        resetMasterShopFeeDefaults: runtimeActionBindings.resetMasterShopFeeDefaults,
        reloadPage: runtimeActionBindings.reloadPage,
        logoutMaster: runtimeActionBindings.logoutMaster,
      });

      document.addEventListener('click', (event) => {
        backupActionBindings.handleDocumentClick(event);
        shopPanelBindings.handleDocumentClick(event);
      });

      document.addEventListener('DOMContentLoaded', () => {
        shopTableBindings.handleDomContentLoaded();
        backupActionBindings.handleDomContentLoaded();
      });
    </script>
    <style is:inline>
      [data-status='success'] {
        background: #ecfdf3 !important;
        color: #166534 !important;
      }

      [data-status='error'] {
        background: #fff1f2 !important;
        color: #b91c1c !important;
      }

      [data-status='muted'] {
        background: #f8fafc !important;
        color: #64748b !important;
      }

      .backup-empty {
        padding: 14px;
        text-align: center;
        color: #64748b;
      }

      .backup-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 10px;
        border-bottom: 1px solid #e2e8f0;
      }

      .backup-row:last-child {
        border-bottom: none;
      }

      .backup-row-title {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
      }

      .backup-row-meta {
        margin-top: 4px;
        font-size: 12px;
        color: #64748b;
      }

      .backup-row-delete {
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #b91c1c;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <div>
          <h1 class="hero-title">Master Dashboard</h1>
          <div class="hero-subtitle">Astro 原生首页一期：店铺经营摘要与总览</div>
        </div>
        <div class="hero-actions">
          {heroActions.map((action) =>
            action.kind === 'link' ? (
              <a class={action.className} href={action.href}>{action.label}</a>
            ) : (
              <button class={action.className} type="button" onclick={`${action.handler}()`}>{action.label}</button>
            )
          )}
        </div>
      </section>

      <section class="tabs" aria-label="Master sections">
        <a class:list={["tab-btn", activeTab === 'shops' && 'active']} href="/master?tab=shops">店铺管理</a>
        <a class:list={["tab-btn", activeTab === 'overview' && 'active']} href="/master?tab=overview">经营总览</a>
        <a class:list={["tab-btn", activeTab === 'settings' && 'active']} href="/master?tab=settings">全局设置</a>
        <a class:list={["tab-btn", activeTab === 'backup' && 'active']} href="/master?tab=backup">备份管理</a>
      </section>

      <div class="master-stack" data-master-panel="shops" hidden={activeTab !== 'shops' || !shouldShowMasterContent}>
        <MasterCreateShopCard />
        {dashboardView.shopManagement.shops.length > 0 ? (
          <MasterShopManagementTable shops={dashboardView.shopManagement.shops} />
        ) : (
          <div class:list={['notice', activeNotice && NOTICE_KIND_CLASSNAME[activeNotice.kind]]}>
            {activeNotice ? activeNotice.message : '暂无店铺经营数据'}
            {dashboardActions.length > 0 ? (
              <div class="notice-actions">
                {dashboardActions.map((action) =>
                  action.kind === 'link' ? (
                    <a class={action.className} href={action.href}>{action.label}</a>
                  ) : (
                    <button class={action.className} type="button" onclick={`${action.handler}()`}>{action.label}</button>
                  )
                )}
              </div>
            ) : null}
          </div>
        )}
      </div>

      <div class="master-stack" data-master-panel="overview" hidden={activeTab !== 'overview' || !shouldShowMasterContent}>
        <MasterOverview
          totalShops={dashboardView.overview.totalShops}
          todayRevenue={dashboardView.overview.todayRevenue}
          todayOrders={dashboardView.overview.todayOrders}
          monthCommission={dashboardView.overview.monthCommission}
          totalBalance={dashboardView.overview.totalBalance}
        />
      </div>

      <div class="settings-grid" data-master-panel="settings" hidden={activeTab !== 'settings' || !shouldShowMasterContent}>
        <MasterPricingSettingsCard settings={dashboardView.settings} />
        <MasterCategoriesSettingsCard settings={dashboardView.settings.categories} />
        <MasterServerSettingsCard settings={dashboardView.settings.server} />
        <MasterFooterSettingsCard settings={dashboardView.settings.footer} />
        <MasterRateSettingsCard settings={dashboardView.settings.rate} />
        <MasterWechatSettingsCard settings={dashboardView.settings.wechat} />
        <MasterPaymentSettingsCard settings={dashboardView.settings.wechat} />
        <MasterStorageSettingsCard settings={dashboardView.settings.storage} />
        <MasterSecurityCard />
      </div>

      <div class="settings-grid" data-master-panel="backup" hidden={activeTab !== 'backup' || !shouldShowMasterContent}>
        <MasterBackupSettingsCard settings={dashboardView.settings.backup} />
        <MasterDataBackupCard />
        <MasterCodeBackupCard />
      </div>

      {!shouldShowMasterContent ? (
        <div class:list={['notice', activeNotice && NOTICE_KIND_CLASSNAME[activeNotice.kind]]}>
          {activeNotice ? activeNotice.message : '主控数据加载失败'}
          {dashboardActions.length > 0 ? (
            <div class="notice-actions">
              {dashboardActions.map((action) =>
                action.kind === 'link' ? (
                  <a class={action.className} href={action.href}>{action.label}</a>
                ) : (
                  <button class={action.className} type="button" onclick={`${action.handler}()`}>{action.label}</button>
                )
              )}
            </div>
          ) : null}
        </div>
      ) : null}
    </main>
    <MasterShopEditPanel />
    <MasterShopTopupPanel />
    <MasterShopDineInPanel />
    <MasterDangerConfirm />
  </body>
</html>
