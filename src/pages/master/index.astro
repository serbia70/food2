          styleMap(ruleEl, { fontSize: '12px', color: '#475569', marginTop: '8px' });
          ruleEl.textContent = `当前提成规则：${commissionRule}`;
          const miniGrid = document.createElement('div');
          styleMap(miniGrid, { display: 'grid', gridTemplateColumns: 'repeat(2,minmax(0,1fr))', gap: '10px', marginTop: '14px' });
          miniGrid.append(
            createInfoBlock('余额', `${fmt(summary.billing_balance_rsd)} RSD`),
            createInfoBlock('状态', String(shop.status || '-')),
          );
          overview.append(nameEl, slugEl, ruleEl, miniGrid);

          const statGrid = document.createElement('section');
          styleMap(statGrid, { display: 'grid', gridTemplateColumns: 'repeat(2,minmax(0,1fr))', gap: '10px' });
          const statCards = [
            ['#fff1f2', '今日营业额', `${fmt(summary.today_revenue)} RSD`, '18px'],
            ['#eff6ff', '今日订单', `${fmt(summary.today_order_count)} 单`, '18px'],
            ['#fff7ed', '外卖 / 堂食营业额', `${fmt(summary.delivery_revenue)} / ${fmt(summary.dine_in_revenue)} RSD`, '16px'],
            ['#f5f3ff', '提成（月 / 累计）', `${fmt(summary.commission_month_rsd)} / ${fmt(summary.commission_total_rsd)} RSD`, '16px'],
          ];
          statCards.forEach(([bg, label, value, size]) => {
            const card = document.createElement('div');
            styleMap(card, { background: bg, borderRadius: '14px', padding: '14px' });
            card.append(createInfoBlock(label, value, { fontSize: size, fontWeight: '900' }));
            statGrid.appendChild(card);
          });

          const ledgerSection = document.createElement('section');
          styleMap(ledgerSection, { border: '1px solid #e5e7eb', borderRadius: '16px', padding: '16px', background: '#fff' });
          const ledgerTitle = document.createElement('div');
          styleMap(ledgerTitle, { fontSize: '16px', fontWeight: '900', marginBottom: '10px' });
          ledgerTitle.textContent = '最近账单流水';
          const ledgerList = document.createElement('div');
          styleMap(ledgerList, { display: 'grid', gap: '8px' });
          if (billingLedger.length) {
            billingLedger.forEach((row) => {
              ledgerList.appendChild(createLedgerRow(
                String(row.entry_type || '-'),
                `${fmt(row.amount_rsd)} RSD · ${row.created_at || '-'}`,
                String(row.note || '-'),
              ));
            });
          } else {
            const empty = document.createElement('div');
            empty.className = 'detail-empty';
            empty.textContent = '暂无账单流水';
            ledgerList.appendChild(empty);
          }
          ledgerSection.append(ledgerTitle, ledgerList);

          const commissionSection = document.createElement('section');
          styleMap(commissionSection, { border: '1px solid #e5e7eb', borderRadius: '16px', padding: '16px', background: '#fff' });
          const commissionTitle = document.createElement('div');
          styleMap(commissionTitle, { fontSize: '16px', fontWeight: '900', marginBottom: '10px' });
          commissionTitle.textContent = '最近提成记录';
          const commissionList = document.createElement('div');
          styleMap(commissionList, { display: 'grid', gap: '8px' });
          if (commissionRecords.length) {
            commissionRecords.forEach((row) => {
              commissionList.appendChild(createLedgerRow(
                String(row.order_no || '-'),
                `${row.order_type || '-'} · ${row.created_at || '-'}`,
                `提成 ${fmt(row.commission_amount)} RSD / 订单 ${fmt(row.total_amount)} RSD`,
              ));
            });
          } else {
            const empty = document.createElement('div');
            empty.className = 'detail-empty';
            empty.textContent = '暂无提成记录';
            commissionList.appendChild(empty);
          }
          commissionSection.append(commissionTitle, commissionList);

          root.append(overview, statGrid, ledgerSection, commissionSection);
          content.replaceChildren(root);
        } catch (error) {
          setDetailMessage('详情加载失败');
        }
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const deleteBtn = target.closest('[data-backup-delete]');
        if (deleteBtn instanceof HTMLElement) {
          const backupName = deleteBtn.getAttribute('data-backup-delete');
          if (backupName) window.deleteMasterCodeBackup(backupName);
        }

        const copyBtn = target.closest('[data-copy-link]');
        if (copyBtn) {
          const path = copyBtn.getAttribute('data-copy-link');
          if (path) copyMasterLink(path);
        }

        if (target.closest('[data-close-detail]')) {
          const panel = document.getElementById('master-shop-detail-panel');
          if (panel) panel.hidden = true;
        }

        if (target.closest('[data-close-shop-edit]')) {
          const panel = document.getElementById('master-shop-edit-panel');
          if (panel) panel.hidden = true;
        }

        if (target.closest('[data-close-shop-topup]')) {
          const panel = document.getElementById('master-shop-topup-panel');
          if (panel) panel.hidden = true;
        }
      });

      document.addEventListener('DOMContentLoaded', () => {
        if (!canLoadProtectedMasterActions) {
          document.querySelectorAll('form button[type="submit"]').forEach((el) => {
            if (el instanceof HTMLButtonElement) {
              el.disabled = true;
            }
          });
        }
        applyMasterTableFilters();
        document.querySelectorAll('[data-master-filter-search], [data-master-filter-status], [data-master-filter-billing], [data-master-sort]').forEach((el) => {
          el.addEventListener('input', applyMasterTableFilters);
          el.addEventListener('change', applyMasterTableFilters);
        });
        document.querySelectorAll('[data-backup-target]').forEach((el) => {
          if (el instanceof HTMLSelectElement) {
            syncBackupMode(el);
            el.addEventListener('change', () => syncBackupMode(el));
          }
        });
        if (canLoadProtectedMasterActions) {
          loadMasterCodeBackups();
        } else {
          const backupList = document.getElementById('master-code-backup-list');
          if (backupList instanceof HTMLElement) {
            backupList.textContent = '请重新登录主控后再加载代码备份。';
          }
          setStatusFeedback('master-code-backup-feedback', '当前主控登录态无效，请重新登录。', 'error');
        }
      });
    </script>
    <style is:inline>
      [data-status='success'] {
        background: #ecfdf3 !important;
        color: #166534 !important;
      }

      [data-status='error'] {
        background: #fff1f2 !important;
        color: #b91c1c !important;
      }

      [data-status='muted'] {
        background: #f8fafc !important;
        color: #64748b !important;
      }

      .backup-empty {
        padding: 14px;
        text-align: center;
        color: #64748b;
      }

      .backup-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 10px;
        border-bottom: 1px solid #e2e8f0;
      }

      .backup-row:last-child {
        border-bottom: none;
      }

      .backup-row-title {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
      }

      .backup-row-meta {
        margin-top: 4px;
        font-size: 12px;
        color: #64748b;
      }

      .backup-row-delete {
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #b91c1c;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <div>
          <h1 class="hero-title">Master Dashboard</h1>
          <div class="hero-subtitle">Astro 原生首页一期：店铺经营摘要与总览</div>
        </div>
        <div class="hero-actions" set:html={heroCtasHtml} />
      </section>

      <section class="tabs" aria-label="Master sections">
        <a class:list={["tab-btn", activeTab === 'management' && 'active']} href="/master?tab=management">店铺管理</a>
        <a class:list={["tab-btn", activeTab === 'overview' && 'active']} href="/master?tab=overview">经营总览</a>
        <a class:list={["tab-btn", activeTab === 'settings' && 'active']} href="/master?tab=settings">全局设置</a>
      </section>

      <div class="master-stack" data-master-panel="management" hidden={activeTab !== 'management' || !shouldShowMasterContent}>
        <MasterCreateShopCard />
        {shops.length > 0 ? (
          <MasterShopManagementTable shops={shopViews} />
        ) : (
          <div class="notice">
            {loadError || '暂无店铺经营数据'}
            {isUnauthorized ? (
              <div class="notice-actions" set:html={noticeCtasHtml} />
            ) : null}
          </div>
        )}
      </div>

      <div class="master-stack" data-master-panel="overview" hidden={activeTab !== 'overview' || !shouldShowMasterContent}>
        <MasterOverview
          totalShops={totals.totalShops}
          todayRevenue={totals.todayRevenue}
          todayOrders={totals.todayOrders}
          monthCommission={totals.monthCommission}
          totalBalance={totals.totalBalance}
        />
      </div>

      <div class="settings-grid" data-master-panel="settings" hidden={activeTab !== 'settings' || !shouldShowMasterContent}>
        <MasterPricingSettingsCard settings={settingsView} />
        <MasterCategoriesSettingsCard settings={settingsView.categories} />
        <MasterServerSettingsCard settings={settingsView.server} />
        <MasterFooterSettingsCard settings={settingsView.footer} />
        <MasterRateSettingsCard settings={settingsView.rate} />
        <MasterWechatSettingsCard settings={settingsView.wechat} />
        <MasterPaymentSettingsCard settings={settingsView.wechat} />
        <MasterStorageSettingsCard settings={settingsView.storage} />
        <MasterBackupSettingsCard settings={settingsView.backup} />
        <MasterDataBackupCard />
        <MasterCodeBackupCard />
        <MasterSecurityCard />
      </div>

      {!shouldShowMasterContent ? (
        <div class="notice">
          {loadError || '主控数据加载失败'}
          <div class="notice-actions" set:html={noticeCtasHtml} />
        </div>
      ) : null}
    </main>\n    <MasterShopEditPanel />
    <MasterShopTopupPanel />
  </body>
</html>
