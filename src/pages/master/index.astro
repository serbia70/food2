          const empty = document.createElement('div');
          empty.className = 'detail-empty';
          empty.textContent = message;
          content.replaceChildren(empty);
        };

        const styleMap = (el, styles) => {
          Object.entries(styles).forEach(([key, value]) => {
            el.style[key] = value;
          });
        };

        const createInfoBlock = (label, value, styles = {}) => {
          const block = document.createElement('div');
          const labelEl = document.createElement('div');
          styleMap(labelEl, { fontSize: '12px', color: '#64748b' });
          labelEl.textContent = label;
          const valueEl = document.createElement('div');
          styleMap(valueEl, { fontWeight: '800', ...styles });
          valueEl.textContent = value;
          block.append(labelEl, valueEl);
          return block;
        };

        const createLedgerRow = (title, meta, note) => {
          const row = document.createElement('div');
          styleMap(row, { padding: '10px', borderRadius: '10px', background: '#f8fafc' });
