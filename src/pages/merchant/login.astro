---
import Layout from '../../layouts/Layout.astro';
import { API_BASE_URL } from '../../config';

const apiBase = API_BASE_URL;
---

<Layout title="商家登录">
  <div class="wrap">
    <div class="card">
      <h2>商家登录</h2>
      <p>使用店铺 `slug` 和密码登录后台。商家账号由主控台创建后使用，不提供前台自助注册。</p>
      <input id="slug" placeholder="店铺 slug，例如 s1234" />
      <input id="pwd" type="password" placeholder="密码" />
      <button id="submit">登录后台</button>
    </div>
  </div>

  <style>
    .wrap { min-height: 100vh; background: #f5f5f5; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { width: 100%; max-width: 420px; background: #fff; border-radius: 12px; padding: 22px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
    h2 { margin: 0 0 8px; }
    p { margin: 0 0 14px; color: #666; font-size: 14px; }
    input { width: 100%; box-sizing: border-box; margin-bottom: 10px; padding: 11px; border: 1px solid #d1d5db; border-radius: 8px; }
    button { width: 100%; border: none; background: #00b140; color: #fff; padding: 11px; border-radius: 8px; font-weight: 700; cursor: pointer; }
  </style>

  <script is:inline define:vars={{ apiBase }}>
    document.getElementById('submit').onclick = async () => {
      const slug = document.getElementById('slug').value.trim();
      const password = document.getElementById('pwd').value.trim();
      if (!slug || !password) return alert('请填写完整信息');

      const res = await fetch(`${apiBase}/api/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, password }),
      });
      const data = await res.json();
      if (!res.ok || !(data && data.token)) return alert((data && data.error) || '登录失败');

      localStorage.setItem('token', data.token);
      localStorage.setItem('slug', slug);
      location.href = `/admin/${slug}`;
    };
  </script>
</Layout>
