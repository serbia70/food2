---
import Layout from '../../layouts/Layout.astro';
import PlatformBottomNav from '../../components/PlatformBottomNav.astro';
---

<Layout title="消息中心">
  <div class="page-container">
    <div class="nav-header">
      <h2>消息中心</h2>
    </div>

    <div class="msg-list">
      <div class="empty-state">
        <div class="empty-icon">💬</div>
        <p>暂无新消息</p>
      </div>
    </div>
  </div>

  <PlatformBottomNav active="messages" />

  <style>
    .page-container {
      background: #f5f5f5;
      min-height: 100vh;
      padding-bottom: 80px;
    }
    .nav-header {
      background: white;
      padding: 15px;
      text-align: center;
      border-bottom: 1px solid #eee;
      position: sticky; top: 0; z-index: 10;
    }
    .nav-header h2 { margin: 0; font-size: 18px; }

    .empty-state {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding-top: 100px;
    }
    .empty-icon { font-size: 60px; color: #ddd; margin-bottom: 20px; }
    .empty-state p { color: #999; margin-bottom: 20px; }

  </style>
</Layout>
