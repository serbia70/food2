---
import Layout from '../../layouts/Layout.astro';
import PlatformBottomNav from '../../components/PlatformBottomNav.astro';
---

<Layout title="订单中心">
  <div class="orders-page">
    <header class="orders-appbar">
      <div class="orders-appbar-inner">
        <div class="orders-title">
          <div class="orders-title-eyebrow">Order Center</div>
          <div class="orders-title-main">我的订单</div>
        </div>
        <div class="orders-appbar-actions">
          <a href="/" class="orders-appbar-link">返回首页</a>
        </div>
      </div>
    </header>

    <main class="orders-main" role="main">
      <div class="orders-container">
        <section class="orders-intro-card">
          <div class="orders-intro-text">
            <div class="orders-intro-head">按店铺查看历史订单、积分和 VIP 权益</div>
            <div class="orders-intro-sub">清楚知道每一单来自哪家店，进行中订单也会在这里汇总。</div>
          </div>
        </section>

        <section id="orders-auth" class="state-card" style="display:none;">
          <h2>请先登录</h2>
          <p>登录后即可查看你在不同店铺的订单与会员权益。</p>
          <div class="actions">
            <a href="/user/login" class="primary-btn">去登录</a>
            <a href="/user/login?mode=register" class="secondary-btn">去注册</a>
          </div>
        </section>

        <section id="orders-loading" class="state-card" style="display:none;">
          <h2>加载中...</h2>
          <p>正在读取你的订单与店铺权益。</p>
        </section>

        <section id="orders-error" class="state-card error" style="display:none;">
          <h2>订单加载失败</h2>
          <p id="orders-error-text">请稍后重试。</p>
        </section>

        <div class="orders-ready-grid">
          <section id="membership-section" class="orders-panel" style="display:none;">
            <div id="overview-hero" class="overview-hero"></div>
            <div class="orders-panel-card">
              <div class="orders-panel-head">
                <h2>店铺权益</h2>
                <span class="section-tip">积分和 VIP 按店铺分别统计</span>
              </div>
              <div id="membership-list" class="membership-rail"></div>
            </div>
          </section>

          <section id="orders-section" class="orders-panel" style="display:none;">
            <div class="orders-panel-card">
              <div class="orders-panel-head">
                <h2>全部订单</h2>
                <span id="orders-count" class="section-tip"></span>
              </div>
              <div id="orders-empty" class="state-card" style="display:none;">
                <h2>暂无订单</h2>
                <p>你还没有历史订单，先去逛逛首页吧。</p>
              </div>
              <div id="orders-list" class="orders-groups"></div>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>

  <PlatformBottomNav active="orders" />

  <script is:inline>
    function filterUserVisibleOrders(orders) {
      return (orders || []).filter((order) => {
        const t = String(order?.order_type || '').trim();
        return t === 'delivery';
      });
    }

    function pickFirstString(order, keys) {
      for (const key of keys) {
        const value = String(order?.[key] || '').trim();
        if (value) return value;
      }
      return '';
    }

    function pickFirstNumber(order, keys) {
      for (const key of keys) {
        const raw = order?.[key];
        if (raw === undefined || raw === null || raw === '') continue;
        const value = Number(raw);
        if (Number.isFinite(value)) return value;
      }
      return null;
    }

    function pickVip(order) {
      if (order?.is_vip === true || order?.is_vip === 1 || order?.is_vip === '1') return true;
      const vipLevel = String(order?.vip_level || '').trim();
      return Boolean(vipLevel && vipLevel !== '0' && vipLevel.toLowerCase() !== 'none');
    }

    function buildMembershipLabel(points, isVip) {
      const tags = [];
      if (isVip) tags.push('VIP');
      if (points !== null) tags.push(`积分 ${points}`);
      return tags.join(' · ');
    }

    function buildUserOrderView(order, shopMap = {}) {
      const shopId = String(order?.shop_id || order?.restaurant_id || '').trim();
      const fallbackShop = shopId ? shopMap[shopId] || {} : {};
      const shopName = pickFirstString(order, ['shop_name', 'restaurant_name', 'merchant_name']) || String(fallbackShop.name || '').trim() || '未知店铺';
      const shopSlug = pickFirstString(order, ['shop_slug', 'slug', 'restaurant_slug']) || String(fallbackShop.slug || '').trim();
      const points = pickFirstNumber(order, ['points', 'user_points', 'points_balance']);
      const isVip = pickVip(order);
      return {
        shopName,
        shopSlug,
        points,
        isVip,
        membershipLabel: buildMembershipLabel(points, isVip),
      };
    }

    function buildShopMembershipSummaries(orders, shopMap = {}) {
      const grouped = new Map();
      for (const order of filterUserVisibleOrders(orders || [])) {
        const view = buildUserOrderView(order, shopMap);
        const shopKey = view.shopSlug || view.shopName;
        const existing = grouped.get(shopKey);
        if (!existing) {
          grouped.set(shopKey, {
            shopName: view.shopName,
            shopSlug: view.shopSlug,
            points: view.points,
            isVip: view.isVip,
            membershipLabel: view.membershipLabel,
            orderCount: 1,
            latestOrderAt: String(order?.created_at || ''),
          });
          continue;
        }
        existing.orderCount += 1;
        if ((view.points ?? -1) > (existing.points ?? -1)) existing.points = view.points;
        existing.isVip = existing.isVip || view.isVip;
        existing.membershipLabel = buildMembershipLabel(existing.points, existing.isVip);
        if (String(order?.created_at || '') > String(existing.latestOrderAt || '')) {
          existing.latestOrderAt = String(order?.created_at || '');
        }
      }
      return [...grouped.values()].sort((a, b) => String(b.latestOrderAt).localeCompare(String(a.latestOrderAt)));
    }

    async function loadShopMap() {
      try {
        const res = await fetch('/api/shop/list');
        if (!res.ok) return {};
        const data = await res.json();
        const shops = Array.isArray(data?.shops) ? data.shops : [];
        const nextMap = {};
        shops.forEach((shop) => {
          const id = String(shop?.id || '').trim();
          if (!id) return;
          nextMap[id] = {
            id,
            name: String(shop?.name || '').trim(),
            slug: String(shop?.slug || '').trim(),
          };
        });
        return nextMap;
      } catch {
        return {};
      }
    }

    const authEl = document.getElementById('orders-auth');
    const loadingEl = document.getElementById('orders-loading');
    const errorEl = document.getElementById('orders-error');
    const errorTextEl = document.getElementById('orders-error-text');
    const membershipSectionEl = document.getElementById('membership-section');
    const membershipListEl = document.getElementById('membership-list');
    const overviewHeroEl = document.getElementById('overview-hero');
    const ordersSectionEl = document.getElementById('orders-section');
    const ordersEmptyEl = document.getElementById('orders-empty');
    const ordersListEl = document.getElementById('orders-list');
    const ordersCountEl = document.getElementById('orders-count');

    function getStatusLabel(status) {
      if (status === 'pending') return '等待接单';
      if (status === 'confirmed') return '商家已接单';
      if (status === 'delivering') return '配送中';
      if (status === 'completed') return '已完成';
      return '订单已关闭';
    }

    function getStatusClass(status) {
      if (status === 'pending') return 'status-pending';
      if (status === 'confirmed' || status === 'delivering') return 'status-active';
      if (status === 'completed') return 'status-done';
      return 'status-closed';
    }

    function splitOrdersForView(orders) {
      const active = [];
      const completed = [];
      const others = [];
      for (const order of orders) {
        if (order.status === 'pending' || order.status === 'confirmed' || order.status === 'delivering') {
          active.push(order);
        } else if (order.status === 'completed') {
          completed.push(order);
        } else {
          others.push(order);
        }
      }
      return [
        { key: 'active', title: '进行中', orders: active },
        { key: 'completed', title: '已完成', orders: completed },
        { key: 'others', title: '其他状态', orders: others },
      ].filter((group) => group.orders.length > 0);
    }

    function readUser() {
      try {
        const raw = localStorage.getItem('food_order_user') || localStorage.getItem('user_info') || '{}';
        return JSON.parse(raw);
      } catch {
        return {};
      }
    }

    function setView(mode, message = '') {
      authEl.style.display = mode === 'auth' ? 'block' : 'none';
      loadingEl.style.display = mode === 'loading' ? 'block' : 'none';
      errorEl.style.display = mode === 'error' ? 'block' : 'none';
      membershipSectionEl.style.display = mode === 'ready' ? 'block' : 'none';
      ordersSectionEl.style.display = mode === 'ready' ? 'block' : 'none';
      if (mode === 'error') errorTextEl.textContent = message || '请稍后重试。';
    }

    function parseItems(order) {
      try {
        const items = typeof order.items_json === 'string' ? JSON.parse(order.items_json) : order.items_json;
        const itemsArray = Array.isArray(items) ? items : Object.values(items || {});
        return itemsArray.map((item) => {
          const name = item?.name || '未命名商品';
          const subName = item?.subName || item?.sub_name || '';
          const quantity = Number(item?.quantity || 0);
          return `• ${name}${subName ? ` (${subName})` : ''}${quantity ? ` x${quantity}` : ''}`;
        });
      } catch {
        return ['商品解析失败'];
      }
    }

    function renderMemberships(summaries) {
      membershipListEl.replaceChildren();
      if (!summaries.length) {
        const empty = document.createElement('div');
        empty.className = 'membership-empty';
        empty.textContent = '还没有可展示的店铺权益，等你下第一单后这里会更丰富。';
        membershipListEl.replaceChildren(empty);
        return;
      }

      summaries.forEach((summary) => {
        const shopName = String(summary?.shopName || '店');
        const shopSlug = String(summary?.shopSlug || '').trim();

        const card = document.createElement('article');
        card.className = 'membership-card';

        const top = document.createElement('div');
        top.className = 'membership-card-top';

        const shopBlock = document.createElement('div');
        shopBlock.className = 'membership-shop-block';

        const badge = document.createElement('div');
        badge.className = 'membership-badge';
        badge.textContent = shopName.trim().charAt(0) || '店';

        const shopMeta = document.createElement('div');

        const nameEl = document.createElement('div');
        nameEl.className = 'membership-shop-name';
        nameEl.textContent = shopName;

        shopMeta.appendChild(nameEl);

        if (shopSlug) {
          const slugEl = document.createElement('div');
          slugEl.className = 'membership-shop-slug';
          slugEl.textContent = `/${shopSlug}`;
          shopMeta.appendChild(slugEl);
        }

        shopBlock.append(badge, shopMeta);

        const badges = document.createElement('div');
        badges.className = 'membership-badges';

        if (summary?.isVip) {
          const vip = document.createElement('span');
          vip.className = 'tag vip';
          vip.textContent = 'VIP';
          badges.appendChild(vip);
        }

        if (summary?.points !== null && summary?.points !== undefined) {
          const points = document.createElement('span');
          points.className = 'tag points';
          points.textContent = `积分 ${summary.points}`;
          badges.appendChild(points);
        }

        top.append(shopBlock, badges);

        const latest = summary?.latestOrderAt
          ? new Date(summary.latestOrderAt).toLocaleString('sr-RS', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })
          : '-';

        const meta = document.createElement('div');
        meta.className = 'membership-meta';

        const orderCount = document.createElement('span');
        orderCount.textContent = `订单 ${summary.orderCount} 笔`;

        const latestEl = document.createElement('span');
        latestEl.textContent = `最近下单 ${latest}`;

        meta.append(orderCount, latestEl);

        card.append(top, meta);
        membershipListEl.appendChild(card);
      });
    }

    function renderOverview(summaries, orders) {
      if (!orders.length) {
        overviewHeroEl.replaceChildren();
        return;
      }

      const latestOrder = [...orders].sort((a, b) => String(b.created_at || '').localeCompare(String(a.created_at || '')))[0];
      const leadShop = summaries[0] || {};
      const activeCount = orders.filter((order) => ['pending', 'confirmed', 'delivering'].includes(order.status)).length;

      const card = document.createElement('div');
      card.className = 'overview-card';

      const top = document.createElement('div');
      top.className = 'overview-hero-top';

      const brandBlock = document.createElement('div');
      brandBlock.className = 'overview-brand-block';

      const logo = document.createElement('div');
      logo.className = 'overview-logo';
      logo.textContent = String(leadShop?.shopName || '订').trim().charAt(0) || '订';

      const brandTextWrap = document.createElement('div');

      const brand = document.createElement('div');
      brand.className = 'overview-brand';
      brand.textContent = String(leadShop?.shopName || '我的订单');

      const sub = document.createElement('div');
      sub.className = 'overview-sub';
      sub.textContent = leadShop?.shopSlug ? `当前店铺 / ${leadShop.shopSlug}` : '移动端订单中心';

      brandTextWrap.append(brand, sub);
      brandBlock.append(logo, brandTextWrap);

      const latestBadge = document.createElement('div');
      latestBadge.className = 'overview-latest-badge';
      latestBadge.textContent = getStatusLabel(latestOrder?.status || '');

      top.append(brandBlock, latestBadge);

      const stats = document.createElement('div');
      stats.className = 'overview-stats';

      const statTotal = document.createElement('div');
      statTotal.className = 'stat-box accent';
      const totalStrong = document.createElement('strong');
      totalStrong.textContent = String(orders.length);
      const totalLabel = document.createElement('span');
      totalLabel.textContent = '总订单';
      statTotal.append(totalStrong, totalLabel);

      const statActive = document.createElement('div');
      statActive.className = 'stat-box warm';
      const activeStrong = document.createElement('strong');
      activeStrong.textContent = String(activeCount);
      const activeLabel = document.createElement('span');
      activeLabel.textContent = '进行中';
      statActive.append(activeStrong, activeLabel);

      const statMembership = document.createElement('div');
      statMembership.className = 'stat-box soft';
      const memStrong = document.createElement('strong');
      memStrong.textContent = String(leadShop?.membershipLabel || '普通用户');
      const memLabel = document.createElement('span');
      memLabel.textContent = '当前权益';
      statMembership.append(memStrong, memLabel);

      stats.append(statTotal, statActive, statMembership);

      const latest = document.createElement('div');
      latest.className = 'overview-latest';
      const latestTime = new Date(latestOrder?.created_at || '').toLocaleString('sr-RS', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
      latest.textContent = `最近订单：#${latestOrder?.order_no || '-'} · ${latestTime}`;

      card.append(top, stats, latest);
      overviewHeroEl.replaceChildren(card);
    }

    function renderOrders(orders, shopMap) {
      ordersListEl.replaceChildren();
      ordersCountEl.textContent = `共 ${orders.length} 笔`;
      ordersEmptyEl.style.display = orders.length ? 'none' : 'block';

      const groups = splitOrdersForView(orders);
      groups.forEach((group) => {
        const section = document.createElement('section');
        section.className = 'order-group';

        const title = document.createElement('div');
        title.className = 'order-group-title';
        title.textContent = String(group.title || '');
        section.appendChild(title);

        group.orders.forEach((order) => {
          const view = buildUserOrderView(order, shopMap);
          const statusLabel = getStatusLabel(order.status);
          const statusClass = getStatusClass(order.status);

          const card = document.createElement('article');
          card.className = `order-card ${statusClass}`;

          const timeText = order.created_at
            ? new Date(order.created_at).toLocaleString('sr-RS', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })
            : '-';

          const pickupNo = String(order.order_no || order.id || '').slice(-3);
          const shopBadge = (view.shopName || '?').trim().charAt(0).toUpperCase();
          const cleanShopSlug = view.shopSlug && view.shopSlug !== view.shopName ? view.shopSlug : '';
          const addressSummary = String(order.table_info || '')
            .replace(/\s*\[货到付款\/Cash\].*$/u, '')
            .replace(/\s*\(备注:.*$/u, '')
            .trim();
          const shortAddress = addressSummary.length > 58 ? `${addressSummary.slice(0, 58)}...` : addressSummary;

          const head = document.createElement('div');
          head.className = 'order-card-head';

          const shopBlock = document.createElement('div');
          shopBlock.className = 'order-shop-block';

          const badge = document.createElement('div');
          badge.className = 'shop-badge';
          badge.textContent = shopBadge || '店';

          const shopMeta = document.createElement('div');

          const shopRow = document.createElement('div');
          shopRow.className = 'order-shop-row';

          const shopName = document.createElement('div');
          shopName.className = 'order-shop-name';
          shopName.textContent = String(view.shopName || '');

          const chatLink = document.createElement('a');
          chatLink.className = 'nav-btn nav-cart order-shop-action';
          chatLink.href = `/user?openChat=1&from=orders&shopId=${encodeURIComponent(String(order.shop_id || ''))}&shop=${encodeURIComponent(view.shopSlug || '')}&shopName=${encodeURIComponent(view.shopName || '')}`;
          chatLink.setAttribute('aria-label', '联系商家');
          chatLink.title = '联系商家';
          chatLink.style.cssText = 'background: linear-gradient(135deg, #22c55e, #059669); box-shadow: 0 4px 12px rgba(34,197,94,0.35);';
          const chatIcon = document.createElement('span');
          chatIcon.setAttribute('aria-hidden', 'true');
          chatIcon.style.cssText = 'font-size:20px; line-height:1;';
          chatIcon.textContent = '💬';
          chatLink.appendChild(chatIcon);

          shopRow.append(shopName, chatLink);

          const meta = document.createElement('div');
          meta.className = 'order-meta';
          meta.textContent = `#${order.order_no || order.id || '-'} · 取餐号 ${pickupNo || '-'}`;

          shopMeta.append(shopRow, meta);
          shopBlock.append(badge, shopMeta);

          const headRight = document.createElement('div');
          headRight.className = 'order-head-right';

          const statusChip = document.createElement('span');
          statusChip.className = `status-chip ${statusClass}`;
          statusChip.textContent = statusLabel;

          const amount = document.createElement('div');
          amount.className = 'order-amount';
          amount.textContent = `${Number(order.total_amount || 0).toLocaleString()} RSD`;

          headRight.append(statusChip, amount);
          head.append(shopBlock, headRight);

          const submeta = document.createElement('div');
          submeta.className = 'order-submeta compact';

          const timePill = document.createElement('span');
          timePill.className = 'time-pill';
          timePill.textContent = timeText;
          submeta.appendChild(timePill);

          if (cleanShopSlug) {
            const slugPill = document.createElement('span');
            slugPill.className = 'slug-pill';
            slugPill.textContent = `/${cleanShopSlug}`;
            submeta.appendChild(slugPill);
          }

          if (view.membershipLabel) {
            const tag = document.createElement('span');
            tag.className = `mini-tag ${view.isVip ? 'vip' : 'points'}`;
            tag.textContent = String(view.membershipLabel);
            submeta.appendChild(tag);
          }

          const grid = document.createElement('div');
          grid.className = 'order-body-grid';

          const summaryBox = document.createElement('div');
          summaryBox.className = 'order-summary-box';
          const summaryTitle = document.createElement('div');
          summaryTitle.className = 'summary-title';
          summaryTitle.textContent = '商品摘要';
          const itemsWrap = document.createElement('div');
          itemsWrap.className = 'order-items';
          parseItems(order)
            .slice(0, 2)
            .forEach((line) => {
              const item = document.createElement('div');
              item.className = 'order-item';
              item.textContent = String(line || '');
              itemsWrap.appendChild(item);
            });
          summaryBox.append(summaryTitle, itemsWrap);
          grid.appendChild(summaryBox);

          if (addressSummary) {
            const locCard = document.createElement('div');
            locCard.className = 'order-location-card';
            const locTitle = document.createElement('div');
            locTitle.className = 'summary-title';
            locTitle.textContent = '配送地址';
            const loc = document.createElement('div');
            loc.className = 'order-location';
            loc.textContent = `📍 ${shortAddress}`;
            locCard.append(locTitle, loc);
            grid.appendChild(locCard);
          }

          card.append(head, submeta, grid);
          section.appendChild(card);
        });

        ordersListEl.appendChild(section);
      });
    }

    async function loadOrders() {
      const sessionToken = String(localStorage.getItem('user_session') || '').trim();

      if (!sessionToken) {
        setView('auth');
        return;
      }

      setView('loading');

      try {
        const shopMap = await loadShopMap();

        const res = await fetch('/api/user/history', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionToken }),
        });
        const data = await res.json();
        if (!res.ok || !data?.success) {
          throw new Error(data?.error || '读取订单失败');
        }

        const sourceOrders = Array.isArray(data?.orders) ? data.orders : [];
        const orders = filterUserVisibleOrders(sourceOrders);

        const summaries = buildShopMembershipSummaries(orders, shopMap);

        renderOverview(summaries, orders);
        renderMemberships(summaries);
        renderOrders(orders, shopMap);
        setView('ready');
      } catch (error) {
        setView('error', error instanceof Error ? error.message : '读取订单失败');
      }
    }

    loadOrders();
  </script>

  <style is:global>
    .orders-page {
      height: 100vh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 20px 16px calc(110px + env(safe-area-inset-bottom, 0px));
      background:
        radial-gradient(circle at top left, rgba(0, 177, 64, 0.14), transparent 28%),
        linear-gradient(180deg, #f8fbf8 0%, #eef4ef 100%);
    }

    .orders-appbar {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(248, 251, 248, 0.82);
      backdrop-filter: saturate(140%) blur(10px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
      margin: -20px -16px 0;
      padding: 0 16px;
    }

    .orders-appbar-inner {
      max-width: 1160px;
      margin: 0 auto;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 0;
    }

    .orders-title-eyebrow {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #047857;
      opacity: 0.95;
    }

    .orders-title-main {
      font-size: 18px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      margin-top: 2px;
    }

    .orders-appbar-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .orders-appbar-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #0f172a;
      text-decoration: none;
      font-weight: 800;
      font-size: 12px;
      box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
    }

    .orders-appbar-link:active { transform: translateY(1px); }

    .orders-main { padding: 14px 0 0; }

