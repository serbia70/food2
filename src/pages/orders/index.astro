---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="订单中心">
  <div class="wrap">
    <h2>订单中心</h2>
    <p>功能迁移中。请先在商家后台或骑手端查看订单。</p>
    <a href="/" class="btn">返回首页</a>
  </div>

  <style>
    .wrap { min-height: 100vh; background: #f5f5f5; padding: 24px; }
    h2 { margin: 0 0 10px; }
    p { color: #666; margin: 0 0 14px; }
    .btn { display: inline-block; text-decoration: none; background: #00b140; color: #fff; padding: 10px 14px; border-radius: 8px; }
  </style>
</Layout>
