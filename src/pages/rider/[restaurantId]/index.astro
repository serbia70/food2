---
import Layout from '../../../layouts/Layout.astro';

const { restaurantId } = Astro.params;
---

<Layout title="Rider">
  <div class="wrap">
    <h2>骑手入口已统一</h2>
    <p>门店 `{restaurantId}` 的骑手页已迁移到统一看板。</p>
    <a href="/rider/dashboard" class="btn">前往骑手看板</a>
  </div>

  <style>
    .wrap { min-height: 100vh; background: #f5f5f5; padding: 24px; }
    h2 { margin: 0 0 8px; }
    p { color: #666; margin: 0 0 12px; }
    .btn { display: inline-block; text-decoration: none; background: #2196f3; color: #fff; padding: 10px 14px; border-radius: 8px; }
  </style>
</Layout>
