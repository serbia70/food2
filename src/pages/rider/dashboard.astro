---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Rider Dashboard" manifest="/rider-manifest.json">
  <div id="dashboard" style="display:none;">
    <div class="header">
      <div class="rider-info">
        <div class="rider-profile">
          <span id="rider-name">Rider</span>
          <span id="rider-status-badge" class="status-badge offline">Offline</span>
        </div>
        <button onclick="logout()" class="btn-xs">退出 / Logout</button>
      </div>

      <div class="status-toggle">
        <label class="switch-label">状态 / Status:</label>
        <select id="status-select" onchange="updateStatus(this.value)">
          <option value="offline">🔶 下线 / Offline</option>
          <option value="available">🟢 空闲 / Available</option>
          <option value="busy">🟠 忙碌 / Busy</option>
        </select>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="switchTab(event, 'active')">进行中</button>
        <button class="tab" onclick="switchTab(event, 'history')">已完成</button>
      </div>
    </div>

    <div id="order-list" class="order-list">
      <div class="loading">加载中...</div>
    </div>
  </div>

  <style>
    body { background: #f4f6f8; margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .header { position: sticky; top: 0; background: #fff; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .rider-info { padding: 15px; display: flex; justify-content: space-between; align-items: center; background: #e3f2fd; color: #1565c0; }
    .rider-profile { display: flex; align-items: center; gap: 10px; font-weight: bold; font-size: 18px; }
    .status-badge { font-size: 12px; padding: 2px 6px; border-radius: 4px; color: white; }
    .status-badge.offline { background: #9e9e9e; }
    .status-badge.available { background: #4caf50; }
    .status-badge.busy { background: #ff9800; }
    .status-toggle { padding: 10px 15px; background: #fff; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: space-between; }
    .switch-label { font-weight: bold; color: #555; }
    #status-select { padding: 8px; border-radius: 6px; border: 1px solid #ddd; font-size: 14px; }
    .tabs { display: flex; border-bottom: 1px solid #eee; }
    .tab { flex: 1; padding: 15px; border: none; background: #fff; font-size: 15px; font-weight: 600; color: #666; cursor: pointer; border-bottom: 3px solid transparent; }
    .tab.active { color: #2196f3; border-bottom-color: #2196f3; }
    .order-list { padding: 15px; padding-bottom: 80px; min-height: calc(100vh - 160px); }
    .order-card { background: #fff; border-radius: 12px; padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border-left: 5px solid #ccc; }
    .order-card.status-delivering { border-left-color: #ff9800; }
    .order-card.status-completed { border-left-color: #4caf50; opacity: 0.85; }
    .order-card.status-pending { border-left-color: #3b82f6; }
    .order-card.status-confirmed { border-left-color: #8b5cf6; }
    .card-header { display: flex; justify-content: space-between; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px dashed #eee; }
    .order-no { font-size: 18px; font-weight: bold; color: #333; }
    .order-time { color: #999; font-size: 13px; }
    .info-row { display: flex; align-items: flex-start; margin-bottom: 8px; gap: 10px; }
    .icon { width: 20px; text-align: center; }
    .text { flex: 1; font-size: 15px; line-height: 1.4; }
    .text.address { font-weight: bold; color: #333; font-size: 16px; }
    .text.phone { color: #2196f3; font-weight: bold; }
    .items-box { background: #f9f9f9; padding: 10px; border-radius: 6px; margin: 10px 0; font-size: 14px; color: #555; }
    .item-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 10px; border-top: 1px solid #eee; }
    .total-price { font-size: 20px; font-weight: bold; color: #d32f2f; }
    .action-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
    .btn-action { padding: 12px; border: none; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px; text-decoration: none; }
    .btn-call { background: #e3f2fd; color: #1565c0; }
    .btn-map { background: #e8f5e9; color: #2e7d32; }
    .btn-complete { grid-column: span 2; background: #4caf50; color: white; font-size: 16px; padding: 15px; margin-top: 5px; }
    .empty-tip { text-align: center; padding: 40px; color: #999; }
    .btn-xs { padding: 5px 10px; background: #fff; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; }
  </style>

  <script is:inline>
    let rider = null;
    let currentTab = 'active';
    let allOrders = [];

    function handlePageWake() {
      loadOrders();
    }

    function handleVisibilityChange() {
      if (!document.hidden) {
        loadOrders();
      }
    }

    function init() {
      const saved = localStorage.getItem('rider_token');
      if (!saved) {
        location.href = '/rider/login';
        return;
      }
      rider = JSON.parse(saved);
      document.getElementById('dashboard').style.display = 'block';
      document.getElementById('rider-name').innerText = rider.name || 'Rider';
      const savedStatus = rider.status || 'offline';
      document.getElementById('status-select').value = savedStatus;
      updateBadge(savedStatus);
      loadOrders();
      window.addEventListener('focus', handlePageWake);
      document.addEventListener('visibilitychange', handleVisibilityChange);
    }

    window.logout = function() {
      if (confirm('确认退出登录？')) {
        localStorage.removeItem('rider_token');
        location.href = '/rider/login';
      }
    };

    window.updateStatus = async function(status) {
      try {
        const res = await fetch('/api/rider/status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id: rider.id, status }),
        });
        const data = await res.json();
        if (data.success) {
          rider.status = status;
          localStorage.setItem('rider_token', JSON.stringify(rider));
          updateBadge(status);
        }
      } catch {
        alert('状态更新失败');
      }
    };

    function updateBadge(status) {
      const badge = document.getElementById('rider-status-badge');
      badge.className = `status-badge ${status}`;
      badge.innerText = status.toUpperCase();
    }

    window.switchTab = function(e, tab) {
      currentTab = tab;
      document.querySelectorAll('.tab').forEach((b) => b.classList.remove('active'));
      e.target.classList.add('active');
      renderOrders();
    };

    async function loadOrders() {
      try {
        const res = await fetch(`/api/rider/orders?phone=${encodeURIComponent(rider.phone || '')}`);
        const data = await res.json();
        if (data.success) {
          allOrders = Array.isArray(data.orders) ? data.orders : [];
          renderOrders();
        }
      } catch (e) {
        console.error('Load orders failed', e);
      }
    }

    function parseItems(raw) {
      try {
        const x = JSON.parse(raw || '[]');
        return Array.isArray(x) ? x : Object.values(x || {});
      } catch {
        return [];
      }
    }

    function renderOrders() {
      const container = document.getElementById('order-list');
      const myOrders = allOrders.filter((o) => {
        if (currentTab === 'active') {
          return o.status === 'pending' || o.status === 'confirmed' || o.status === 'delivering';
        }
        return o.status === 'completed';
      });

      if (myOrders.length === 0) {
        container.innerHTML = '<div class="empty-tip">暂无订单 / No Orders</div>';
        return;
      }

      container.innerHTML = myOrders.map((o) => {
        const items = parseItems(o.items_json);
        const itemsHtml = items.map((i) => `<div class="item-row"><span>${i.name || ''}</span><span>x${i.quantity || 1}</span></div>`).join('');
        const address = o.table_info || '';
        const phone = o.user_phone || '';
        const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
        const canTake = (o.status === 'pending' || o.status === 'confirmed') && !o.courier_phone;

        return `
          <div class="order-card status-${o.status}">
            <div class="card-header">
              <span class="order-no">#${String(o.order_no || '').slice(-4)}</span>
              <span class="order-time">${String(o.created_at || '').slice(11,16)}</span>
            </div>

            <div class="info-row">
              <span class="icon">🏪</span>
              <span class="text" style="font-weight:bold;">${o.shop_name || 'Shop'}</span>
            </div>
            <div class="info-row">
              <span class="icon">📍</span>
              <span class="text address">${address}</span>
            </div>
            <div class="info-row">
              <span class="icon">📞</span>
              <a href="tel:${phone}" class="text phone">${phone}</a>
            </div>

            <div class="items-box">${itemsHtml}</div>
            <div class="card-footer">
              <span class="total-price">${o.total_amount || 0} RSD</span>
              <span style="font-size:12px; color:#999;">${o.status}</span>
            </div>

            ${canTake ? `
              <div class="action-btns">
                <button onclick="takeOrder(${o.id})" class="btn-action btn-complete">🛵 接单配送</button>
              </div>` : ''}

            ${o.status === 'delivering' ? `
              <div class="action-btns">
                <a href="tel:${phone}" class="btn-action btn-call">📓 联系客户</a>
                <a href="${mapUrl}" target="_blank" class="btn-action btn-map">🗇️ 导航</a>
                <button onclick="completeOrder(${o.id})" class="btn-action btn-complete">✅ 确认送达 & 收款</button>
              </div>` : ''}
          </div>
        `;
      }).join('');
    }

    window.takeOrder = async function(id) {
      if (!confirm('确认接这单并开始配送？')) return;
      try {
        const res = await fetch('/api/order/update_status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id, status: 'delivering', courier_name: rider.name, courier_phone: rider.phone }),
        });
        const data = await res.json();
        if (data.success) {
          loadOrders();
        } else {
          alert('接单失败: ' + (data.error || 'unknown'));
        }
      } catch {
        alert('网络错误');
      }
    };

    window.completeOrder = async function(id) {
      if (!confirm('确认已送达并收款？')) return;
      try {
        const res = await fetch('/api/order/update_status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id, status: 'completed', courier_name: rider.name, courier_phone: rider.phone }),
        });
        const data = await res.json();
        if (data.success) {
          loadOrders();
        } else {
          alert('操作失败: ' + data.error);
        }
      } catch {
        alert('网络错误');
      }
    };

    init();
  </script>
</Layout>
