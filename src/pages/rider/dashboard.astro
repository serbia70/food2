---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Rider Dashboard" manifest="/rider-manifest.json">
  <div id="dashboard" style="display:none;">
    <div class="header">
      <div class="rider-summary-card">
        <div class="rider-summary-main">
          <div class="rider-profile-block">
            <div class="rider-profile">
              <span id="rider-name">Rider</span>
              <span id="rider-status-badge" class="status-badge offline">Offline</span>
            </div>
            <div id="rider-phone" class="muted"></div>
          </div>
          <button onclick="logout()" class="btn-xs">退出 / Logout</button>
        </div>
        <div id="rider-status-hint" class="status-hint"></div>
        <div id="telegram-binding-panel" class="telegram-binding-panel"></div>
      </div>

      <div class="status-toggle">
        <label class="switch-label">状态 / Status:</label>
        <select id="status-select" onchange="updateStatus(this.value)">
          <option value="offline">🔶 下线 / Offline</option>
          <option value="available">🟢 空闲 / Available</option>
          <option value="busy">🟠 忙碌 / Busy</option>
        </select>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="switchTab(event, 'active')">进行中</button>
        <button class="tab" onclick="switchTab(event, 'history')">已完成</button>
      </div>
    </div>

    <div id="order-list" class="order-list">
      <div class="loading">加载中...</div>
    </div>
  </div>

  <style>
    body { background: #f4f6f8; margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .header { position: sticky; top: 0; background: #fff; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .rider-summary-card { margin: 10px 15px; padding: 12px; border-radius: 10px; background: #e3f2fd; color: #1565c0; }
    .rider-summary-main { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .rider-profile-block { min-width: 0; }
    .rider-profile { display: flex; align-items: center; gap: 10px; font-weight: bold; font-size: 18px; }
    .muted { margin-top: 4px; color: #546e7a; font-size: 14px; }
    .status-hint { margin-top: 10px; font-size: 13px; color: #455a64; }
    .telegram-binding-panel { margin-top: 10px; }
    .telegram-binding-copy { font-size: 13px; }
    .telegram-binding-copy.bound { color: #2e7d32; }
    .telegram-binding-copy.unbound { color: #c62828; margin-bottom: 8px; }
    .status-badge { font-size: 12px; padding: 2px 6px; border-radius: 4px; color: white; }
    .status-badge.offline { background: #9e9e9e; }
    .status-badge.available { background: #4caf50; }
    .status-badge.busy { background: #ff9800; }
    .status-toggle { padding: 10px 15px; background: #fff; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: space-between; }
    .switch-label { font-weight: bold; color: #555; }
    #status-select { padding: 8px; border-radius: 6px; border: 1px solid #ddd; font-size: 14px; }
    .tabs { display: flex; border-bottom: 1px solid #eee; }
    .tab { flex: 1; padding: 15px; border: none; background: #fff; font-size: 15px; font-weight: 600; color: #666; cursor: pointer; border-bottom: 3px solid transparent; }
    .tab.active { color: #2196f3; border-bottom-color: #2196f3; }
    .order-list { padding: 15px; padding-bottom: 80px; min-height: calc(100vh - 160px); }
    .order-card { background: #fff; border-radius: 12px; padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border-left: 5px solid #ccc; }
    .order-card.status-awaiting_courier { border-left-color: #7c3aed; }
    .order-card.status-delivering { border-left-color: #ff9800; }
    .order-card.status-completed { border-left-color: #4caf50; opacity: 0.85; }
    .order-card.status-pending { border-left-color: #3b82f6; }
    .order-card.status-confirmed { border-left-color: #8b5cf6; }
    .pickup-eta { margin: 0 0 10px; padding: 10px 12px; border-radius: 8px; background: #f3e8ff; color: #6d28d9; font-size: 18px; font-weight: 800; }
    .card-header { display: flex; justify-content: space-between; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px dashed #eee; }
    .order-no { font-size: 18px; font-weight: bold; color: #333; }
    .order-time { color: #999; font-size: 13px; }
    .info-row { display: flex; align-items: flex-start; margin-bottom: 8px; gap: 10px; }
    .icon { width: 20px; text-align: center; }
    .text { flex: 1; font-size: 15px; line-height: 1.4; }
    .text.address { font-weight: bold; color: #333; font-size: 16px; }
    .text.phone { color: #2196f3; font-weight: bold; }
    .items-box { background: #f9f9f9; padding: 10px; border-radius: 6px; margin: 10px 0; font-size: 14px; color: #555; }
    .item-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 10px; border-top: 1px solid #eee; }
    .total-price { font-size: 20px; font-weight: bold; color: #d32f2f; }
    .action-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
    .btn-action { padding: 12px; border: none; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px; text-decoration: none; }
    .btn-call { background: #e3f2fd; color: #1565c0; }
    .btn-map { background: #e8f5e9; color: #2e7d32; }
    .btn-complete { grid-column: span 2; background: #4caf50; color: white; font-size: 16px; padding: 15px; margin-top: 5px; }
    .empty-tip { text-align: center; padding: 40px; color: #999; }
    .btn-xs { padding: 5px 10px; background: #fff; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; }
    .telegram-claim-banner { margin: 10px 15px 0; padding: 10px 12px; border-radius: 8px; background: #e3f2fd; color: #0d47a1; font-size: 14px; font-weight: 600; }
    .order-card.deep-link-target { outline: 3px solid #2196f3; outline-offset: 2px; }
  </style>

  <script>
    import { getRiderTelegramBindingCopy, isValidRiderSession, normalizeRiderSession } from '../../lib/rider-session';
    import { getAdminDispatchStatusCopy, getRiderStatusHintCopy } from '../../lib/rider-dispatch.ts';

    let rider = null;
    let currentTab = 'active';
    let allOrders = [];
    let deepLinkOrderId = '';
    let deepLinkRestaurantId = '';
    let deepLinkHintShown = false;
    let telegramBound = false;

    async function handlePageWake() {
      await refreshTelegramBindingStatus();
      await loadOrders();
    }

    async function handleVisibilityChange() {
      if (!document.hidden) {
        await refreshTelegramBindingStatus();
        await loadOrders();
      }
    }

    function showDeepLinkToast(message) {
      const existed = document.querySelector('.telegram-claim-banner');
      if (existed) existed.remove();
      const banner = document.createElement('div');
      banner.className = 'telegram-claim-banner';
      banner.textContent = message;
      const dashboard = document.getElementById('dashboard');
      if (dashboard) dashboard.prepend(banner);
    }

    function parseDeepLinkParams() {
      const params = new URL(location.href).searchParams;
      deepLinkOrderId = String(params.get('orderId') || '').trim();
      deepLinkRestaurantId = String(params.get('restaurantId') || '').trim();
      telegramBound = String(params.get('telegram_bound') || '').trim() === '1';
    }

    function maybeShowDeepLinkHint() {
      if (!deepLinkOrderId || deepLinkHintShown) return;
      deepLinkHintShown = true;
      showDeepLinkToast(`正在定位订单 #${deepLinkOrderId}`);
    }

    function matchesDeepLinkOrder(order) {
      if (!deepLinkOrderId) return false;
      const safeOrder = order || {};
      const orderId = String(safeOrder.id || '').trim();
      const orderNo = String(safeOrder.orderNo || '').trim();
      const restaurantId = String(safeOrder.shopSlug || safeOrder.restaurantSlug || safeOrder.restaurantId || safeOrder.shopId || '').trim();
      const restaurantMatched = !deepLinkRestaurantId || restaurantId === deepLinkRestaurantId;
      return restaurantMatched && (orderId === deepLinkOrderId || orderNo === deepLinkOrderId);
    }

    let bindState = { httpsUrl: '', tgUrl: '', startCommand: '', ready: false };

    function renderTelegramBindingPanel() {
      const panel = document.getElementById('telegram-binding-panel');
      if (!panel || !rider) return;
      const bound = String(rider.telegramChatId || '').trim() !== '';
      const copy = getRiderTelegramBindingCopy(bound ? rider : { telegramChatId: '' });
      const bindLink = String(bindState.httpsUrl || bindState.tgUrl || '').trim();
      const showFallbackActions = !bound && bindState.ready;
      panel.innerHTML = `
        <div class="telegram-binding-copy ${bound ? 'bound' : 'unbound'}">${copy}</div>
        ${bound ? '<button id="unbind-telegram-btn" class="btn-action" type="button">解除 Telegram 绑定</button>' : '<button id="bind-telegram-btn" class="btn-action btn-map" type="button">绑定 Telegram</button>'}
        ${!showFallbackActions ? '' : '<div class="telegram-binding-steps-title">绑定步骤</div><ol class="telegram-binding-steps"><li>先点“打开 Telegram”</li><li>如果 Telegram 聊天页是空白，再点“复制绑定命令”并发送给机器人</li><li>发送成功后回到此页查看状态</li></ol><div class="telegram-binding-tip">如果 Telegram 里只出现普通 /start，请点“复制绑定命令”后直接发送给机器人。</div><div class="telegram-binding-actions"><a id="bind-telegram-link" class="btn-action btn-map" target="_blank" rel="noreferrer">打开 Telegram</a><button id="copy-telegram-bind-link-btn" class="btn-action" type="button">复制绑定链接</button><button id="copy-telegram-bind-command-btn" class="btn-action" type="button">复制绑定命令</button></div>'}
      `;
      const bindBtn = document.getElementById('bind-telegram-btn');
      if (bindBtn) bindBtn.addEventListener('click', bindTelegram);
      const unbindBtn = document.getElementById('unbind-telegram-btn');
      if (unbindBtn) unbindBtn.addEventListener('click', unbindTelegram);
      const bindLinkEl = document.getElementById('bind-telegram-link');
      if (bindLinkEl instanceof HTMLAnchorElement && bindLink) bindLinkEl.href = bindLink;
      const copyBtn = document.getElementById('copy-telegram-bind-link-btn');
      if (copyBtn) copyBtn.addEventListener('click', copyTelegramBindLink);
      const copyCommandBtn = document.getElementById('copy-telegram-bind-command-btn');
      if (copyCommandBtn) copyCommandBtn.addEventListener('click', copyTelegramBindCommand);
    }

    function persistRiderSession(nextRider) {
      if (!nextRider || typeof nextRider !== 'object') return;
      rider = nextRider;
      localStorage.setItem('rider_session', JSON.stringify(nextRider));
      renderTelegramBindingPanel();
    }

    function refreshRiderSessionFromPayload(payload) {
      const source = payload && typeof payload === 'object' ? payload : {};
      const maybeRider = source.rider && typeof source.rider === 'object' ? source.rider : null;
      if (!maybeRider || !rider) return;
      const next = normalizeRiderSession({ ...rider, ...maybeRider });
      if (!isValidRiderSession(next)) return;
      persistRiderSession(next);
    }

    async function refreshTelegramBindingStatus() {
      if (!rider) return;
      try {
        const statusRes = await fetch(`/api/rider/orders?phone=${encodeURIComponent(rider.phone || '')}&view=active`);
        const statusData = await statusRes.json().catch(() => ({}));
        if (!statusRes.ok || statusData?.success === false) return;
        refreshRiderSessionFromPayload(statusData);
      } catch {
      }
    }

    async function copyTelegramBindLink() {
      const bindLink = String(bindState.httpsUrl || bindState.tgUrl || '').trim();
      if (!bindLink) return;
      try {
        await navigator.clipboard.writeText(bindLink);
        alert('绑定链接已复制，请粘贴到浏览器或 Telegram 中打开');
      } catch {
        alert('复制失败，请长按“打开 Telegram 绑定”按钮后手动复制链接');
      }
    }

    async function copyTelegramBindCommand() {
      const bindCommand = String(bindState.startCommand || '').trim();
      if (!bindCommand) return;
      try {
        await navigator.clipboard.writeText(bindCommand);
        alert('绑定命令已复制，请直接发给 Telegram 机器人');
      } catch {
        alert('复制失败，请稍后重试');
      }
    }

    async function bindTelegram() {
      if (!rider) return;
      try {
        const res = await fetch('/api/rider/telegram/bind', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ riderId: rider.id, riderPhone: rider.phone }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false || !data.bind_url) {
          throw new Error(data.error || 'bind_link_failed');
        }
        bindState = {
          httpsUrl: String(data.bind_url || '').trim(),
          tgUrl: String(data.tg_bind_url || '').trim(),
          startCommand: String(data.start_command || '').trim(),
          ready: true,
        };
        renderTelegramBindingPanel();
      } catch (error) {
        alert(`Telegram 绑定入口创建失败: ${error instanceof Error ? error.message : 'unknown error'}`);
      }
    }

    async function unbindTelegram() {
      if (!rider) return;
      if (!confirm('确认解除 Telegram 绑定？')) return;
      try {
        const res = await fetch('/api/rider/telegram/unbind', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ riderId: rider.id, riderPhone: rider.phone, riderStatus: rider.status }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) {
          throw new Error(data.error || 'unbind_failed');
        }
        bindState = { httpsUrl: '', tgUrl: '', startCommand: '', ready: false };
        persistRiderSession({ ...rider, telegramChatId: '' });
        alert('已解除 Telegram 绑定');
      } catch (error) {
        alert(`解除 Telegram 绑定失败: ${error instanceof Error ? error.message : 'unknown error'}`);
      }
    }

    function init() {
      const saved = localStorage.getItem('rider_session');
      if (!saved) {
        location.href = '/rider/login';
        return;
      }

      let parsed = null;
      try {
        parsed = JSON.parse(saved);
      } catch {
        localStorage.removeItem('rider_session');
        location.href = '/rider/login';
        return;
      }

      if (!isValidRiderSession(parsed)) {
        localStorage.removeItem('rider_session');
        location.href = '/rider/login';
        return;
      }

      rider = parsed;
      parseDeepLinkParams();

      if (telegramBound) {
        showDeepLinkToast('Telegram 绑定成功');
        const pendingRider = {
          ...rider,
          telegramChatId: rider.telegramChatId || '__bound__',
        };
        persistRiderSession(pendingRider);
        telegramBound = false;
        void refreshTelegramBindingStatus();
      }

      const dashboard = document.getElementById('dashboard');
      if (dashboard) dashboard.style.display = 'block';

      const riderName = document.getElementById('rider-name');
      if (riderName) riderName.textContent = rider.name || 'Rider';

      const riderPhone = document.getElementById('rider-phone');
      if (riderPhone) riderPhone.textContent = rider.phone || '';

      const riderStatusHint = document.getElementById('rider-status-hint');
      if (riderStatusHint) riderStatusHint.textContent = getRiderStatusHintCopy(rider.status);

      const savedStatus = rider.status || 'offline';
      const statusSelect = document.getElementById('status-select');
      if (statusSelect instanceof HTMLSelectElement) {
        statusSelect.value = savedStatus;
      }

      updateBadge(savedStatus);
      renderTelegramBindingPanel();
      loadOrders();
      window.addEventListener('focus', handlePageWake);
      document.addEventListener('visibilitychange', handleVisibilityChange);
    }

    window.logout = function() {
      if (confirm('确认退出登录？')) {
        localStorage.removeItem('rider_session');
        location.href = '/rider/login';
      }
    };

    window.updateStatus = async function(status) {
      try {
        const res = await fetch('/api/rider/status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id: rider.id, status }),
        });
        const data = await res.json();
        if (data.success) {
          rider.status = status;
          localStorage.setItem('rider_session', JSON.stringify(rider));
          refreshRiderSessionFromPayload(data);
          updateBadge(status);
          const riderStatusHint = document.getElementById('rider-status-hint');
          if (riderStatusHint) riderStatusHint.textContent = getRiderStatusHintCopy(status);
        }
      } catch {
        alert('状态更新失败');
      }
    };

    function updateBadge(status) {
      const badge = document.getElementById('rider-status-badge');
      if (!badge) return;
      badge.className = `status-badge ${status}`;
      badge.textContent = String(status || 'offline').toUpperCase();
    }

    window.switchTab = function(e, tab) {
      currentTab = tab;
      document.querySelectorAll('.tab').forEach((b) => b.classList.remove('active'));
      e.target.classList.add('active');
      loadOrders();
    };

    async function loadOrders() {
      const container = document.getElementById('order-list');
      try {
        const view = currentTab === 'active' ? 'active' : 'history';
        const res = await fetch(`/api/rider/orders?phone=${encodeURIComponent(rider.phone || '')}&view=${view}`);
        const data = await res.json();
        if (data.success) {
          refreshRiderSessionFromPayload(data);
          allOrders = Array.isArray(data.orders) ? data.orders : [];
          renderOrders();
          return;
        }

        const error = String(data.error || 'load_orders_failed');
        if (container) {
          const failed = document.createElement('div');
          failed.className = 'empty-tip';
          failed.textContent = `加载失败: ${error}`;
          container.replaceChildren(failed);
        }
      } catch (e) {
        console.error('Load orders failed', e);
        if (container) {
          const failed = document.createElement('div');
          failed.className = 'empty-tip';
          failed.textContent = '加载失败: network_error';
          container.replaceChildren(failed);
        }
      }
    }

    function parseItems(raw) {
      try {
        const x = JSON.parse(raw || '[]');
        return Array.isArray(x) ? x : Object.values(x || {});
      } catch {
        return [];
      }
    }

    function renderOrders() {
      const container = document.getElementById('order-list');
      const myOrders = allOrders;

      if (rider && rider.status !== 'available' && currentTab === 'active') {
        showDeepLinkToast('当前不是 available，无法接新单');
      }

      if (myOrders.length === 0) {
        if (deepLinkOrderId) {
          maybeShowDeepLinkHint();
        }
        const empty = document.createElement('div');
        empty.className = 'empty-tip';
        empty.textContent = '暂无订单 / No Orders';
        container.replaceChildren(empty);
        return;
      }

      const createInfoRow = (iconText, contentNode) => {
        const row = document.createElement('div');
        row.className = 'info-row';
        const icon = document.createElement('span');
        icon.className = 'icon';
        icon.textContent = iconText;
        row.append(icon, contentNode);
        return row;
      };

      const createCard = (o) => {
        const isDeepLinkTarget = matchesDeepLinkOrder(o);
        const items = parseItems(o.itemsJson);
        const address = o.tableInfo || '';
        const phone = o.userPhone || '';
        const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
        const canTake = rider.status === 'available' && o.status === 'awaiting_courier';

        const card = document.createElement('div');
        card.className = `order-card status-${o.status}`;
        if (isDeepLinkTarget) {
          card.classList.add('deep-link-target');
          if (deepLinkOrderId) {
            showDeepLinkToast(`已定位订单 #${deepLinkOrderId}`);
          }
        }

        const etaMinutes = Number(o.pickupEtaMinutes || 0);
        if (etaMinutes > 0) {
          const eta = document.createElement('div');
          eta.className = 'pickup-eta';
          eta.textContent = `ETA: 约 ${etaMinutes} 分钟后可取`;
          card.appendChild(eta);
        }

        const header = document.createElement('div');
        header.className = 'card-header';
        const orderNo = document.createElement('span');
        orderNo.className = 'order-no';
        orderNo.textContent = `#${String(o.orderNo || '').slice(-4)}`;
        const orderTime = document.createElement('span');
        orderTime.className = 'order-time';
        orderTime.textContent = String(o.createdAt || '').slice(11, 16);
        header.append(orderNo, orderTime);

        const shop = document.createElement('span');
        shop.className = 'text';
        shop.style.fontWeight = 'bold';
        shop.textContent = o.shopName || 'Shop';
        const addr = document.createElement('span');
        addr.className = 'text address';
        addr.textContent = address;
        const phoneLink = document.createElement('a');
        phoneLink.href = `tel:${phone}`;
        phoneLink.className = 'text phone';
        phoneLink.textContent = phone;

        const itemsBox = document.createElement('div');
        itemsBox.className = 'items-box';
        items.forEach((i) => {
          const row = document.createElement('div');
          row.className = 'item-row';
          const name = document.createElement('span');
          name.textContent = i.name || '';
          const qty = document.createElement('span');
          qty.textContent = `x${i.quantity || 1}`;
          row.append(name, qty);
          itemsBox.appendChild(row);
        });

        const footer = document.createElement('div');
        footer.className = 'card-footer';
        const total = document.createElement('span');
        total.className = 'total-price';
        total.textContent = `${o.totalAmount || 0} RSD`;
        const status = document.createElement('span');
        status.style.fontSize = '12px';
        status.style.color = '#999';
        status.textContent = getAdminDispatchStatusCopy(o.status);
        footer.append(total, status);

        card.append(
          header,
          createInfoRow('🏪', shop),
          createInfoRow('📍', addr),
          createInfoRow('📞', phoneLink),
          itemsBox,
          footer,
        );

        if (canTake) {
          const actionWrap = document.createElement('div');
          actionWrap.className = 'action-btns';
          const button = document.createElement('button');
          button.className = 'btn-action btn-complete';
          button.type = 'button';
          button.textContent = '🛵 接单配送';
          button.addEventListener('click', () => window.takeOrder(o.id));
          actionWrap.appendChild(button);
          card.appendChild(actionWrap);
        }

        if (o.status === 'delivering' && String(o.courierPhone || '').trim() === String(rider?.phone || '').trim()) {
          const actionWrap = document.createElement('div');
          actionWrap.className = 'action-btns';
          const call = document.createElement('a');
          call.href = `tel:${phone}`;
          call.className = 'btn-action btn-call';
          call.textContent = '📓 联系客户';
          const map = document.createElement('a');
          map.href = mapUrl;
          map.target = '_blank';
          map.className = 'btn-action btn-map';
          map.textContent = '🗇️ 导航';
          const complete = document.createElement('button');
          complete.type = 'button';
          complete.className = 'btn-action btn-complete';
          complete.textContent = '✅ 确认送达 & 收款';
          complete.addEventListener('click', () => window.completeOrder(o.id));
          actionWrap.append(call, map, complete);
          card.appendChild(actionWrap);
        }

        return card;
      };

      if (currentTab === 'active') {
        const awaitingOrders = myOrders.filter((o) => o.status === 'awaiting_courier');
        const deliveringOrders = myOrders.filter((o) => o.status === 'delivering' && String(o.courierPhone || '').trim() === String(rider?.phone || '').trim());

        const sections = [];

        const poolSection = document.createElement('section');
        const poolTitle = document.createElement('h3');
        poolTitle.textContent = '待接单池';
        poolSection.appendChild(poolTitle);
        if (awaitingOrders.length > 0) {
          poolSection.append(...awaitingOrders.map(createCard));
        } else {
          const poolEmpty = document.createElement('div');
          poolEmpty.className = 'empty-tip';
          poolEmpty.textContent = '暂无待接单';
          poolSection.appendChild(poolEmpty);
        }
        sections.push(poolSection);

        const mineSection = document.createElement('section');
        const mineTitle = document.createElement('h3');
        mineTitle.textContent = '我的配送';
        mineSection.appendChild(mineTitle);
        if (deliveringOrders.length > 0) {
          mineSection.append(...deliveringOrders.map(createCard));
        } else {
          const mineEmpty = document.createElement('div');
          mineEmpty.className = 'empty-tip';
          mineEmpty.textContent = '暂无我的配送';
          mineSection.appendChild(mineEmpty);
        }
        sections.push(mineSection);

        container.replaceChildren(...sections);
      } else {
        const cards = myOrders.map(createCard);
        container.replaceChildren(...cards);
      }

      const renderedCards = Array.from(container.querySelectorAll('.order-card'));
      if (deepLinkOrderId && !renderedCards.some((node) => node.classList.contains('deep-link-target'))) {
        maybeShowDeepLinkHint();
      }
    }

    window.takeOrder = async function(id) {
      if (!confirm('确认接这单并开始配送？')) return;
      try {
        const res = await fetch('/api/order/update_status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({
            id,
            expected_current_status: 'awaiting_courier',
            status: 'delivering',
            courierName: rider.name,
            courierPhone: rider.phone,
          }),
        });
        const data = await res.json();
        if (data.success) {
          loadOrders();
          return;
        }

        const rawError = String(data.error || '');
        const shouldHintTaken =
          rawError.includes('expected_current_status') ||
          rawError.includes('status mismatch') ||
          rawError.includes('已被') ||
          rawError.includes('delivering');

        alert(shouldHintTaken ? '该订单已被其他骑手接走，将刷新列表' : `接单失败: ${rawError || 'unknown'}`);
        loadOrders();
      } catch {
        alert('网络错误');
      }
    };

    window.completeOrder = async function(id) {
      if (!confirm('确认已送达并收款？')) return;
      try {
        const res = await fetch('/api/order/update_status', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id, status: 'completed', courierName: rider.name, courierPhone: rider.phone }),
        });
        const data = await res.json();
        if (data.success) {
          loadOrders();
        } else {
          alert('操作失败: ' + data.error);
        }
      } catch {
        alert('网络错误');
      }
    };

    init();
  </script>
</Layout>
