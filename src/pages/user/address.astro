---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="地址管理">
  <div class="page-container">
    <div class="nav-header">
      <a href="/user" class="back-btn">‹</a>
      <h2>地址管理</h2>
      <div style="width:20px"></div>
    </div>

    <div class="content" id="address-list">
      <!-- 地址加载中... -->
    </div>

    <div class="bottom-bar">
      <button class="btn-add" onclick="openEditModal()">+ 新增/修改地址</button>
    </div>

    <!-- 编辑弹窗 -->
    <div id="edit-modal" class="modal" style="display:none;">
      <div class="modal-content">
        <h3>编辑地址</h3>
        
        <div class="form-group">
            <label>联系人</label>
            <input type="text" id="addr-name" placeholder="您的姓名">
        </div>
        <div class="form-group">
            <label>手机号</label>
            <input type="tel" id="addr-phone" placeholder="配送员联系电话">
        </div>
        <div class="form-group">
            <label>详细地址</label>
            <textarea id="addr-detail" placeholder="街道、门牌号、楼层等" rows="3"></textarea>
        </div>

        <div class="modal-actions">
          <button onclick="closeEditModal()" class="btn-cancel">取消</button>
          <button onclick="saveAddress()" class="btn-save">保存</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const sessionToken = localStorage.getItem('user_session');
    if (!sessionToken) window.location.href = '/user/login';

    async function loadAddress() {
      try {
        const res = await fetch('/api/user/address', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ action: 'get', sessionToken })
        });
        const data = await res.json();
        const container = document.getElementById('address-list');
        
        if (data.success && data.address) {
          let addrObj = {};
          try {
              // 尝试解析 JSON，如果失败说明是旧格式（纯文本）
              addrObj = JSON.parse(data.address);
              // 如果解析出来不是对象（比如是数字），也视为旧格式
              if (typeof addrObj !== 'object') throw new Error('Not object');
          } catch(e) {
              addrObj = { address: data.address };
          }

          const name = addrObj.name || '';
          const phone = addrObj.phone || '';
          const detail = addrObj.address || '';

          container.innerHTML = `
            <div class="address-card" onclick="openEditModal()">
              <div class="addr-icon">📍</div>
              <div class="addr-info">
                <div class="addr-user">
                    <span class="u-name">${name || '未填写姓名'}</span>
                    <span class="u-phone">${phone || '未填写电话'}</span>
                </div>
                <div class="addr-detail">${detail}</div>
              </div>
              <div class="addr-edit-icon">✎</div>
            </div>
          `;
          
          // 填充表单
          document.getElementById('addr-name').value = name;
          document.getElementById('addr-phone').value = phone;
          document.getElementById('addr-detail').value = detail;
        } else {
          container.innerHTML = '<div class="empty-state"><p>暂无收货地址</p></div>';
          // 清空表单
          document.getElementById('addr-name').value = '';
          document.getElementById('addr-phone').value = '';
          document.getElementById('addr-detail').value = '';
        }
      } catch(e) {
        console.error(e);
      }
    }

    window.openEditModal = () => document.getElementById('edit-modal').style.display = 'flex';
    window.closeEditModal = () => document.getElementById('edit-modal').style.display = 'none';

    window.saveAddress = async () => {
      const name = document.getElementById('addr-name').value;
      const phone = document.getElementById('addr-phone').value;
      const detail = document.getElementById('addr-detail').value;

      if (!detail) return alert('请填写详细地址');
      if (!phone) return alert('请填写手机号');
      
      const addressJson = JSON.stringify({ name, phone, address: detail });

      try {
        const res = await fetch('/api/user/address', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ action: 'update', address: addressJson, sessionToken })
        });
        const data = await res.json();
        if (data.success) {
          closeEditModal();
          loadAddress();
        } else {
          alert('保存失败');
        }
      } catch(e) {
        alert('网络错误');
      }
    }

    loadAddress();
  </script>

  <style>
    .page-container { min-height: 100vh; background: #f5f5f5; padding-bottom: 80px; }
    .nav-header { 
      background: white; padding: 15px; display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid #eee;
    }
    .back-btn { font-size: 24px; text-decoration: none; color: #333; }
    .nav-header h2 { margin: 0; font-size: 18px; }
    
    .content { padding: 20px; }
    .empty-state { text-align: center; color: #999; margin-top: 50px; }
    
    .address-card {
      background: white; padding: 20px; border-radius: 8px;
      display: flex; gap: 15px; align-items: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      cursor: pointer;
    }
    .addr-icon { font-size: 24px; color: #00b140; }
    .addr-info { flex: 1; }
    .addr-user { margin-bottom: 5px; font-weight: bold; color: #333; }
    .u-name { margin-right: 10px; font-size: 16px; }
    .u-phone { color: #666; font-size: 14px; font-weight: normal; }
    .addr-detail { font-size: 14px; color: #666; line-height: 1.4; }
    .addr-edit-icon { color: #999; font-size: 18px; }

    .bottom-bar {
      position: fixed; bottom: 0; left: 0; width: 100%;
      background: white; padding: 15px 15px calc(15px + env(safe-area-inset-bottom, 0px)); box-sizing: border-box;
      border-top: 1px solid #eee;
    }
    .btn-add {
      width: 100%; background: #00b140; color: white; border: none;
      padding: 12px; border-radius: 25px; font-size: 16px; font-weight: bold;
    }

    .modal {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
      z-index: 999;
    }
    .modal-content {
      background: white; width: 85%; max-width: 400px; padding: 25px; border-radius: 12px;
    }
    .modal-content h3 { margin-top: 0; margin-bottom: 20px; text-align: center; }
    
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 14px; color: #555; }
    .form-group input, .form-group textarea {
        width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px;
    }
    .form-group input:focus, .form-group textarea:focus { border-color: #00b140; outline: none; }

    .modal-actions { display: flex; gap: 10px; margin-top: 25px; }
    .modal-actions button { flex: 1; padding: 12px; border-radius: 8px; border: none; font-weight: bold; font-size: 15px; }
    .btn-cancel { background: #f5f5f5; color: #666; }
    .btn-save { background: #00b140; color: white; }
  </style>
</Layout>
