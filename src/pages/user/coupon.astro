---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="红包卡券">
  <div class="page-container">
    <div class="nav-header">
      <h2>红包卡券</h2>
    </div>
    <div class="content">
      <div class="empty-state">
        <p>暂无可用红包</p>
      </div>
    </div>
  </div>
  <style>
    .page-container { min-height: 100vh; background: #f5f5f5; }
    .nav-header { background: white; padding: 15px; text-align: center; border-bottom: 1px solid #eee; }
    .content { padding: 20px; text-align: center; color: #999; }
  </style>
</Layout>
