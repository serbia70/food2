---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="个人中心">
  <div class="page-container">
    <!-- 未登录状态展示 (包含注册入口) -->
    <div id="guest-header" class="user-header" style="display:none; background: #fff; color: #333; flex-direction: column; align-items: center; padding: 40px 20px; border-bottom: 1px solid #f0f0f0;">
        <div class="avatar" style="background: #f5f5f5; margin-bottom: 15px; width: 80px; height: 80px; font-size: 40px;">👤</div>
        <h3 style="margin-bottom: 20px; font-size: 20px;">登录体验更多功能</h3>
        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 300px;">
            <button onclick="location.href='/user/login?mode=register'" style="width:100%; padding:14px; border-radius:10px; border:none; background:#00b140; color:#fff; font-weight:bold; font-size:16px; cursor:pointer; box-shadow: 0 4px 12px rgba(0,177,64,0.3);">立即一键注册</button>
            <button onclick="location.href='/user/login'" style="width:100%; padding:10px; border-radius:10px; border:1px solid #ddd; color:#666; background:transparent; font-size:14px; cursor:pointer;">已有账号？去登录</button>
        </div>
        <p style="font-size: 13px; color: #00b140; margin-top: 20px; font-weight: 500;">💡 提示：已开启 Google 一键快捷登录</p>
    </div>

    <!-- 已登录状态展示 -->
    <div id="user-header" class="user-header" style="display:none;">
      <div class="avatar">👤</div>
      <div class="user-info">
        <h3 id="user-name">Hi, 欢迎回来</h3>
        <p id="user-contact">用户信息加载中...</p>
        <button id="bind-phone-btn" onclick="openBindPhone()" style="display:none; font-size:12px; padding:4px 8px; background:#fff; border:1px solid #00b140; color:#00b140; border-radius:4px; margin-top:5px; cursor:pointer;">绑定手机号</button>
      </div>
    </div>

    <!-- 绑定手机号弹窗 (省略部分重复逻辑以保持精简) -->
    <!-- ... existing code ... -->

    <div class="order-status-bar">
      <!-- ... standard status items ... -->
      <div class="status-item"><span>📦</span><span>待付款</span></div>
      <div class="status-item"><span>🍳</span><span>待接单</span></div>
      <div class="status-item"><span>🛵</span><span>配送中</span></div>
      <div class="status-item"><span>💬</span><span>待评价</span></div>
    </div>

    <div class="menu-list">
      <a href="/orders" class="menu-item"><span>我的订单</span><span class="arrow">›</span></a>
      <a href="/user/address" class="menu-item"><span>地址管理</span><span class="arrow">›</span></a>
      <a href="/user/coupon" class="menu-item"><span>红包卡券</span><span class="arrow">›</span></a>
      <a href="/user/service" class="menu-item"><span>联系客服</span><span class="arrow">›</span></a>
      <div id="logout-item" class="menu-item" onclick="logout()" style="display:none; color: #ff4b33; justify-content: center; font-weight: bold; margin-top: 10px; border-top: 10px solid #f5f5f5; cursor: pointer;">
        退出登录
      </div>
    </div>

    <div class="merchant-entry">
      <a href="/merchant/login" class="btn-merchant">
        <span>🏪 商家入口</span>
        <small>管理店铺 / 免费入驻</small>
      </a>
    </div>
  </div>

  <script is:inline>
    const userInfoStr = localStorage.getItem('user_info');
    const guestHeader = document.getElementById('guest-header');
    const userHeader = document.getElementById('user-header');
    const logoutItem = document.getElementById('logout-item');

    if (!userInfoStr) {
      guestHeader.style.display = 'flex';
    } else {
      try {
        userHeader.style.display = 'flex';
        logoutItem.style.display = 'flex';
        const user = JSON.parse(userInfoStr);
        document.getElementById('user-name').innerText = user.name || '用户';
        document.getElementById('user-contact').innerText = user.phone || user.email || '';
        if (user.avatar) {
            const avatarEl = document.querySelector('#user-header .avatar');
            if (avatarEl) {
              const img = document.createElement('img');
              img.src = String(user.avatar);
              img.alt = '用户头像';
              img.style.width = '100%';
              img.style.height = '100%';
              img.style.borderRadius = '50%';
              img.style.objectFit = 'cover';
              avatarEl.replaceChildren(img);
            }
        }
        if (!user.phone) document.getElementById('bind-phone-btn').style.display = 'inline-block';
      } catch (e) { console.error(e); }
    }

    window.logout = function() {
      if (confirm('确定要退出登录吗？')) {
        localStorage.removeItem('user_session');
        localStorage.removeItem('user_info');
        window.location.reload();
      }
    }

    window.openBindPhone = async function() {
      const phone = prompt('请输入要绑定的手机号:');
      if (!phone) return;
      if (!/^06\d{7,8}$/.test(phone)) {
         if (!confirm('手机号格式看似不正确 (通常为 06xxxxxxxx)，确定要使用吗？')) return;
      }

      try {
        const userInfo = JSON.parse(localStorage.getItem('user_info') || '{}');
        const res = await fetch('/api/user/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            login_account: userInfo.login_account || userInfo.phone || userInfo.email,
            phone: phone 
          })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ 绑定成功');
          userInfo.phone = phone;
          localStorage.setItem('user_info', JSON.stringify(userInfo));
          window.location.reload();
        } else {
          alert('❌ 绑定失败: ' + data.error);
        }
      } catch (e) {
        alert('❌ 网络错误');
      }
    }
  </script>

  <!-- 底部导航 (保持原样) -->
  <div class="bottom-nav">
    <a href="/" class="nav-item"><span>🏠</span><span>首页</span></a>
    <a href="/orders" class="nav-item"><span>📄</span><span>订单</span></a>
    <a href="/messages" class="nav-item"><span>💬</span><span>消息</span></a>
    <a href="/user" class="nav-item active"><span>👤</span><span>我的</span></a>
  </div>

  <style>
    /* 保持原有的 CSS 样式... */
    .page-container { background: #f5f5f5; min-height: 100vh; padding-bottom: 80px; }
    .user-header { background: #00b140; color: white; padding: 30px 20px; display: flex; align-items: center; gap: 15px; }
    .avatar { width: 60px; height: 60px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 30px; overflow: hidden; }
    .user-info h3 { margin: 0; font-size: 18px; }
    .user-info p { margin: 5px 0 0; opacity: 0.8; font-size: 14px; }
    .order-status-bar { background: white; padding: 15px; display: flex; justify-content: space-around; margin-bottom: 10px; }
    .status-item { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 12px; color: #666; }
    .status-item span:first-child { font-size: 24px; }
    .menu-item { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; background: white; border-bottom: 1px solid #f5f5f5; text-decoration: none; color: #333; }
    .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: white; border-top: 1px solid #eee; display: flex; justify-content: space-around; padding: 10px 0 calc(10px + env(safe-area-inset-bottom, 0px)); }
    .nav-item { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: #999; font-size: 10px; }
    .nav-item.active { color: #00b140; }
  </style>
</Layout>

