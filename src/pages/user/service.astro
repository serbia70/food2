---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="联系客服">
  <div class="page-container">
    <div class="nav-header">
      <h2>联系客服</h2>
    </div>
    <div class="content">
      <div class="service-card">
        <h3>在线客服</h3>
        <p>工作时间: 9:00 - 22:00</p>
        <button class="btn-chat">立即咨询</button>
      </div>
    </div>
  </div>
  <style>
    .page-container { min-height: 100vh; background: #f5f5f5; }
    .nav-header { background: white; padding: 15px; text-align: center; border-bottom: 1px solid #eee; }
    .content { padding: 20px; }
    .service-card { background: white; padding: 20px; border-radius: 8px; text-align: center; }
    .btn-chat { background: #00b140; color: white; border: none; padding: 10px 30px; border-radius: 20px; margin-top: 15px; }
  </style>
</Layout>
